<UserControl x:Class="DMS.Desktop.Views.Mes.MesLiveOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="620">
    <Grid Background="{DynamicResource DmsBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TxtTitle"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>
            <TextBlock x:Name="TxtSubtitle"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                Background="{DynamicResource DmsPanelBrush}">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock x:Name="LblWorkcenter"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
                <ComboBox x:Name="CmbWorkcenter"
                          Width="280"
                          Margin="0,0,16,0"
                          DisplayMemberPath="DisplayText"
                          SelectionChanged="Filter_SelectionChanged"/>

                <TextBlock x:Name="LblShift"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
                <ComboBox x:Name="CmbShift"
                          Width="250"
                          Margin="0,0,16,0"
                          DisplayMemberPath="DisplayText"
                          SelectionChanged="Filter_SelectionChanged"/>

                <Button x:Name="BtnRefresh"
                        MinWidth="110"
                        Margin="0,0,16,0"
                        Padding="12,5"
                        Click="BtnRefresh_Click"/>

                <CheckBox x:Name="ChkAutoRefresh"
                          VerticalAlignment="Center"
                          Checked="ChkAutoRefresh_Changed"
                          Unchecked="ChkAutoRefresh_Changed"
                          Foreground="{DynamicResource DmsForegroundBrush}"/>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="GridOverview"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource DmsBorderBrush}"
                  Background="{DynamicResource DmsPanelBrush}"
                  Foreground="{DynamicResource DmsForegroundBrush}"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColWorkcenter" Binding="{Binding WorkcenterCode}" Width="100"/>
                <DataGridTextColumn x:Name="ColShift" Binding="{Binding ShiftName}" Width="150"/>
                <DataGridTextColumn x:Name="ColOrder" Binding="{Binding OrderCode}" Width="105"/>
                <DataGridTextColumn x:Name="ColItem" Binding="{Binding ProductCode}" Width="145"/>

                <DataGridTemplateColumn x:Name="ColState" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StateBrush}" Padding="5,2">
                                <TextBlock Text="{Binding StateName}"
                                           Foreground="{Binding StateForegroundBrush}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="ColStateDuration" Width="125">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StateBrush}" Padding="5,2">
                                <TextBlock Text="{Binding StateDurationText}"
                                           Foreground="{Binding StateForegroundBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="ColUserText" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StateBrush}" Padding="5,2">
                                <TextBlock Text="{Binding StateUserText}"
                                           Foreground="{Binding StateForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn x:Name="ColPlannedPerformance"
                                    Binding="{Binding PlannedPerformanceText}"
                                    Width="130"/>
                <DataGridTextColumn x:Name="ColCurrentPerformance"
                                    Binding="{Binding CurrentPerformanceText}"
                                    Width="145"/>
                <DataGridTextColumn x:Name="ColPoTarget"
                                    Binding="{Binding OrderTargetText}"
                                    Width="125"/>
                <DataGridTextColumn x:Name="ColPoGood"
                                    Binding="{Binding OrderGoodText}"
                                    Width="125"/>
                <DataGridTextColumn x:Name="ColShiftGood"
                                    Binding="{Binding ShiftGoodText}"
                                    Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="True">
            <TextBlock x:Name="TxtRows"
                       DockPanel.Dock="Left"
                       Margin="0,0,18,0"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
            <TextBlock x:Name="TxtRefresh"
                       DockPanel.Dock="Right"
                       Margin="18,0,0,0"
                       TextAlignment="Right"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
            <TextBlock x:Name="TxtStatus"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </DockPanel>
    </Grid>
</UserControl>
