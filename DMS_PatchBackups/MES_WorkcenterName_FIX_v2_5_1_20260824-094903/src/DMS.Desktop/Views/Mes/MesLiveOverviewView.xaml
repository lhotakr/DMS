<UserControl x:Class="DMS.Desktop.Views.Mes.MesLiveOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="620">
    <UserControl.Resources>
        <Style x:Key="MesWorkcenterPickerToggleStyle"
               TargetType="{x:Type ToggleButton}">
            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="PickerBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Margin="8,4,4,4"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"/>
                                <TextBlock Grid.Column="1"
                                           Text="▼"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PickerBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource DmsMutedForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PickerBorder"
                                        Property="Background"
                                        Value="{DynamicResource DmsPanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MesWorkcenterListItemStyle"
               TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource DmsPanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource DmsBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TxtTitle"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>
            <TextBlock x:Name="TxtSubtitle"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                Background="{DynamicResource DmsPanelBrush}">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock x:Name="LblWorkcenter"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>

                <!-- Explicit multi-select picker. It deliberately does not rely on
                     ComboBox.ToString()/DisplayMemberPath, because the global DMS
                     ComboBox template can otherwise expose the CLR type name. -->
                <ToggleButton x:Name="BtnWorkcenterPicker"
                              Style="{StaticResource MesWorkcenterPickerToggleStyle}"
                              Width="330"
                              MinHeight="30"
                              Margin="0,0,16,0"
                              HorizontalContentAlignment="Left"
                              Padding="8,3"
                              Click="BtnWorkcenterPicker_Click">
                    <TextBlock x:Name="TxtWorkcenterSelection"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                </ToggleButton>

                <Popup x:Name="PopupWorkcenters"
                       PlacementTarget="{Binding ElementName=BtnWorkcenterPicker}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       Closed="PopupWorkcenters_Closed">
                    <Border Width="430"
                            MaxHeight="460"
                            Padding="10"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource DmsBorderBrush}"
                            Background="{DynamicResource DmsBackgroundBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,8">
                                <Button x:Name="BtnSelectAllWorkcenters"
                                        MinWidth="90"
                                        Margin="0,0,8,0"
                                        Padding="8,3"
                                        Click="BtnSelectAllWorkcenters_Click"/>
                                <Button x:Name="BtnClearWorkcenters"
                                        MinWidth="100"
                                        Padding="8,3"
                                        Click="BtnClearWorkcenters_Click"/>
                            </StackPanel>

                            <ListBox x:Name="LstWorkcenters"
                                     Grid.Row="1"
                                     MinHeight="80"
                                     MaxHeight="380"
                                     SelectionMode="Multiple"
                                     SelectionChanged="LstWorkcenters_SelectionChanged"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <StaticResource ResourceKey="MesWorkcenterListItemStyle"/>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=TwoWay}"
                                                  Padding="3"
                                                  Foreground="{DynamicResource DmsForegroundBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Code}"
                                                           MinWidth="70"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Margin="8,0,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Popup>

                <TextBlock x:Name="LblGroup"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
                <ComboBox x:Name="CmbGroup"
                          Width="230"
                          Margin="0,0,16,0"
                          SelectionChanged="CmbGroup_SelectionChanged"/>


            </WrapPanel>
        </Border>

        <DataGrid x:Name="GridOverview"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource DmsBorderBrush}"
                  Background="{DynamicResource DmsPanelBrush}"
                  Foreground="{DynamicResource DmsForegroundBrush}"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColWorkcenter" Binding="{Binding WorkcenterCode}" Width="125"/>
                <DataGridTextColumn x:Name="ColShift" Binding="{Binding ShiftName}" Width="150"/>
                <DataGridTextColumn x:Name="ColOrder" Binding="{Binding OrderCode}" Width="105"/>
                <DataGridTextColumn x:Name="ColItem" Binding="{Binding ProductCode}" Width="145"/>

                <DataGridTemplateColumn x:Name="ColState" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StateBrush}" Padding="5,2">
                                <TextBlock Text="{Binding StateName}"
                                           Foreground="{Binding StateForegroundBrush}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="ColStateDuration" Width="125">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StateBrush}" Padding="5,2">
                                <TextBlock Text="{Binding StateDurationText}"
                                           Foreground="{Binding StateForegroundBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="ColUserText" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StateBrush}" Padding="5,2">
                                <TextBlock Text="{Binding StateUserText}"
                                           Foreground="{Binding StateForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn x:Name="ColPlannedPerformance" Binding="{Binding PlannedPerformanceText}" Width="130"/>
                <DataGridTextColumn x:Name="ColCurrentPerformance" Binding="{Binding CurrentPerformanceText}" Width="140"/>
                <DataGridTextColumn x:Name="ColPoTarget" Binding="{Binding OrderTargetText}" Width="125"/>
                <DataGridTextColumn x:Name="ColPoGood" Binding="{Binding OrderGoodText}" Width="135"/>
                <DataGridTextColumn x:Name="ColShiftGood" Binding="{Binding ShiftGoodText}" Width="125"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtRows"
                       Grid.Column="0"
                       Margin="0,0,18,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
            <TextBlock x:Name="TxtRefresh"
                       Grid.Column="1"
                       Margin="0,0,18,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
            <TextBlock x:Name="TxtStatus"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </Grid>
    </Grid>
</UserControl>
