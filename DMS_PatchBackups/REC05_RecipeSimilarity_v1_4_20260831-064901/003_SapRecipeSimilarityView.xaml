<UserControl x:Class="DMS.Desktop.Views.Sap.SapRecipeSimilarityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="760">
    <Grid Margin="0,8,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="360"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="300"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TxtTitle"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>
            <TextBlock x:Name="TxtSubtitle"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock x:Name="LblMinSimilarity"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>
            <ComboBox x:Name="CmbMinSimilarity"
                      Width="95"
                      Margin="0,0,16,0"
                      SelectionChanged="Filter_Changed"/>

            <TextBlock x:Name="LblRatioTolerance"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>
            <ComboBox x:Name="CmbRatioTolerance"
                      Width="105"
                      Margin="0,0,16,0"
                      SelectionChanged="Filter_Changed"/>

            <TextBlock x:Name="LblSearch"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>
            <TextBox x:Name="TxtSearch"
                     Width="220"
                     Margin="0,0,16,0"
                     TextChanged="TxtSearch_TextChanged"/>

            <CheckBox x:Name="ChkIdentical"
                      IsChecked="True"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      Checked="DisplayFilter_Changed"
                      Unchecked="DisplayFilter_Changed"
                      Foreground="{DynamicResource DmsForegroundBrush}"/>
            <CheckBox x:Name="ChkSameComponents"
                      IsChecked="True"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      Checked="DisplayFilter_Changed"
                      Unchecked="DisplayFilter_Changed"
                      Foreground="{DynamicResource DmsForegroundBrush}"/>
            <CheckBox x:Name="ChkSimilar"
                      IsChecked="True"
                      Margin="0,0,16,0"
                      VerticalAlignment="Center"
                      Checked="DisplayFilter_Changed"
                      Unchecked="DisplayFilter_Changed"
                      Foreground="{DynamicResource DmsForegroundBrush}"/>

            <Button x:Name="BtnAnalyze"
                    Padding="13,6"
                    Click="BtnAnalyze_Click"/>
        </WrapPanel>

        <Border Grid.Row="2"
                Margin="0,0,0,10"
                Padding="10"
                CornerRadius="7"
                BorderThickness="1"
                Background="{DynamicResource DmsPanelBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}">
            <StackPanel>
                <TextBlock x:Name="TxtSummary"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
                <TextBlock x:Name="TxtStatus"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                <TextBlock x:Name="TxtWarning"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="#C56A43"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="GridPairs"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  GridLinesVisibility="Horizontal"
                  SelectionChanged="GridPairs_SelectionChanged"
                  PreviewMouseDoubleClick="GridPairs_PreviewMouseDoubleClick"
                  Background="{DynamicResource DmsBackgroundBrush}"
                  Foreground="{DynamicResource DmsForegroundBrush}"
                  BorderBrush="{DynamicResource DmsBorderBrush}"/>

        <Grid Grid.Row="4" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="TxtDetailTitle"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
                <TextBlock x:Name="TxtDetailSubtitle"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="BtnOpenA" Margin="8,0,0,0" Padding="10,5" Click="BtnOpenA_Click" IsEnabled="False"/>
                <Button x:Name="BtnOpenB" Margin="8,0,0,0" Padding="10,5" Click="BtnOpenB_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="GridComponents"
                  Grid.Row="5"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Extended"
                  SelectionUnit="CellOrRowHeader"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  GridLinesVisibility="Horizontal"
                  Background="{DynamicResource DmsBackgroundBrush}"
                  Foreground="{DynamicResource DmsForegroundBrush}"
                  BorderBrush="{DynamicResource DmsBorderBrush}"/>
    </Grid>
</UserControl>
