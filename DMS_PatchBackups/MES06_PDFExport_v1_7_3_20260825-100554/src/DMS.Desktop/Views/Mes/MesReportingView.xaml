<UserControl x:Class="DMS.Desktop.Views.Mes.MesReportingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">
    <UserControl.Resources>
        <!-- MES06 local high-contrast calendar. -->
        <Style x:Key="Mes06CalendarDayButtonStyle"
               TargetType="{x:Type CalendarDayButton}">
            <Setter Property="Foreground"
                    Value="{DynamicResource DmsForegroundBrush}"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource DmsBorderBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource DmsAccentBrush}"/>
                    <Setter Property="Foreground"
                            Value="{DynamicResource DmsOnAccentBrush}"/>
                </Trigger>
                <Trigger Property="IsToday"
                         Value="True">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource DmsAccentBrush}"/>
                    <Setter Property="BorderThickness"
                            Value="2"/>
                </Trigger>
                <Trigger Property="IsBlackedOut"
                         Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource DmsMutedForegroundBrush}"/>
                    <Setter Property="Opacity"
                            Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Mes06CalendarButtonStyle"
               TargetType="{x:Type CalendarButton}">
            <Setter Property="Foreground"
                    Value="{DynamicResource DmsForegroundBrush}"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource DmsBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Mes06CalendarItemStyle"
               TargetType="{x:Type CalendarItem}">
            <Setter Property="Foreground"
                    Value="{DynamicResource DmsForegroundBrush}"/>
            <Setter Property="Background"
                    Value="{DynamicResource DmsPanelBrush}"/>
        </Style>

        <Style x:Key="Mes06CalendarStyle"
               TargetType="{x:Type Calendar}">
            <Setter Property="Foreground"
                    Value="{DynamicResource DmsForegroundBrush}"/>
            <Setter Property="Background"
                    Value="{DynamicResource DmsPanelBrush}"/>
            <Setter Property="CalendarDayButtonStyle"
                    Value="{StaticResource Mes06CalendarDayButtonStyle}"/>
            <Setter Property="CalendarButtonStyle"
                    Value="{StaticResource Mes06CalendarButtonStyle}"/>
            <Setter Property="CalendarItemStyle"
                    Value="{StaticResource Mes06CalendarItemStyle}"/>
        </Style>

        <Style x:Key="Mes06WorkcenterSelectorStyle"
               TargetType="{x:Type ToggleButton}">
            <Setter Property="Foreground"
                    Value="{DynamicResource DmsForegroundBrush}"/>
            <Setter Property="Background"
                    Value="{DynamicResource DmsPanelBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource DmsBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="8,0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>

                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Text="&#xE70D;"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource DmsBackgroundBrush}"/>
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{DynamicResource DmsAccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource DmsBackgroundBrush}"/>
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{DynamicResource DmsAccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{DynamicResource DmsAccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Mes06FilterExpanderStyle"
               TargetType="{x:Type Expander}">
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource DmsForegroundBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
                <TextBlock x:Name="TxtSubtitle"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Margin="28,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                <ToggleButton x:Name="BtnPresetMenu"
                              Width="205"
                              Height="36"
                              Margin="0,0,8,0"
                              Style="{StaticResource Mes06WorkcenterSelectorStyle}">
                    <TextBlock x:Name="TxtActivePreset"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                </ToggleButton>

                <Popup x:Name="PopupPresets"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=BtnPresetMenu}"
                       IsOpen="{Binding IsChecked, ElementName=BtnPresetMenu, Mode=TwoWay}"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Width="310"
                            MaxHeight="440"
                            Padding="10"
                            Background="{DynamicResource DmsPanelBrush}"
                            BorderBrush="{DynamicResource DmsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="TxtPresetMenuTitle"
                                       Grid.Row="0"
                                       Margin="2,0,2,7"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>

                            <ListBox x:Name="LstReportPresets"
                                     Grid.Row="1"
                                     MaxHeight="280"
                                     DisplayMemberPath="Name"
                                     SelectionChanged="LstReportPresets_SelectionChanged"
                                     HorizontalContentAlignment="Stretch"/>

                            <StackPanel Grid.Row="2"
                                        Margin="0,8,0,0">
                                <Separator Margin="0,0,0,8"/>

                                <Button x:Name="BtnSavePreset"
                                        Height="30"
                                        Margin="0,0,0,6"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,0"
                                        Click="BtnSavePreset_Click"/>

                                <Button x:Name="BtnDeletePreset"
                                        Height="30"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,0"
                                        Click="BtnDeletePreset_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Popup>

                <Button x:Name="BtnToolbarPrint"
                        MinWidth="88"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="BtnToolbarPrint_Click"/>

                <Button x:Name="BtnToolbarPreview"
                        MinWidth="105"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="BtnToolbarPreview_Click"/>

                <Button x:Name="BtnToolbarExcel"
                        MinWidth="92"
                        Height="36"
                        Click="BtnToolbarExcel_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="315"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- FASTEC-like left filter rail. -->
            <Border Grid.Column="0"
                    Padding="10"
                    Background="{DynamicResource DmsBackgroundBrush}"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtFilterTitle"
                               Grid.Row="0"
                               Margin="2,0,0,8"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <Grid Grid.Row="1"
                          Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnLoad"
                                Grid.Column="0"
                                Height="32"
                                Margin="0,0,4,0"
                                Click="BtnLoad_Click"/>

                        <Button x:Name="BtnResetFilters"
                                Grid.Column="1"
                                Height="32"
                                Margin="4,0,0,0"
                                Click="BtnResetFilters_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Expander x:Name="ExpReport"
                                      IsExpanded="True"
                                      Style="{StaticResource Mes06FilterExpanderStyle}">
                                <Border Padding="6"
                                        BorderBrush="{DynamicResource DmsBorderBrush}"
                                        BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="LblReport"
                                                   Margin="0,0,0,4"
                                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                                        <ComboBox x:Name="CmbReport"
                                                  Height="30"
                                                  DisplayMemberPath="DisplayText"
                                                  SelectionChanged="CmbReport_SelectionChanged"/>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <Expander x:Name="ExpPeriod"
                                      IsExpanded="True"
                                      Style="{StaticResource Mes06FilterExpanderStyle}">
                                <Border Padding="6"
                                        BorderBrush="{DynamicResource DmsBorderBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="LblQuickPeriod"
                                                   Grid.Row="0"
                                                   Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                                        <ComboBox x:Name="CmbQuickPeriod"
                                                  Grid.Row="0"
                                                  Grid.Column="1"
                                                  Height="28"
                                                  SelectionChanged="CmbQuickPeriod_SelectionChanged"/>

                                        <TextBlock x:Name="LblFrom"
                                                   Grid.Row="1"
                                                   Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                                        <DatePicker x:Name="DateFrom"
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Height="28"
                                                    CalendarStyle="{StaticResource Mes06CalendarStyle}"
                                                    SelectedDateFormat="Short"/>

                                        <TextBlock x:Name="LblTo"
                                                   Grid.Row="2"
                                                   Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                                        <DatePicker x:Name="DateTo"
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Height="28"
                                                    CalendarStyle="{StaticResource Mes06CalendarStyle}"
                                                    SelectedDateFormat="Short"/>
                                    </Grid>
                                </Border>
                            </Expander>

                            <Expander x:Name="ExpWorkcenters"
                                      IsExpanded="True"
                                      Style="{StaticResource Mes06FilterExpanderStyle}">
                                <Border Padding="6"
                                        BorderBrush="{DynamicResource DmsBorderBrush}"
                                        BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="LblWorkcenter"
                                                   Margin="0,0,0,4"
                                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

                                        <ToggleButton x:Name="BtnWorkcenterSelector"
                                                      Height="30"
                                                      Style="{StaticResource Mes06WorkcenterSelectorStyle}">
                                            <TextBlock x:Name="TxtWorkcenterSelectionSummary"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                                        </ToggleButton>

                                        <Popup x:Name="PopupWorkcenters"
                                               Placement="Bottom"
                                               PlacementTarget="{Binding ElementName=BtnWorkcenterSelector}"
                                               IsOpen="{Binding IsChecked, ElementName=BtnWorkcenterSelector, Mode=TwoWay}"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Width="430"
                                                    MaxHeight="520"
                                                    Padding="10"
                                                    Background="{DynamicResource DmsPanelBrush}"
                                                    BorderBrush="{DynamicResource DmsBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0"
                                                          Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Button x:Name="BtnSelectAllWorkcenters"
                                                                Grid.Column="0"
                                                                Height="30"
                                                                Margin="0,0,4,0"
                                                                Click="BtnSelectAllWorkcenters_Click"/>

                                                        <Button x:Name="BtnClearWorkcenters"
                                                                Grid.Column="1"
                                                                Height="30"
                                                                Margin="4,0,0,0"
                                                                Click="BtnClearWorkcenters_Click"/>
                                                    </Grid>

                                                    <ScrollViewer Grid.Row="1"
                                                                  MaxHeight="450"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl x:Name="WorkcenterGroupItems">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="0,0,0,8">
                                                                        <CheckBox IsThreeState="True"
                                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                                  FontWeight="Bold"
                                                                                  Margin="0,2,0,4">
                                                                            <TextBlock Text="{Binding DisplayName}"/>
                                                                        </CheckBox>

                                                                        <ItemsControl ItemsSource="{Binding Workcenters}"
                                                                                      Margin="18,0,0,0">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                              Margin="0,1,0,1">
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="85"/>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock Grid.Column="0"
                                                                                                       Text="{Binding Code}"
                                                                                                       FontWeight="SemiBold"/>
                                                                                            <TextBlock Grid.Column="1"
                                                                                                       Text="{Binding Description}"
                                                                                                       TextTrimming="CharacterEllipsis"
                                                                                                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                                                                                        </Grid>
                                                                                    </CheckBox>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <Expander x:Name="ExpShift"
                                      IsExpanded="True"
                                      Style="{StaticResource Mes06FilterExpanderStyle}">
                                <Border Padding="6"
                                        BorderBrush="{DynamicResource DmsBorderBrush}"
                                        BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="LblShift"
                                                   Margin="0,0,0,4"
                                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                                        <ComboBox x:Name="CmbShift"
                                                  Height="30"/>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <Expander x:Name="ExpPda"
                                      IsExpanded="True"
                                      Style="{StaticResource Mes06FilterExpanderStyle}">
                                <Border Padding="6"
                                        BorderBrush="{DynamicResource DmsBorderBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="LblProduct"
                                                   Grid.Row="0"
                                                   Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                                        <TextBox x:Name="TxtProduct"
                                                 Grid.Row="0"
                                                 Grid.Column="1"
                                                 Height="28"/>

                                        <TextBlock x:Name="LblOrder"
                                                   Grid.Row="1"
                                                   Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                                        <TextBox x:Name="TxtOrder"
                                                 Grid.Row="1"
                                                 Grid.Column="1"
                                                 Height="28"/>

                                        <TextBlock x:Name="LblOperation"
                                                   Grid.Row="2"
                                                   Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                                        <TextBox x:Name="TxtOperation"
                                                 Grid.Row="2"
                                                 Grid.Column="1"
                                                 Height="28"/>
                                    </Grid>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="Transparent"/>

            <!-- Main report area. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,8,0"
                            Padding="10"
                            Background="{DynamicResource DmsBackgroundBrush}"
                            BorderBrush="{DynamicResource DmsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock x:Name="LblRows"
                                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                            <TextBlock x:Name="TxtRows"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Margin="0,0,8,0"
                            Padding="10"
                            Background="{DynamicResource DmsBackgroundBrush}"
                            BorderBrush="{DynamicResource DmsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock x:Name="LblWorkcenters"
                                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                            <TextBlock x:Name="TxtWorkcenters"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Margin="0,0,8,0"
                            Padding="10"
                            Background="{DynamicResource DmsBackgroundBrush}"
                            BorderBrush="{DynamicResource DmsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock x:Name="LblRefresh"
                                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                            <TextBlock x:Name="TxtRefresh"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3"
                            Padding="10"
                            Background="{DynamicResource DmsBackgroundBrush}"
                            BorderBrush="{DynamicResource DmsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBlock x:Name="TxtReportDescription"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    </Border>
                </Grid>

                <Border x:Name="ChartBorder"
                        Grid.Row="1"
                        Height="220"
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="{DynamicResource DmsBackgroundBrush}"
                        BorderBrush="{DynamicResource DmsBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TxtChartTitle"
                                   Grid.Row="0"
                                   Margin="0,0,0,8"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>

                        <ContentControl x:Name="ChartHost"
                                        Grid.Row="1"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"/>
                    </Grid>
                </Border>

                <DataGrid x:Name="GridReport"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="True"
                          CanUserSortColumns="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          LoadingRow="GridReport_LoadingRow"
                          UnloadingRow="GridReport_UnloadingRow"/>

                <Border x:Name="CounterSummaryBorder"
                        Grid.Row="3"
                        Margin="0,10,0,0"
                        Padding="8"
                        Background="{DynamicResource DmsBackgroundBrush}"
                        BorderBrush="{DynamicResource DmsBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TxtCounterSummaryTitle"
                                   Grid.Row="0"
                                   Margin="0,0,0,6"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>

                        <DataGrid x:Name="GridCounterSummary"
                                  Grid.Row="1"
                                  MaxHeight="220"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserResizeColumns="True"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="4"
                      Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnReloadDefinitions"
                            Grid.Column="0"
                            MinWidth="150"
                            Margin="0,0,8,0"
                            Click="BtnReloadDefinitions_Click"/>

                    <Button x:Name="BtnExportExcel"
                            Grid.Column="1"
                            MinWidth="130"
                            Visibility="Collapsed"
                            Click="BtnExportExcel_Click"/>

                    <TextBlock x:Name="TxtStatus"
                               Grid.Column="2"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
