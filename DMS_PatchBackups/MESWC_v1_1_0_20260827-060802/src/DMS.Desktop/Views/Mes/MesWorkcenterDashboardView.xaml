<UserControl x:Class="DMS.Desktop.Views.Mes.MesWorkcenterDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="720" MinWidth="1100">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DmsMutedForegroundBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource DmsBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,4,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TxtTitle" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBlock x:Name="TxtSubtitle" Margin="0,3,0,0" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtLastRefresh" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                        <Button x:Name="BtnRefresh" MinWidth="90" Padding="12,5" Click="BtnRefresh_Click"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,8"><TextBlock x:Name="LblShift" Style="{StaticResource Caption}"/><TextBlock x:Name="TxtShift" Style="{StaticResource Value}"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,8"><TextBlock x:Name="LblShiftPeriod" Style="{StaticResource Caption}"/><TextBlock x:Name="TxtShiftPeriod" Style="{StaticResource Value}"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,8"><TextBlock x:Name="LblState" Style="{StaticResource Caption}"/><Border x:Name="StateBadge" Padding="6,3" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock x:Name="TxtState" FontWeight="Bold" Foreground="Black"/><TextBlock x:Name="TxtStateDuration" Margin="8,0,0,0" Foreground="Black"/></StackPanel></Border></StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,12,8"><TextBlock x:Name="LblOrder" Style="{StaticResource Caption}"/><TextBlock x:Name="TxtOrder" Style="{StaticResource Value}"/></StackPanel>
                            <StackPanel Grid.Column="4" Margin="0,0,12,8"><TextBlock x:Name="LblArticle" Style="{StaticResource Caption}"/><TextBlock x:Name="TxtArticle" Style="{StaticResource Value}"/></StackPanel>
                            <StackPanel Grid.Column="5" Margin="0,0,0,8"><TextBlock x:Name="LblOperation" Style="{StaticResource Caption}"/><TextBlock x:Name="TxtOperation" Style="{StaticResource Value}"/></StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2.2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock x:Name="LblPlannedPerformance" Style="{StaticResource Caption}"/><TextBlock x:Name="TxtPlannedPerformance" Style="{StaticResource Value}"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock x:Name="LblShiftNorm" Style="{StaticResource Caption}"/><TextBlock x:Name="TxtShiftNorm" Style="{StaticResource Value}"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock x:Name="LblShiftGood" Style="{StaticResource Caption}"/><TextBlock x:Name="TxtShiftGood" Style="{StaticResource Value}"/></StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock x:Name="LblShiftScrap" Style="{StaticResource Caption}"/><TextBlock x:Name="TxtShiftScrap" Style="{StaticResource Value}"/></StackPanel>
                            <StackPanel Grid.Column="4" Margin="0,0,12,0"><TextBlock x:Name="LblExpected" Style="{StaticResource Caption}"/><TextBlock x:Name="TxtExpected" Style="{StaticResource Value}"/></StackPanel>
                            <StackPanel Grid.Column="5"><TextBlock x:Name="LblOrderProgress" Style="{StaticResource Caption}"/><Grid><ProgressBar x:Name="PbOrderProgress" Height="22" Minimum="0" Maximum="100"/><TextBlock x:Name="TxtOrderProgress" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="Black"/></Grid></StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="165"/></Grid.RowDefinitions>
                            <TextBlock x:Name="TxtOrdersTitle" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DmsForegroundBrush}" Margin="0,0,0,7"/>
                            <DataGrid x:Name="GridOrders" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="All" EnableRowVirtualization="True" Background="{DynamicResource DmsPanelBrush}" Foreground="{DynamicResource DmsForegroundBrush}" BorderBrush="{DynamicResource DmsBorderBrush}">
                                <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColOrderStatus" Binding="{Binding StatusCode}" Width="70"/>
                                    <DataGridTextColumn x:Name="ColAssignedOrder" Binding="{Binding OrderCode}" Width="90"/>
                                    <DataGridTextColumn x:Name="ColAssignedArticle" Binding="{Binding ProductCode}" Width="125"/>
                                    <DataGridTextColumn x:Name="ColAssignedOperation" Binding="{Binding OperationCode}" Width="70"/>
                                    <DataGridTextColumn x:Name="ColAssignedProgress" Binding="{Binding ProgressText}" Width="75"/>
                                    <DataGridTextColumn x:Name="ColAssignedTarget" Binding="{Binding TargetText}" Width="90"/>
                                    <DataGridTextColumn x:Name="ColAssignedRemaining" Binding="{Binding RemainingText}" Width="90"/>
                                    <DataGridTextColumn x:Name="ColAssignedScrap" Binding="{Binding ScrapText}" Width="80"/>
                                    <DataGridTextColumn x:Name="ColAssignedStart" Binding="{Binding PlannedStart, StringFormat={}{0:dd.MM HH:mm}}" Width="105"/>
                                    <DataGridTextColumn x:Name="ColAssignedEnd" Binding="{Binding PlannedEnd, StringFormat={}{0:dd.MM HH:mm}}" Width="105"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,8">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="165"/></Grid.RowDefinitions>
                            <TextBlock x:Name="TxtOperatorsTitle" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DmsForegroundBrush}" Margin="0,0,0,7"/>
                            <DataGrid x:Name="GridOperators" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="All" Background="{DynamicResource DmsPanelBrush}" Foreground="{DynamicResource DmsForegroundBrush}" BorderBrush="{DynamicResource DmsBorderBrush}">
                                <DataGrid.Columns><DataGridTextColumn x:Name="ColOperatorLogin" Binding="{Binding LoginTimeText}" Width="135"/><DataGridTextColumn x:Name="ColOperatorName" Binding="{Binding Personnel}" Width="*"/></DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.85*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="TxtOeeTitle" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DmsForegroundBrush}" Margin="0,0,0,8"/>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock x:Name="LblAvailability" VerticalAlignment="Center" Foreground="{DynamicResource DmsForegroundBrush}"/><ProgressBar x:Name="PbAvailability" Grid.Column="1" Height="18" Maximum="100"/><TextBlock x:Name="TxtAvailability" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource DmsForegroundBrush}"/></Grid>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock x:Name="LblPerformance" VerticalAlignment="Center" Foreground="{DynamicResource DmsForegroundBrush}"/><ProgressBar x:Name="PbPerformance" Grid.Column="1" Height="18" Maximum="150"/><TextBlock x:Name="TxtPerformance" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource DmsForegroundBrush}"/></Grid>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock x:Name="LblQuality" VerticalAlignment="Center" Foreground="{DynamicResource DmsForegroundBrush}"/><ProgressBar x:Name="PbQuality" Grid.Column="1" Height="18" Maximum="100"/><TextBlock x:Name="TxtQuality" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource DmsForegroundBrush}"/></Grid>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="OEE" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource DmsForegroundBrush}"/><ProgressBar x:Name="PbOee" Grid.Column="1" Height="18" Maximum="100"/><TextBlock x:Name="TxtOee" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource DmsForegroundBrush}"/></Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,8">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/></Grid.RowDefinitions>
                            <TextBlock x:Name="TxtStatesTitle" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DmsForegroundBrush}" Margin="0,0,0,7"/>
                            <DataGrid x:Name="GridStates" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="All" Background="{DynamicResource DmsPanelBrush}" Foreground="{DynamicResource DmsForegroundBrush}" BorderBrush="{DynamicResource DmsBorderBrush}">
                                <DataGrid.Columns><DataGridTextColumn x:Name="ColStateName" Binding="{Binding StateName}" Width="*"/><DataGridTextColumn x:Name="ColStateCount" Binding="{Binding Occurrences}" Width="75"/><DataGridTextColumn x:Name="ColStateDuration" Binding="{Binding DurationText}" Width="105"/></DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="4" Style="{StaticResource Card}">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="290"/></Grid.RowDefinitions>
                        <TextBlock x:Name="TxtGraphTitle" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DmsForegroundBrush}" Margin="0,0,0,7"/>
                        <Grid x:Name="GraphHost" Grid.Row="1" Background="White" SizeChanged="GraphHost_SizeChanged"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="TxtStatus" Grid.Row="5" Margin="4,2,4,0" TextWrapping="Wrap" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
