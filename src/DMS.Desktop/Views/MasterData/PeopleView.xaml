<UserControl x:Class="DMS.Desktop.Views.MasterData.PeopleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel Grid.Row="0" Margin="0,0,0,10"><TextBlock Text="Hledat:" VerticalAlignment="Center" Foreground="{DynamicResource DmsForegroundBrush}"/><TextBox x:Name="TxtFilter" Width="240" Margin="6,0,12,0" TextChanged="FilterChanged"/><CheckBox x:Name="ChkShowInactive" Content="Zobrazit neaktivní" Foreground="{DynamicResource DmsForegroundBrush}" Checked="FilterChanged" Unchecked="FilterChanged"/></WrapPanel>
  <DataGrid x:Name="GridPeople" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="GridPeople_SelectionChanged" Background="{DynamicResource DmsBackgroundBrush}" Foreground="{DynamicResource DmsForegroundBrush}" HorizontalScrollBarVisibility="Auto">
   <DataGrid.Columns><DataGridTextColumn Header="Osobní číslo" Binding="{Binding PersonnelNumber}" Width="120"/><DataGridTextColumn Header="Příjmení" Binding="{Binding LastName}" Width="160"/><DataGridTextColumn Header="Jméno" Binding="{Binding FirstName}" Width="160"/><DataGridTextColumn Header="Organizační jednotka" Binding="{Binding OrganizationUnitName}" Width="220"/><DataGridTextColumn Header="Typ" Binding="{Binding PersonTypeText}" Width="220"/><DataGridCheckBoxColumn Header="Aktivní" Binding="{Binding Person.IsActive}" Width="80"/></DataGrid.Columns>
  </DataGrid>
  <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource DmsBorderBrush}" Background="{DynamicResource DmsPanelBrush}" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Grid.Column="0"><TextBlock Text="Osobní číslo"/><TextBox x:Name="TxtPersonnelNumber"/><TextBlock Text="Jméno" Margin="0,6,0,0"/><TextBox x:Name="TxtFirstName"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="Příjmení"/><TextBox x:Name="TxtLastName"/><TextBlock Text="Organizační jednotka" Margin="0,6,0,0"/><ComboBox x:Name="CmbOrganizationUnit" DisplayMemberPath="DisplayText"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="Typ osoby"/><ComboBox x:Name="CmbPersonType"/><CheckBox x:Name="ChkActive" Content="Aktivní" Margin="0,12,0,0" Foreground="{DynamicResource DmsForegroundBrush}"/></StackPanel>
   <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0"><Button Content="Nová osoba" Click="New_Click" Margin="0,0,8,0"/><Button Content="Uložit" Click="Save_Click" Margin="0,0,8,0"/><Button Content="Deaktivovat / aktivovat" Click="Toggle_Click"/><TextBlock x:Name="TxtStatus" Margin="16,4,0,0" Foreground="{DynamicResource DmsMutedForegroundBrush}"/></WrapPanel>
  </Grid></Border>
 </Grid>
</UserControl>
