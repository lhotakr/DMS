  "code": "BONUS_BASE",
  "name": "Podklady pro prémie",
  "description": "Souhrn výkonu operátorů pro výpočet prémií: směna, přihlášení na stroji, hrubá a čistá produkce.",
  "dataSource": "BonusBase",
  "maxRows": 10000,
  "columns": [
    {
      "property": "OrderCode",
      "header": "Zakázka",
      "width": 100,
      "format": "",
      "headerKey": "MES06.BonusBase.Column.Order"
    },
