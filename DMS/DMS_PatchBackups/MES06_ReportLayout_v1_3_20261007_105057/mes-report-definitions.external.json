    },
    {
      "property": "OperatorName",
      "header": "Pracovník",
      "width": 180,
      "format": "",
      "headerKey": "MES06.BonusBase.Column.Operator"
    },
    {
      "property": "HumanCode",
      "header": "Osobní číslo",
      "width": 105,
      "format": "",
      "headerKey": "MES06.BonusBase.Column.HumanCode"
    },
    {
      "property": "LoginFrom",
      "header": "Čas od",
      "width": 135,
      "format": "dd.MM.yyyy HH:mm",
      "headerKey": "MES06.BonusBase.Column.From"
    },
    {
      "property": "LoginTo",
      "header": "Čas do",
      "width": 135,
      "format": "dd.MM.yyyy HH:mm",
      "headerKey": "MES06.BonusBase.Column.To"
    },
    {
      "property": "NetShiftDurationMinutes",
      "header": "Čistý čas na stroji [min]",
      "width": 160,
      "format": "0.0",
      "headerKey": "MES06.BonusBase.Column.NetShiftDurationMinutes"
    },
    {
      "property": "GrossProduction",
      "header": "StrojS hrubé",
      "width": 120,
      "format": "0.###",
      "headerKey": "MES06.BonusBase.Column.GrossProduction"
    },
    {
      "property": "PrintedNet",
      "header": "Natisknuto",
      "width": 120,
      "format": "0.###",
      "headerKey": "MES06.BonusBase.Column.PrintedNet"
    }
  ],
  "nameKey": "MES06.Report.BonusBase.Name",
  "descriptionKey": "MES06.Report.BonusBase.Description",
  "calculation": {
    "sources": {
      "operators": "LoggedOperators",
      "counters": "Counters"
    },
    "shiftCoding": {
      "sourceProperty": "ShiftCode",
      "codes": {
        "I": "Ranní směna",
        "II": "Odpolední směna",
        "III": "Noční směna"
      }
    },
    "counters": {
      "grossProduction": {
        "counterName": "Vyrobeno - stroj"
      },
      "scrapProduction": {
        "counterName": "Odpad - produkce"
      },
      "scrapGlass": {
        "counterName": "Odpad - sklo"
      },
      "washedBottles": {
        "counterName": "Myté flakony"
      }
    },
    "metrics": {
      "GrossProduction": {
        "expression": "SUM(counter.grossProduction)",
        "description": "StrojS hrubé = suma čítače 'Vyrobeno - stroj' v intervalech směny operátora."
      },
      "PrintedNet": {
        "expression": "SUM(counter.grossProduction) - SUM(counter.scrapProduction) - SUM(counter.scrapGlass) - SUM(counter.washedBottles)",
        "description": "Natisknuto = Vyrobeno - stroj - Odpad - produkce - Odpad - sklo - Myté flakony."
      }
    },
    "shiftDuration": {
      "mode": "login_interval_with_flat_break",
      "loginFromProperty": "LoginFrom",
      "loginToProperty": "LoginTo",
      "netDurationProperty": "NetShiftDurationMinutes",
      "flatBreak": {
        "enabled": true,
        "thresholdMinutes": 270,
        "breakMinutes": 30,
        "perShiftOverrides": {
          "I": {
            "thresholdMinutes": 270,
            "breakMinutes": 30
          },
          "II": {
            "thresholdMinutes": 270,
            "breakMinutes": 30
          },
          "III": {
            "thresholdMinutes": 270,
            "breakMinutes": 30
          }
        }
      },
      "expression": "durationMinutes = DATEDIFF(LoginFrom, LoginTo); if (durationMinutes > thresholdMinutes) NetShiftDurationMinutes = durationMinutes - breakMinutes; else NetShiftDurationMinutes = durationMinutes"
    },
    "visibility": {
      "hideColumns": [
        "IDSměna"
      ]
    }
  }
}
