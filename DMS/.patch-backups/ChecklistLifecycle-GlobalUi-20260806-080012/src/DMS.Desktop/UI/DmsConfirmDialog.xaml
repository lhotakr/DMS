<Window x:Class="DMS.Desktop.UI.DmsConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Potvrzení"
        Width="460"
        Height="230"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DmsPanelBrush}"
        Foreground="{DynamicResource DmsForegroundBrush}">

    <Border Padding="20"
            Background="{DynamicResource DmsPanelBrush}"
            BorderBrush="{DynamicResource DmsBorderBrush}"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtTitle"
                       Grid.Row="0"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,16"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>

            <TextBlock x:Name="TxtMessage"
                       Grid.Row="1"
                       FontSize="14"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">

                <Button x:Name="BtnYes"
                        Content="Ano"
                        MinWidth="90"
                        Margin="0,0,8,0"
                        Style="{StaticResource DmsPrimaryButtonStyle}"
                        Click="BtnYes_Click"/>

                <Button x:Name="BtnNo"
                        Content="Ne"
                        MinWidth="90"
                        Margin="0,0,8,0"
                        Style="{StaticResource DmsFormButtonStyle}"
                        Click="BtnNo_Click"/>

                <Button x:Name="BtnCancel"
                        Content="Zrušit"
                        MinWidth="90"
                        Style="{StaticResource DmsFormButtonStyle}"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>