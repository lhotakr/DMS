<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Barvy -->
<SolidColorBrush x:Key="DmsBackgroundBrush" Color="#F4F6F8"/>
<SolidColorBrush x:Key="DmsPanelBrush" Color="#FFFFFF"/>
<SolidColorBrush x:Key="DmsForegroundBrush" Color="#111111"/>
<SolidColorBrush x:Key="DmsMutedForegroundBrush" Color="#666666"/>
<SolidColorBrush x:Key="DmsBorderBrush" Color="#D0D7DE"/>
<SolidColorBrush x:Key="DmsAccentBrush" Color="#0B2A4A"/>
<SolidColorBrush x:Key="DmsOnAccentBrush" Color="#FFFFFF"/>

    <!-- Texty -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="Margin" Value="0,2,0,2"/>
    </Style>

    <!-- TextBox -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <!-- ComboBox -->
    <Style TargetType="{x:Type ComboBox}">
    <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
    <Setter Property="Padding" Value="4"/>
</Style>

    <!-- Položky ComboBoxu -->
<Style TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
    <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        BorderThickness="0"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="ContentSite"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>

                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="{DynamicResource DmsAccentBrush}"/>
                        <Setter Property="Foreground"
                                Value="{DynamicResource DmsOnAccentBrush}"/>
                    </Trigger>

                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="{DynamicResource DmsAccentBrush}"/>
                        <Setter Property="Foreground"
                                Value="{DynamicResource DmsOnAccentBrush}"/>
                    </Trigger>

                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground"
                                Value="{DynamicResource DmsMutedForegroundBrush}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>


    <!-- ListBox -->
    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
    </Style>

    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="4,2"/>

        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DmsBorderBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Button -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- StatusBar -->
    <Style TargetType="{x:Type StatusBar}">
        <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type StatusBarItem}">
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
    </Style>

    <!-- Karta -->
    <Style x:Key="DmsCardBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Nadpis -->
    <Style x:Key="DmsTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

<!-- DataGrid -->
<Style TargetType="{x:Type DataGrid}">
    <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
    <Setter Property="RowBackground" Value="{DynamicResource DmsPanelBrush}"/>
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource DmsBackgroundBrush}"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DmsBorderBrush}"/>
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DmsBorderBrush}"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
</Style>

<!-- Hlavička sloupce -->
<Style TargetType="{x:Type DataGridColumnHeader}">
    <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="FontWeight" Value="Bold"/>
</Style>

<!-- Řádek -->
<Style TargetType="{x:Type DataGridRow}">
    <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>

    <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
        </Trigger>

        <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
        </Trigger>
    </Style.Triggers>
</Style>

<!-- Buňka -->
<Style TargetType="{x:Type DataGridCell}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="6,3"/>

    <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
        </Trigger>
    </Style.Triggers>
</Style>

</ResourceDictionary>