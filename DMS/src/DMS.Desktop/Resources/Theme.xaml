<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================
         BARVY
         ========================================================= -->

    <SolidColorBrush x:Key="DmsBackgroundBrush"
                     Color="#F4F6F8"/>

    <SolidColorBrush x:Key="DmsPanelBrush"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="DmsForegroundBrush"
                     Color="#111111"/>

    <SolidColorBrush x:Key="DmsMutedForegroundBrush"
                     Color="#666666"/>

    <SolidColorBrush x:Key="DmsBorderBrush"
                     Color="#D0D7DE"/>

    <SolidColorBrush x:Key="DmsAccentBrush"
                     Color="#0B2A4A"/>

    <SolidColorBrush x:Key="DmsOnAccentBrush"
                     Color="#FFFFFF"/>

    <!-- Systémové výběrové barvy -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                     Color="#0B2A4A"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                     Color="#0B2A4A"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                     Color="#FFFFFF"/>


    <!-- =========================================================
         ZÁKLADNÍ TEXTOVÉ PRVKY
         ========================================================= -->

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type Label}">
        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="Margin"
                Value="0,2,0,2"/>
    </Style>


    <!-- =========================================================
         TEXTBOX
         ========================================================= -->

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background"
                Value="{DynamicResource DmsBackgroundBrush}"/>

        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>

        <Setter Property="BorderBrush"
                Value="{DynamicResource DmsBorderBrush}"/>

        <Setter Property="CaretBrush"
                Value="{DynamicResource DmsForegroundBrush}"/>

        <Setter Property="SelectionBrush"
                Value="{DynamicResource DmsAccentBrush}"/>

        <Setter Property="SelectionTextBrush"
                Value="{DynamicResource DmsOnAccentBrush}"/>

        <Setter Property="Padding"
                Value="6,3"/>
    </Style>


    <!-- =========================================================
         FORMULÁŘOVÉ STYLY
         ========================================================= -->

    <Style x:Key="DmsSectionTitleStyle"
           TargetType="{x:Type TextBlock}">

        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>

        <Setter Property="FontSize"
                Value="18"/>

        <Setter Property="FontWeight"
                Value="Bold"/>

        <Setter Property="Margin"
                Value="0,14,0,10"/>
    </Style>

    <Style x:Key="DmsFormLabelStyle"
           TargetType="{x:Type TextBlock}">

        <Setter Property="Foreground"
                Value="{DynamicResource DmsMutedForegroundBrush}"/>

        <Setter Property="Margin"
                Value="0,6,10,6"/>

        <Setter Property="VerticalAlignment"
                Value="Center"/>

        <Setter Property="TextWrapping"
                Value="Wrap"/>
    </Style>

    <Style x:Key="DmsFormTextBoxStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource {x:Type TextBox}}">

        <Setter Property="Margin"
                Value="0,4,0,4"/>

        <Setter Property="Padding"
                Value="7,4"/>

        <Setter Property="MinHeight"
                Value="30"/>

        <Setter Property="VerticalContentAlignment"
                Value="Center"/>

        <Setter Property="Background"
                Value="{DynamicResource DmsBackgroundBrush}"/>

        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>

        <Setter Property="BorderBrush"
                Value="{DynamicResource DmsBorderBrush}"/>

        <Setter Property="CaretBrush"
                Value="{DynamicResource DmsForegroundBrush}"/>
    </Style>

    <Style x:Key="DmsReadOnlyTextBoxStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource DmsFormTextBoxStyle}">

        <Setter Property="IsReadOnly"
                Value="True"/>

        <Setter Property="Background"
                Value="{DynamicResource DmsPanelBrush}"/>

        <Setter Property="Foreground"
                Value="{DynamicResource DmsMutedForegroundBrush}"/>
    </Style>

    <Style x:Key="DmsMultilineTextBoxStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource DmsFormTextBoxStyle}">

        <Setter Property="AcceptsReturn"
                Value="True"/>

        <Setter Property="TextWrapping"
                Value="Wrap"/>

        <Setter Property="VerticalContentAlignment"
                Value="Top"/>

        <Setter Property="VerticalScrollBarVisibility"
                Value="Auto"/>
    </Style>


    <!-- =========================================================
         BUTTON
         ========================================================= -->

    <!--
        DMS BUTTON STANDARD
        ================
        DmsButtonBaseStyle      = běžné tlačítko na tmavém/světlém panelu
        DmsAccentButtonStyle    = hlavní akce, používá DmsAccentBrush + DmsOnAccentBrush
        DmsPrimaryButtonStyle   = alias kvůli existujícím obrazovkám
        DmsToolbarButtonStyle   = malé tlačítko v transakční liště, NE akcentní
        DmsToolbarAccentButtonStyle = malé akcentní tlačítko v toolbaru, např. menu
        DmsFlatIconButtonStyle  = ploché tlačítko v levém menu
        DmsFavoriteStarButtonStyle = žlutá hvězdička

        Důležité:
        TextElement.Foreground je nastavený na Border i ContentPresenter,
        aby text uvnitř Buttonu opravdu přebíral Foreground stylu.
    -->

    <Style x:Key="DmsButtonBaseStyle"
           TargetType="{x:Type Button}">

        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="90"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            TextElement.Foreground="{TemplateBinding Foreground}">

                        <ContentPresenter x:Name="ButtonContent"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource DmsBackgroundBrush}"/>
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource DmsAccentBrush}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.82"/>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource DmsAccentBrush}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource DmsBackgroundBrush}"/>
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource DmsBorderBrush}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource DmsMutedForegroundBrush}"/>
                            <Setter TargetName="ButtonContent"
                                    Property="TextElement.Foreground"
                                    Value="{DynamicResource DmsMutedForegroundBrush}"/>
                            <Setter Property="Opacity"
                                    Value="0.45"/>
                            <Setter Property="Cursor"
                                    Value="Arrow"/>
                        </Trigger>

                    </ControlTemplate.Triggers>                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicitní styl pro běžná tlačítka -->
    <Style TargetType="{x:Type Button}"
           BasedOn="{StaticResource DmsButtonBaseStyle}"/>

    <!-- ComboBox -->
    <Style x:Key="DmsEditableComboBoxStyle" TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,0,4,0"/>

        <Style.Resources>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource DmsForegroundBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <Style TargetType="{x:Type ComboBoxItem}">
                <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
            </Style>
        </Style.Resources>
    </Style>
    <Style x:Key="DmsTransactionComboBoxStyle"
       TargetType="{x:Type ComboBox}">

        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="320"/>
        <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>

        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ComboBoxItem}">
                    <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="MinHeight" Value="22"/>

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource DmsBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="{TemplateBinding Padding}">

                                    <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemBorder"
                                            Property="Background"
                                            Value="{DynamicResource DmsAccentBrush}"/>
                                        <Setter Property="Foreground"
                                            Value="{DynamicResource DmsOnAccentBrush}"/>
                                    </Trigger>

                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder"
                                            Property="Background"
                                            Value="{DynamicResource DmsAccentBrush}"/>
                                        <Setter Property="Foreground"
                                            Value="{DynamicResource DmsOnAccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="OuterBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="PART_EditableTextBox"
                                 Grid.Column="0"
                                 Margin="8,0,4,0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 Foreground="{DynamicResource DmsForegroundBrush}"
                                 CaretBrush="{DynamicResource DmsForegroundBrush}"
                                 BorderThickness="0"
                                 Padding="0"
                                 FontWeight="SemiBold"
                                 Visibility="Hidden"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"/>

                            <ContentPresenter x:Name="ContentSite"
                                          Grid.Column="0"
                                          Margin="8,0,4,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          TextElement.Foreground="{DynamicResource DmsForegroundBrush}"/>

                            <ToggleButton x:Name="DropDownToggle"
                                      Grid.Column="1"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen,
                                                          Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Background="Transparent"
                                      BorderThickness="0">

                                <Path Width="8"
                                  Height="5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Fill="{DynamicResource DmsForegroundBrush}"
                                  Data="M 0 0 L 4 5 L 8 0 Z"/>
                            </ToggleButton>
                        </Grid>

                        <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">

                            <Grid MinWidth="{Binding ActualWidth,
                                                 RelativeSource={RelativeSource TemplatedParent}}"
                              MaxHeight="360">

                                <Border Background="{DynamicResource DmsPanelBrush}"
                                    BorderBrush="{DynamicResource DmsBorderBrush}"
                                    BorderThickness="1"/>

                                <ScrollViewer Margin="0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">

                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox"
                                Property="Visibility"
                                Value="Visible"/>
                            <Setter TargetName="ContentSite"
                                Property="Visibility"
                                Value="Hidden"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder"
                                Property="BorderBrush"
                                Value="{DynamicResource DmsAccentBrush}"/>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="OuterBorder"
                                Property="BorderBrush"
                                Value="{DynamicResource DmsAccentBrush}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Akcentní / hlavní tlačítko: v HG režimu žluté tlačítko + černý text -->
    <Style x:Key="DmsAccentButtonStyle"
       TargetType="{x:Type Button}">

        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="90"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DmsAccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3"
                        Padding="{TemplateBinding Padding}">

                        <TextBlock x:Name="ButtonContent"
                               Text="{TemplateBinding Content}"
                               Foreground="{DynamicResource DmsOnAccentBrush}"
                               FontWeight="{TemplateBinding FontWeight}"
                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                               TextAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Opacity"
                                Value="0.92"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Opacity"
                                Value="0.82"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="{DynamicResource DmsBackgroundBrush}"/>
                            <Setter TargetName="ButtonBorder"
                                Property="BorderBrush"
                                Value="{DynamicResource DmsBorderBrush}"/>
                            <Setter TargetName="ButtonContent"
                                Property="Foreground"
                                Value="{DynamicResource DmsMutedForegroundBrush}"/>
                            <Setter Property="Opacity"
                                Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Starší název ponechaný kvůli existujícím obrazovkám -->
    <Style x:Key="DmsPrimaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource DmsAccentButtonStyle}">
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Formulářové tlačítko -->
    <Style x:Key="DmsFormButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource DmsButtonBaseStyle}">
        <Setter Property="MinWidth" Value="90"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
    </Style>

    <!-- Běžné malé tlačítko v horní transakční liště: tmavé/neutrální -->
    <Style x:Key="DmsToolbarButtonStyle"
       TargetType="{x:Type Button}"
       BasedOn="{StaticResource DmsButtonBaseStyle}">

        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="38"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
    </Style>

    <Style x:Key="DmsFavoriteToolbarButtonStyle"
       TargetType="{x:Type Button}"
       BasedOn="{StaticResource DmsToolbarButtonStyle}">

        <Setter Property="Foreground"
            Value="{DynamicResource DmsAccentBrush}"/>

        <Setter Property="Background"
            Value="{DynamicResource DmsPanelBrush}"/>

        <Setter Property="BorderBrush"
            Value="{DynamicResource DmsBorderBrush}"/>
    </Style>

    <!-- Akcentní malé tlačítko v toolbaru, např. menu -->
    <Style x:Key="DmsToolbarAccentButtonStyle"
       TargetType="{x:Type Button}"
       BasedOn="{StaticResource DmsToolbarButtonStyle}">

        <Setter Property="Background"
            Value="{DynamicResource DmsAccentBrush}"/>

        <Setter Property="Foreground"
            Value="{DynamicResource DmsOnAccentBrush}"/>

        <Setter Property="TextElement.Foreground"
            Value="{DynamicResource DmsOnAccentBrush}"/>

        <Setter Property="BorderBrush"
            Value="{DynamicResource DmsAccentBrush}"/>

        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                           Foreground="{DynamicResource DmsOnAccentBrush}"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plochá tlačítka v levém menu -->
    <Style x:Key="DmsFlatIconButtonStyle"
           TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{TemplateBinding Foreground}">

                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DmsAccentBrush}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.75"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DmsMutedForegroundBrush}"/>
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Žlutá hvězdička oblíbených položek -->
    <Style x:Key="DmsFavoriteStarButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource DmsFlatIconButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DmsAccentBrush}"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource DmsAccentBrush}"/>
                <Setter Property="Opacity" Value="0.85"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.70"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- =========================================================
         COMBOBOX ITEM
         ========================================================= -->

    <Style x:Key="DmsComboBoxItemStyle"
           TargetType="{x:Type ComboBoxItem}">

        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>

        <Setter Property="Background"
                Value="{DynamicResource DmsPanelBrush}"/>

        <Setter Property="Padding"
                Value="8,5"/>

        <Setter Property="HorizontalContentAlignment"
                Value="Stretch"/>

        <Setter Property="VerticalContentAlignment"
                Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type ComboBoxItem}">

                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource DmsBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">

                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsHighlighted"
                                 Value="True">

                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{DynamicResource DmsAccentBrush}"/>

                            <Setter Property="Foreground"
                                    Value="{DynamicResource DmsOnAccentBrush}"/>
                        </Trigger>

                        <Trigger Property="IsSelected"
                                 Value="True">

                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{DynamicResource DmsAccentBrush}"/>

                            <Setter Property="Foreground"
                                    Value="{DynamicResource DmsOnAccentBrush}"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{DynamicResource DmsAccentBrush}"/>

                            <Setter Property="Foreground"
                                    Value="{DynamicResource DmsOnAccentBrush}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}"
           BasedOn="{StaticResource DmsComboBoxItemStyle}"/>


    <!-- =========================================================
         COMBOBOX
         ========================================================= -->

    <Style x:Key="DmsComboBoxStyle"
           TargetType="{x:Type ComboBox}">

        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>

        <Setter Property="Background"
                Value="{DynamicResource DmsPanelBrush}"/>

        <Setter Property="BorderBrush"
                Value="{DynamicResource DmsBorderBrush}"/>

        <Setter Property="Padding"
                Value="6,3"/>

        <Setter Property="MinHeight"
                Value="26"/>

        <Setter Property="ItemContainerStyle"
                Value="{StaticResource DmsComboBoxItemStyle}"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type ComboBox}">

                    <Grid>

                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen,
                                                          Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="1">

                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">

                                    <Border x:Name="ToggleBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="26"/>
                                            </Grid.ColumnDefinitions>

                                            <ContentPresenter Grid.Column="0"
                                                              Margin="6,2,4,2"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Left"
                                                              RecognizesAccessKey="True"/>

                                            <Path Grid.Column="1"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Fill="{DynamicResource DmsForegroundBrush}"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Grid>
                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter TargetName="ToggleBorder"
                                                    Property="BorderBrush"
                                                    Value="{DynamicResource DmsAccentBrush}"/>
                                        </Trigger>

                                        <Trigger Property="IsChecked"
                                                 Value="True">

                                            <Setter TargetName="ToggleBorder"
                                                    Property="BorderBrush"
                                                    Value="{DynamicResource DmsAccentBrush}"/>
                                        </Trigger>

                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>

                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{DynamicResource DmsForegroundBrush}"/>
                        </ToggleButton>

                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">

                            <Grid MinWidth="{Binding ActualWidth,
                                                     RelativeSource={RelativeSource TemplatedParent}}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">

                                <Border Background="{DynamicResource DmsPanelBrush}"
                                        BorderBrush="{DynamicResource DmsBorderBrush}"
                                        BorderThickness="1"/>

                                <ScrollViewer Margin="0"
                                              SnapsToDevicePixels="True">

                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>

                            </Grid>
                        </Popup>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="HasItems"
                                 Value="False">

                            <Setter TargetName="Popup"
                                    Property="MinHeight"
                                    Value="24"/>
                        </Trigger>

                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter Property="Opacity"
                                    Value="0.55"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}"
           BasedOn="{StaticResource DmsComboBoxStyle}"/>


    <!-- =========================================================
         LISTBOX
         ========================================================= -->

    <Style TargetType="{x:Type ListBox}">

        <Setter Property="Background"
                Value="{DynamicResource DmsPanelBrush}"/>

        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>

        <Setter Property="BorderBrush"
                Value="{DynamicResource DmsBorderBrush}"/>
    </Style>

    <Style TargetType="{x:Type ListBoxItem}">

        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>

        <Setter Property="Background"
                Value="Transparent"/>

        <Setter Property="Padding"
                Value="4,2"/>

        <Style.Triggers>

            <Trigger Property="IsSelected"
                     Value="True">

                <Setter Property="Background"
                        Value="{DynamicResource DmsAccentBrush}"/>

                <Setter Property="Foreground"
                        Value="{DynamicResource DmsOnAccentBrush}"/>
            </Trigger>

            <Trigger Property="IsMouseOver"
                     Value="True">

                <Setter Property="Background"
                        Value="{DynamicResource DmsBorderBrush}"/>
            </Trigger>

        </Style.Triggers>
    </Style>


    <!-- =========================================================
         STATUS BAR
         ========================================================= -->

    <Style TargetType="{x:Type StatusBar}">

        <Setter Property="Background"
                Value="{DynamicResource DmsPanelBrush}"/>

        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type StatusBarItem}">

        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>
    </Style>


    <!-- =========================================================
         KARTY A NADPISY
         ========================================================= -->

    <Style x:Key="DmsCardBorderStyle"
           TargetType="{x:Type Border}">

        <Setter Property="Background"
                Value="{DynamicResource DmsPanelBrush}"/>

        <Setter Property="BorderBrush"
                Value="{DynamicResource DmsBorderBrush}"/>

        <Setter Property="BorderThickness"
                Value="1"/>

        <Setter Property="CornerRadius"
                Value="8"/>

        <Setter Property="Padding"
                Value="16"/>
    </Style>

    <Style x:Key="DmsTitleTextStyle"
           TargetType="{x:Type TextBlock}">

        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>

        <Setter Property="FontSize"
                Value="24"/>

        <Setter Property="FontWeight"
                Value="Bold"/>

        <Setter Property="Margin"
                Value="0,0,0,16"/>
    </Style>


    <!-- =========================================================
         DATAGRID – IMPLICITNÍ ZÁKLAD
         ========================================================= -->

    <Style TargetType="{x:Type DataGrid}">

        <Setter Property="Background"
                Value="{DynamicResource DmsPanelBrush}"/>

        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>

        <Setter Property="BorderBrush"
                Value="{DynamicResource DmsBorderBrush}"/>

        <Setter Property="RowBackground"
                Value="{DynamicResource DmsPanelBrush}"/>

        <Setter Property="AlternatingRowBackground"
                Value="{DynamicResource DmsBackgroundBrush}"/>

        <Setter Property="HorizontalGridLinesBrush"
                Value="{DynamicResource DmsBorderBrush}"/>

        <Setter Property="VerticalGridLinesBrush"
                Value="{DynamicResource DmsBorderBrush}"/>

        <Setter Property="HeadersVisibility"
                Value="Column"/>

        <Setter Property="GridLinesVisibility"
                Value="Horizontal"/>

        <Setter Property="CanUserResizeColumns"
                Value="True"/>

        <Setter Property="CanUserReorderColumns"
                Value="True"/>

        <Setter Property="CanUserSortColumns"
                Value="True"/>

        <Setter Property="CanUserAddRows"
                Value="False"/>

        <Setter Property="RowHeaderWidth"
                Value="0"/>

        <Setter Property="EnableRowVirtualization"
                Value="True"/>

        <Setter Property="EnableColumnVirtualization"
                Value="True"/>

        <Setter Property="HorizontalScrollBarVisibility"
                Value="Auto"/>

        <Setter Property="VerticalScrollBarVisibility"
                Value="Auto"/>
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="MinWidth" Value="70"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style TargetType="{x:Type DataGridRow}">

        <Setter Property="Background"
                Value="{DynamicResource DmsPanelBrush}"/>

        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>

        <Style.Triggers>

            <Trigger Property="IsMouseOver"
                     Value="True">

                <Setter Property="Background"
                        Value="{DynamicResource DmsBackgroundBrush}"/>
            </Trigger>

            <Trigger Property="IsSelected"
                     Value="True">

                <Setter Property="Background"
                        Value="{DynamicResource DmsAccentBrush}"/>

                <Setter Property="Foreground"
                        Value="{DynamicResource DmsOnAccentBrush}"/>
            </Trigger>

        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGridCell}">

        <Setter Property="Background"
                Value="Transparent"/>

        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>

        <Setter Property="BorderBrush"
                Value="{DynamicResource DmsBorderBrush}"/>

        <Setter Property="BorderThickness"
                Value="0,0,1,1"/>

        <Setter Property="Padding"
                Value="7,3"/>

        <Setter Property="VerticalContentAlignment"
                Value="Center"/>

        <Style.Triggers>

            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource DmsAccentBrush}"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource DmsOnAccentBrush}"/>
            </Trigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background"
                        Value="{DynamicResource DmsAccentBrush}"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource DmsOnAccentBrush}"/>
            </MultiTrigger>

        </Style.Triggers>
    </Style>

    <Style x:Key="DmsDataGridEditingTextBoxStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource {x:Type TextBox}}">

        <Setter Property="Background"
                Value="{DynamicResource DmsBackgroundBrush}"/>

        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>

        <Setter Property="BorderBrush"
                Value="{DynamicResource DmsAccentBrush}"/>

        <Setter Property="CaretBrush"
                Value="{DynamicResource DmsForegroundBrush}"/>

        <Setter Property="SelectionBrush"
                Value="{DynamicResource DmsAccentBrush}"/>

        <Setter Property="SelectionTextBrush"
                Value="{DynamicResource DmsOnAccentBrush}"/>

        <Setter Property="Padding"
                Value="4,2"/>
    </Style>

    <!-- =========================================================
         TABCONTROL
         ========================================================= -->

    <Style TargetType="{x:Type TabControl}">

        <Setter Property="Background"
                Value="{DynamicResource DmsPanelBrush}"/>

        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>

        <Setter Property="BorderBrush"
                Value="{DynamicResource DmsBorderBrush}"/>
    </Style>

    <Style TargetType="{x:Type TabItem}">

        <Setter Property="Foreground"
                Value="{DynamicResource DmsForegroundBrush}"/>

        <Setter Property="Background"
                Value="{DynamicResource DmsBackgroundBrush}"/>

        <Setter Property="BorderBrush"
                Value="{DynamicResource DmsBorderBrush}"/>

        <Setter Property="Padding"
                Value="12,7"/>

        <Setter Property="Margin"
                Value="0,0,2,0"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type TabItem}">

                    <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">

                        <ContentPresenter x:Name="ContentSite"
                                          ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsSelected"
                                 Value="True">

                            <Setter TargetName="TabBorder"
                                    Property="Background"
                                    Value="{DynamicResource DmsPanelBrush}"/>

                            <Setter TargetName="TabBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource DmsAccentBrush}"/>

                            <Setter Property="Foreground"
                                    Value="{DynamicResource DmsForegroundBrush}"/>

                            <Setter Property="FontWeight"
                                    Value="SemiBold"/>
                        </Trigger>

                        <Trigger Property="IsSelected"
                                 Value="False">

                            <Setter TargetName="TabBorder"
                                    Property="Background"
                                    Value="{DynamicResource DmsBackgroundBrush}"/>

                            <Setter Property="Foreground"
                                    Value="{DynamicResource DmsMutedForegroundBrush}"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="TabBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource DmsAccentBrush}"/>

                            <Setter Property="Foreground"
                                    Value="{DynamicResource DmsForegroundBrush}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="TabBorder"
                                    Property="Background"
                                    Value="{DynamicResource DmsBackgroundBrush}"/>

                            <Setter Property="Foreground"
                                    Value="{DynamicResource DmsMutedForegroundBrush}"/>

                            <Setter Property="Opacity"
                                    Value="0.55"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================= -->
    <!-- DMS DataGrid styles                                      -->
    <!-- ========================================================= -->

    <Style x:Key="DmsDataGridColumnHeaderStyle"
       TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DmsDataGridCellStyle"
       TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DmsDataGridRowStyle"
       TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="MinHeight" Value="26"/>
    </Style>

    <Style x:Key="DmsDataGridTextBlockElementStyle"
       TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4,0"/>
    </Style>

    <Style x:Key="DmsDataGridTextBoxEditingStyle"
       TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DmsAccentBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DmsCenteredCheckBoxStyle"
       TargetType="{x:Type CheckBox}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DmsDataGridStyle"
       TargetType="{x:Type DataGrid}">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="CanUserAddRows" Value="True"/>
        <Setter Property="CanUserDeleteRows" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="RowBackground" Value="{DynamicResource DmsPanelBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource DmsBackgroundBrush}"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DmsBorderBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DmsBorderBrush}"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DmsDataGridColumnHeaderStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource DmsDataGridCellStyle}"/>
        <Setter Property="RowStyle" Value="{StaticResource DmsDataGridRowStyle}"/>
    </Style>


    <!-- ============================================================
     EDITOVATELNÉ DATAGRIDY - DMS
     Použití např. QASET, SAPSET a další číselníkové editory
     ============================================================ -->

    <Style x:Key="DmsEditableGridStyle"
       TargetType="{x:Type DataGrid}"
       BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="IsReadOnly" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
    </Style>

    <Style x:Key="DmsEditableGridRowStyle"
       TargetType="{x:Type DataGridRow}"
       BasedOn="{StaticResource DmsDataGridRowStyle}">

        <Style.Triggers>

            <!-- Nový záznam -->
            <DataTrigger Binding="{Binding State}"
                     Value="Added">
                <Setter Property="Background" Value="#263A28"/>
                <Setter Property="ToolTip" Value="Nový záznam"/>
            </DataTrigger>

            <!-- Změněný záznam -->
            <DataTrigger Binding="{Binding State}"
                     Value="Modified">
                <Setter Property="Background" Value="#4A3820"/>
                <Setter Property="ToolTip" Value="Změněný záznam"/>
            </DataTrigger>

            <!-- Záznam označený ke smazání -->
            <DataTrigger Binding="{Binding State}"
                     Value="Deleted">
                <Setter Property="Background" Value="#4A2020"/>
                <Setter Property="Opacity" Value="0.65"/>
                <Setter Property="ToolTip" Value="Záznam označený ke smazání"/>
            </DataTrigger>

        </Style.Triggers>
    </Style>

    <!-- ============================================================
     DMS SELECTOR / LOOKUP FIELD
     Použití: QA02, QASET, SAPSET, další editory
     ============================================================ -->

    <Style x:Key="DmsSelectorButtonStyle"
       TargetType="{x:Type Button}"
       BasedOn="{StaticResource DmsFormButtonStyle}">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Margin" Value="4,4,0,4"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Content" Value="▼"/>
    </Style>

    <Style x:Key="DmsSelectorPopupBorderStyle"
       TargetType="{x:Type Border}">
        <Setter Property="Width" Value="420"/>
        <Setter Property="MaxHeight" Value="320"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style x:Key="DmsSelectorListBoxStyle"
       TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinWidth" Value="400"/>
    </Style>

    <Style x:Key="DmsSettingsComboBoxItemStyle"
       TargetType="{x:Type ComboBoxItem}">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DmsSettingsComboBoxStyle"
       TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="10,0,34,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DmsSettingsComboBoxItemStyle}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  ClickMode="Press"
                                  Background="Transparent"
                                  BorderThickness="0"/>

                        <Border x:Name="MainBorder"
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            IsHitTestVisible="False"/>

                        <ContentPresenter x:Name="ContentSite"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                      Margin="10,0,34,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      IsHitTestVisible="False"
                                      RecognizesAccessKey="True"/>

                        <TextBlock Text="▼"
                               Width="28"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"
                               IsHitTestVisible="False"/>

                        <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                            <Border Background="{DynamicResource DmsPanelBrush}"
                                BorderBrush="{DynamicResource DmsBorderBrush}"
                                BorderThickness="1"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="260"
                                          VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource DmsAccentBrush}"/>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource DmsAccentBrush}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>