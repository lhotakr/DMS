<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Základní barvy DMS FiGUI -->
    <Color x:Key="DmsBlueColor">#0B2A4A</Color>
    <Color x:Key="DmsBackgroundColor">#F4F6F8</Color>
    <Color x:Key="DmsBorderColor">#D0D7DE</Color>

    <SolidColorBrush x:Key="DmsBlueBrush" Color="{StaticResource DmsBlueColor}" />
    <SolidColorBrush x:Key="DmsBackgroundBrush" Color="{StaticResource DmsBackgroundColor}" />
    <SolidColorBrush x:Key="DmsBorderBrush" Color="{StaticResource DmsBorderColor}" />

</ResourceDictionary>