<UserControl x:Class="DMS.Desktop.Views.Articles.ArticleDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsBackgroundBrush}">

    <Grid Background="{DynamicResource DmsBackgroundBrush}">
        <Border Background="{DynamicResource DmsPanelBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- Nadpis -->
                    <TextBlock x:Name="TxtTitle"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,16"/>

                    <!-- Základní data -->
                    <Border Background="{DynamicResource DmsBackgroundBrush}"
                            BorderBrush="{DynamicResource DmsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,18">

                        <StackPanel>
                            <TextBlock Text="Základní data"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"
                                       Margin="0,0,0,10"/>

                            <TextBlock x:Name="TxtBasic"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Dokumenty -->
                    <TextBlock Text="Dokumenty"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,8"/>

                    <DataGrid x:Name="DgvDocuments"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              MinHeight="120"
                              MaxHeight="260"
                              Margin="0,0,0,18"
                              HorizontalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Typ"
                                                Binding="{Binding DocumentTypeCode}"
                                                Width="Auto"
                                                MinWidth="120"/>

                            <DataGridTextColumn Header="Název"
                                                Binding="{Binding Name}"
                                                Width="*"
                                                MinWidth="220"/>

                            <DataGridTextColumn Header="Verze"
                                                Binding="{Binding Version}"
                                                Width="Auto"
                                                MinWidth="80"/>

                            <DataGridTextColumn Header="Stav"
                                                Binding="{Binding Status}"
                                                Width="Auto"
                                                MinWidth="100"/>

                            <DataGridTextColumn Header="Platné od"
                                                Binding="{Binding ValidFrom, StringFormat=dd.MM.yyyy}"
                                                Width="Auto"
                                                MinWidth="110"/>

                            <DataGridTextColumn Header="Cesta"
                                                Binding="{Binding FilePath}"
                                                Width="2*"
                                                MinWidth="320"/>

                            <DataGridTextColumn Header="Poznámka"
                                                Binding="{Binding Note}"
                                                Width="*"
                                                MinWidth="220"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Operace -->
                    <TextBlock Text="Operace"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,8"/>

                    <DataGrid x:Name="DgvOperations"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              MinHeight="120"
                              MaxHeight="280"
                              Margin="0,0,0,18"
                              HorizontalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Operace"
                                                Binding="{Binding OperationNumber}"
                                                Width="Auto"
                                                MinWidth="90"/>

                            <DataGridTextColumn Header="Typ"
                                                Binding="{Binding OperationTypeCode}"
                                                Width="Auto"
                                                MinWidth="80"/>

                            <DataGridTextColumn Header="Skupina strojů"
                                                Binding="{Binding WorkCenterGroupCode}"
                                                Width="Auto"
                                                MinWidth="140"/>

                            <DataGridTextColumn Header="Název"
                                                Binding="{Binding Name}"
                                                Width="*"
                                                MinWidth="240"/>

                            <DataGridTextColumn Header="Norma/směna"
                                                Binding="{Binding ShiftStandardQuantity}"
                                                Width="Auto"
                                                MinWidth="120"/>

                            <DataGridTextColumn Header="Jednotka"
                                                Binding="{Binding ShiftStandardUnit}"
                                                Width="Auto"
                                                MinWidth="100"/>

                            <DataGridTextColumn Header="Odpad %"
                                                Binding="{Binding ExpectedScrapPercent}"
                                                Width="Auto"
                                                MinWidth="90"/>

                            <DataGridTextColumn Header="Odpad ks"
                                                Binding="{Binding ExpectedScrapQuantity}"
                                                Width="Auto"
                                                MinWidth="90"/>

                            <DataGridTextColumn Header="Poznámka"
                                                Binding="{Binding Note}"
                                                Width="2*"
                                                MinWidth="240"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Technologické vazby -->
                    <TextBlock Text="Technologické vazby"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,8"/>

                    <DataGrid x:Name="DgvTechnologyLinks"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              MinHeight="120"
                              MaxHeight="280"
                              Margin="0,0,0,18"
                              HorizontalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Operace"
                                                Binding="{Binding OperationNumber}"
                                                Width="Auto"
                                                MinWidth="90"/>

                            <DataGridTextColumn Header="Typ vazby"
                                                Binding="{Binding LinkType}"
                                                Width="Auto"
                                                MinWidth="130"/>

                            <DataGridTextColumn Header="Podtyp"
                                                Binding="{Binding SubTypeCode}"
                                                Width="Auto"
                                                MinWidth="110"/>

                            <DataGridTextColumn Header="Číslo"
                                                Binding="{Binding ArticleNumber}"
                                                Width="Auto"
                                                MinWidth="130"/>

                            <DataGridTextColumn Header="Popis"
                                                Binding="{Binding Description}"
                                                Width="*"
                                                MinWidth="260"/>

                            <DataGridTextColumn Header="Pořadí"
                                                Binding="{Binding Sequence}"
                                                Width="Auto"
                                                MinWidth="80"/>

                            <DataGridTextColumn Header="Poznámka"
                                                Binding="{Binding Note}"
                                                Width="2*"
                                                MinWidth="240"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Síta -->
                    <TextBlock Text="Síta"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,8"/>

                    <DataGrid x:Name="DgvScreens"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              MinHeight="120"
                              MaxHeight="280"
                              Margin="0,0,0,18"
                              HorizontalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Operace"
                                                Binding="{Binding OperationNumber}"
                                                Width="Auto"
                                                MinWidth="90"/>

                            <DataGridTextColumn Header="Účel"
                                                Binding="{Binding Purpose}"
                                                Width="Auto"
                                                MinWidth="110"/>

                            <DataGridTextColumn Header="Stroj"
                                                Binding="{Binding MachineType}"
                                                Width="Auto"
                                                MinWidth="90"/>

                            <DataGridTextColumn Header="Tkanina"
                                                Binding="{Binding Mesh}"
                                                Width="Auto"
                                                MinWidth="100"/>

                            <DataGridTextColumn Header="Tisk"
                                                Binding="{Binding PrintPass}"
                                                Width="Auto"
                                                MinWidth="70"/>

                            <DataGridTextColumn Header="Číslo síta"
                                                Binding="{Binding ScreenArticleNumber}"
                                                Width="Auto"
                                                MinWidth="130"/>

                            <DataGridTextColumn Header="Poznámka"
                                                Binding="{Binding Note}"
                                                Width="*"
                                                MinWidth="260"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Tok artiklu -->
                    <TextBlock Text="Tok artiklu"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Vstupní / předchozí artikl -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Vstupní / předchozí artikl"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"
                                       Margin="0,0,0,8"/>

                            <DataGrid x:Name="DgvUpstreamArticle"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      MinHeight="140"
                                      MaxHeight="260"
                                      HorizontalAlignment="Stretch"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Artikl"
                                                        Binding="{Binding RelatedArticleNumber}"
                                                        Width="Auto"
                                                        MinWidth="130"/>

                                    <DataGridTextColumn Header="Popis"
                                                        Binding="{Binding RelatedArticleDescription}"
                                                        Width="*"
                                                        MinWidth="220"/>

                                    <DataGridTextColumn Header="Typ vazby"
                                                        Binding="{Binding RelationKind}"
                                                        Width="Auto"
                                                        MinWidth="140"/>

                                    <DataGridTextColumn Header="Operace"
                                                        Binding="{Binding OperationTypeCode}"
                                                        Width="Auto"
                                                        MinWidth="90"/>

                                    <DataGridTextColumn Header="Pořadí"
                                                        Binding="{Binding Sequence}"
                                                        Width="Auto"
                                                        MinWidth="80"/>

                                    <DataGridTextColumn Header="Poznámka"
                                                        Binding="{Binding Note}"
                                                        Width="*"
                                                        MinWidth="220"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <!-- Výstupní / následující artikly -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Výstupní / následující artikly"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"
                                       Margin="0,0,0,8"/>

                            <DataGrid x:Name="DgvDownstreamArticles"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      MinHeight="140"
                                      MaxHeight="260"
                                      HorizontalAlignment="Stretch"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Artikl"
                                                        Binding="{Binding RelatedArticleNumber}"
                                                        Width="Auto"
                                                        MinWidth="130"/>

                                    <DataGridTextColumn Header="Popis"
                                                        Binding="{Binding RelatedArticleDescription}"
                                                        Width="*"
                                                        MinWidth="220"/>

                                    <DataGridTextColumn Header="Typ vazby"
                                                        Binding="{Binding RelationKind}"
                                                        Width="Auto"
                                                        MinWidth="140"/>

                                    <DataGridTextColumn Header="Operace"
                                                        Binding="{Binding OperationTypeCode}"
                                                        Width="Auto"
                                                        MinWidth="90"/>

                                    <DataGridTextColumn Header="Pořadí"
                                                        Binding="{Binding Sequence}"
                                                        Width="Auto"
                                                        MinWidth="80"/>

                                    <DataGridTextColumn Header="Poznámka"
                                                        Binding="{Binding Note}"
                                                        Width="*"
                                                        MinWidth="220"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>