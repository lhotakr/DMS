<UserControl x:Class="DMS.Desktop.Views.Quality.QualityArticleEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DMS.Desktop.UI"
             Background="{DynamicResource DmsPanelBrush}">

    <UserControl.Resources>
        <ui:CzechDateConverter x:Key="CzechDateConverter"/>
    </UserControl.Resources>

    <ScrollViewer x:Name="RootScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly">

        <StackPanel Margin="18">

            <!-- =================================================
                 NADPIS A AKCE
                 ================================================= -->

            <TextBlock Text="QA02 - Změna quality dat"
                       Style="{StaticResource DmsTitleTextStyle}"
                       Margin="0,0,0,14"/>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,14">

                <Button Content="Uložit"
                        Margin="0,0,8,0"
                        Style="{StaticResource DmsPrimaryButtonStyle}"
                        Click="BtnSave_Click"/>

                <Button Content="Zpět na QA03"
                        Margin="0,0,8,0"
                        Style="{StaticResource DmsFormButtonStyle}"
                        Click="BtnBackToQa03_Click"/>

                <Button Content="Obnovit"
                        Style="{StaticResource DmsFormButtonStyle}"
                        Click="BtnReload_Click"/>
            </StackPanel>

            <!-- =================================================
                 VÝBĚR TISKOVÉ VERZE
                 ================================================= -->

            <TextBlock Text="Vybraná tisková verze"
                       Style="{StaticResource DmsFormLabelStyle}"
                       Margin="0,0,0,5"/>

            <Grid Width="620"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtSelectedPrintVersion"
                         Grid.Column="0"
                         Style="{StaticResource DmsReadOnlyTextBoxStyle}"
                         Padding="10,6"
                         Margin="0"/>

                <Button x:Name="BtnOpenPrintVersionSelector"
                        Grid.Column="1"
                        Style="{StaticResource DmsSelectorButtonStyle}"
                        Click="BtnOpenPrintVersionSelector_Click"/>

                <Popup x:Name="PopupPrintVersions"
                       PlacementTarget="{Binding ElementName=TxtSelectedPrintVersion}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True">

                    <Border Style="{StaticResource DmsSelectorPopupBorderStyle}"
                            Width="620"
                            MaxHeight="320">

                        <ListBox x:Name="ListPrintVersions"
                                 Style="{StaticResource DmsSelectorListBoxStyle}"
                                 MinWidth="600"
                                 MouseDoubleClick="ListPrintVersions_MouseDoubleClick"
                                 SelectionChanged="ListPrintVersions_SelectionChanged"/>
                    </Border>
                </Popup>
            </Grid>

            <!-- =================================================
                 INFORMACE O ARTIKLU
                 ================================================= -->

            <TextBlock Text="Informace o artiklu"
                       Style="{StaticResource DmsSectionTitleStyle}"/>

            <Grid Margin="0,0,0,12">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Důležité info"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtImportantInfo"
                         Grid.Row="0"
                         Grid.Column="1"
                         MinHeight="70"
                         Style="{StaticResource DmsMultilineTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Poznámky k artiklu"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtArticleNotes"
                         Grid.Row="1"
                         Grid.Column="1"
                         MinHeight="70"
                         Style="{StaticResource DmsMultilineTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"/>
            </Grid>

            <!-- =================================================
                 TISKOVÁ VERZE
                 ================================================= -->

            <DockPanel Margin="0,10,0,10"
                       LastChildFill="True">

                <Button DockPanel.Dock="Right"
                        Content="Povolit změnu identifikátorů"
                        Margin="12,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource DmsFormButtonStyle}"
                        Click="BtnEnableIdentityEdit_Click"/>

                <TextBlock Text="Tisková verze"
                           Style="{StaticResource DmsSectionTitleStyle}"
                           Margin="0"/>
            </DockPanel>

            <Grid x:Name="PrintVersionForm"
                  Margin="0,0,0,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Identifikátory -->

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Číslo tiskové verze"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtPrintVersion"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,4,16,4"
                         IsReadOnly="True"
                         Style="{StaticResource DmsFormTextBoxStyle}"
                         TextChanged="IdentityField_TextChanged"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="SAP ID"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtSapMaterial"
                         Grid.Row="0"
                         Grid.Column="3"
                         IsReadOnly="True"
                         Style="{StaticResource DmsFormTextBoxStyle}"
                         TextChanged="IdentityField_TextChanged"/>

                <!-- Název / zákazník -->

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Název"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtTitle"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="0,4,16,4"
                         Style="{StaticResource DmsFormTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="Zákazník"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <Grid Grid.Row="1"
                      Grid.Column="3"
                      Margin="0,4,0,4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtCustomer"
                             Grid.Column="0"
                             IsReadOnly="True"
                             Style="{StaticResource DmsReadOnlyTextBoxStyle}"
                             TextChanged="EditableControl_TextChanged"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource DmsSelectorButtonStyle}"
                            Click="BtnOpenCustomerSelector_Click"/>

                    <Popup x:Name="PopupCustomers"
                           PlacementTarget="{Binding ElementName=TxtCustomer}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">

                        <Border Style="{StaticResource DmsSelectorPopupBorderStyle}">
                            <ListBox x:Name="ListCustomers"
                                     Style="{StaticResource DmsSelectorListBoxStyle}"
                                     DisplayMemberPath="Name"
                                     SelectionChanged="ListCustomers_SelectionChanged"/>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Dekorace / barva -->

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Dekorace"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtDecoration"
                         Grid.Row="2"
                         Grid.Column="1"
                         Margin="0,4,16,4"
                         IsReadOnly="True"
                         Style="{StaticResource DmsReadOnlyTextBoxStyle}"
                         ToolTip="Dekorace je převzata ze SAP cache a nelze ji měnit v QA02."/>
                <TextBlock Grid.Row="2"
           Grid.Column="2"
           Text="Barva"
           Style="{StaticResource DmsFormLabelStyle}"/>

                <Grid Grid.Row="2"
      Grid.Column="3"
      Margin="0,4,0,4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtColorType"
             Grid.Column="0"
             IsReadOnly="True"
             Style="{StaticResource DmsReadOnlyTextBoxStyle}"
             TextChanged="EditableControl_TextChanged"
             ToolTip="Lze vybrat více hodnot."/>

                    <Button Grid.Column="1"
            Style="{StaticResource DmsSelectorButtonStyle}"
            Click="BtnOpenColorTypeSelector_Click"/>

                    <Popup x:Name="PopupColorTypes"
           PlacementTarget="{Binding ElementName=TxtColorType}"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True">

                        <Border Style="{StaticResource DmsSelectorPopupBorderStyle}"
                Width="460"
                MaxHeight="380">

                            <DockPanel LastChildFill="True">

                                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0">

                                    <Button Content="Vyčistit"
                            Width="90"
                            Margin="0,0,8,0"
                            Style="{StaticResource DmsFormButtonStyle}"
                            Click="BtnClearColorTypes_Click"/>

                                    <Button Content="Použít"
                            Width="90"
                            Style="{StaticResource DmsPrimaryButtonStyle}"
                            Click="BtnApplyColorTypes_Click"/>
                                </StackPanel>

                                <ListBox x:Name="ListColorTypes"
                         Style="{StaticResource DmsSelectorListBoxStyle}"
                         DisplayMemberPath="Name"
                         SelectionMode="Multiple"
                         MinWidth="430"/>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Úprava skla / HD -->

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Úprava skla"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <Grid Grid.Row="3"
                      Grid.Column="1"
                      Margin="0,4,16,4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtGlassTreatment"
                             Grid.Column="0"
                             IsReadOnly="True"
                             Style="{StaticResource DmsReadOnlyTextBoxStyle}"
                             TextChanged="EditableControl_TextChanged"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource DmsSelectorButtonStyle}"
                            Click="BtnOpenGlassTreatmentSelector_Click"/>

                    <Popup x:Name="PopupGlassTreatments"
                           PlacementTarget="{Binding ElementName=TxtGlassTreatment}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">

                        <Border Style="{StaticResource DmsSelectorPopupBorderStyle}">
                            <ListBox x:Name="ListGlassTreatments"
                                     Style="{StaticResource DmsSelectorListBoxStyle}"
                                     DisplayMemberPath="Name"
                                     SelectionChanged="ListGlassTreatments_SelectionChanged"/>
                        </Border>
                    </Popup>
                </Grid>

                <TextBlock Grid.Row="3"
                           Grid.Column="2"
                           Text="HD číslo"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtHdNumber"
                         Grid.Row="3"
                         Grid.Column="3"
                         Style="{StaticResource DmsFormTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"/>

                <!-- Vzorky / prkno -->

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Umístění vzorků"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtSampleLocation"
                         Grid.Row="4"
                         Grid.Column="1"
                         Margin="0,4,16,4"
                         Style="{StaticResource DmsFormTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"/>

                <TextBlock Grid.Row="4"
                           Grid.Column="2"
                           Text="Umístění prkna"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtBoardLocation"
                         Grid.Row="4"
                         Grid.Column="3"
                         Style="{StaticResource DmsFormTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"/>

                <!-- Měrka / třída kvality -->

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Text="Umístění měrky"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtGaugeLocation"
                         Grid.Row="5"
                         Grid.Column="1"
                         Margin="0,4,16,4"
                         Style="{StaticResource DmsFormTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"/>

                <TextBlock Grid.Row="5"
                           Grid.Column="2"
                           Text="Třída kvality"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <Grid Grid.Row="5"
                      Grid.Column="3"
                      Margin="0,4,0,4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtQualityClass"
                             Grid.Column="0"
                             IsReadOnly="True"
                             Style="{StaticResource DmsReadOnlyTextBoxStyle}"
                             TextChanged="EditableControl_TextChanged"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource DmsSelectorButtonStyle}"
                            Click="BtnOpenQualityClassSelector_Click"/>

                    <Popup x:Name="PopupQualityClasses"
                           PlacementTarget="{Binding ElementName=TxtQualityClass}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">

                        <Border Style="{StaticResource DmsSelectorPopupBorderStyle}">
                            <ListBox x:Name="ListQualityClasses"
                                     Style="{StaticResource DmsSelectorListBoxStyle}"
                                     DisplayMemberPath="Name"
                                     SelectionChanged="ListQualityClasses_SelectionChanged"/>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Příznaky -->

                <StackPanel Grid.Row="6"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,8,0,8">

                    <CheckBox x:Name="ChkHasGauge"
                              Content="Měrka"
                              Margin="0,0,18,0"
                              Checked="EditableControl_Changed"
                              Unchecked="EditableControl_Changed"/>

                    <CheckBox x:Name="ChkComplaint"
                              Content="Reklamace"
                              Margin="0,0,18,0"
                              Checked="EditableControl_Changed"
                              Unchecked="EditableControl_Changed"/>

                    <CheckBox x:Name="ChkSamplesOnCamera"
                              Content="Vzorky na kameru"
                              Checked="EditableControl_Changed"
                              Unchecked="EditableControl_Changed"/>
                </StackPanel>

                <!-- Poznámky -->

                <TextBlock Grid.Row="7"
                           Grid.Column="0"
                           Text="Poznámky"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtPrintVersionNotes"
                         Grid.Row="7"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         MinHeight="90"
                         Style="{StaticResource DmsMultilineTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"/>
            </Grid>

            <!-- =================================================
                 QUALITY ÚKOLY
                 ================================================= -->

            <TextBlock Text="Quality úkoly"
                       Style="{StaticResource DmsSectionTitleStyle}"/>

            <Border x:Name="TaskStatusBorder"
                    Margin="0,0,0,8"
                    Padding="10,7"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="{DynamicResource DmsBackgroundBrush}"
                    BorderBrush="{DynamicResource DmsBorderBrush}">

                <TextBlock x:Name="TxtTaskStatus"
                           Text="Bez úkolů"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
            </Border>

            <DataGrid x:Name="GridTasks"
                      Style="{StaticResource DmsDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      Height="300"
                      MinWidth="900"
                      SelectionUnit="FullRow"
                      PreviewMouseWheel="GridTasks_PreviewMouseWheel"
                      CellEditEnding="GridTasks_CellEditEnding">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Číslo"
                                        Binding="{Binding Number}"
                                        Width="75"
                                        MinWidth="75"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="Úkol"
                                        Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*"
                                        MinWidth="420"/>

                    <DataGridTextColumn Header="Termín"
                                        Width="130"
                                        MinWidth="120">
                        <DataGridTextColumn.Binding>
                            <Binding Path="DueDate"
                                     Converter="{StaticResource CzechDateConverter}"
                                     UpdateSourceTrigger="LostFocus"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>

                    <DataGridCheckBoxColumn Header="Splněno"
                                            Binding="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                            EditingElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                            Width="110"
                                            MinWidth="100"/>

                    <DataGridTextColumn Header="Datum splnění"
                                        Width="155"
                                        MinWidth="145">
                        <DataGridTextColumn.Binding>
                            <Binding Path="CompletedAt"
                                     Converter="{StaticResource CzechDateConverter}"
                                     UpdateSourceTrigger="LostFocus"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>