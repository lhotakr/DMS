<UserControl x:Class="DMS.Desktop.Views.Quality.QualityCockpitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle"
                   Grid.Row="0"
                   Text="QA00 - Quality cockpit"
                   Style="{StaticResource DmsTitleTextStyle}"
                   Margin="0,0,0,8"/>

        <TextBlock x:Name="TxtSummary"
                   Grid.Row="1"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"
                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

        <TabControl Grid.Row="2"
                    Background="{DynamicResource DmsPanelBrush}"
                    Foreground="{DynamicResource DmsForegroundBrush}">

            <TabItem x:Name="TabCacheStatus"
                     Header="Cache status">

                <Grid Margin="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="GridStatus"
                              Grid.Row="0"
                              Style="{StaticResource DmsDataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionUnit="FullRow"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">

                        <DataGrid.Columns>

                            <DataGridTextColumn x:Name="ColArea"
                                                Header="Area"
                                                Binding="{Binding Area}"
                                                Width="220"
                                                MinWidth="180"/>

                            <DataGridTextColumn x:Name="ColCount"
                                                Header="Count"
                                                Binding="{Binding Count}"
                                                Width="120"
                                                MinWidth="90"/>

                            <DataGridTextColumn x:Name="ColFilePath"
                                                Header="File"
                                                Binding="{Binding FilePath}"
                                                Width="*"
                                                MinWidth="520"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1"
                            Margin="0,10,0,0"
                            Padding="10,7"
                            Background="{DynamicResource DmsBackgroundBrush}"
                            BorderBrush="{DynamicResource DmsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">

                        <TextBlock x:Name="TxtImportMessage"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    </Border>

                </Grid>
            </TabItem>

            <TabItem x:Name="TabImportArticles"
                     Header="Import articles">

                <StackPanel Margin="14">

                    <TextBlock x:Name="TxtImportArticlesDescription"
                               Text="Import quality articles from a PowerApps / SharePoint export."
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <Button x:Name="BtnImportArticles"
                            Content="Import article list"
                            Width="240"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DmsPrimaryButtonStyle}"
                            Click="BtnImportArticles_Click"/>

                </StackPanel>
            </TabItem>

            <TabItem x:Name="TabImportPrintVersions"
                     Header="Import print versions">

                <StackPanel Margin="14">

                    <TextBlock x:Name="TxtImportPrintVersionsDescription"
                               Text="Import print versions, notes, tasks and SAP decoration details."
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <Button x:Name="BtnImportPrintVersions"
                            Content="Import print version list"
                            Width="280"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DmsPrimaryButtonStyle}"
                            Click="BtnImportPrintVersions_Click"/>

                </StackPanel>
            </TabItem>

            <TabItem x:Name="TabImportOrders"
                     Header="Import orders">

                <StackPanel Margin="14">

                    <TextBlock x:Name="TxtImportOrdersDescription"
                               Text="Import historical quality orders."
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <Button x:Name="BtnImportOrders"
                            Content="Import orders"
                            Width="220"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DmsPrimaryButtonStyle}"
                            Click="BtnImportOrders_Click"/>

                </StackPanel>
            </TabItem>

            <TabItem x:Name="TabImportCustomers"
                     Header="Import customers">

                <StackPanel Margin="14">

                    <TextBlock x:Name="TxtImportCustomersDescription"
                               Text="Import customer master data from an MS Lists Excel export."
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <Button x:Name="BtnImportCustomers"
                            Content="Import customers"
                            Width="220"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DmsPrimaryButtonStyle}"
                            Click="BtnImportCustomers_Click"/>

                    <Border Margin="0,14,0,0"
                            Padding="10,7"
                            Background="{DynamicResource DmsBackgroundBrush}"
                            BorderBrush="{DynamicResource DmsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">

                        <TextBlock x:Name="TxtCustomersStatus"
                                   Text="Customers have not been imported yet."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

                    </Border>

                </StackPanel>
            </TabItem>

        </TabControl>

    </Grid>
</UserControl>
