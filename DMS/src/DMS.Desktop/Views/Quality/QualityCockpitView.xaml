<UserControl x:Class="DMS.Desktop.Views.Quality.QualityCockpitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- =====================================================
             NADPIS
             ===================================================== -->

        <TextBlock Grid.Row="0"
                   Text="QA00 - Quality cockpit"
                   Style="{StaticResource DmsTitleTextStyle}"
                   Margin="0,0,0,8"/>

        <TextBlock x:Name="TxtSummary"
                   Grid.Row="1"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"
                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

        <!-- =====================================================
             ZÁLOŽKY
             ===================================================== -->

        <TabControl Grid.Row="2"
                    Background="{DynamicResource DmsPanelBrush}"
                    Foreground="{DynamicResource DmsForegroundBrush}">

            <!-- =================================================
                 STAV CACHE
                 ================================================= -->

            <TabItem Header="Stav cache">

                <Grid Margin="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="GridStatus"
                              Grid.Row="0"
                              Style="{StaticResource DmsDataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionUnit="FullRow"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Oblast"
                                                Binding="{Binding Area}"
                                                Width="220"
                                                MinWidth="180"/>

                            <DataGridTextColumn Header="Počet"
                                                Binding="{Binding Count}"
                                                Width="120"
                                                MinWidth="90"/>

                            <DataGridTextColumn Header="Soubor"
                                                Binding="{Binding FilePath}"
                                                Width="*"
                                                MinWidth="520"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1"
                            Margin="0,10,0,0"
                            Padding="10,7"
                            Background="{DynamicResource DmsBackgroundBrush}"
                            BorderBrush="{DynamicResource DmsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">

                        <TextBlock x:Name="TxtImportMessage"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    </Border>

                </Grid>
            </TabItem>

            <!-- =================================================
                 IMPORT ARTIKLŮ
                 ================================================= -->

            <TabItem Header="Import artiklů">

                <StackPanel Margin="14">

                    <TextBlock Text="Import quality artiklů z exportu PowerApps / SharePoint."
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <Button x:Name="BtnImportArticles"
                            Content="Importovat Soupis artiklů"
                            Width="240"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DmsPrimaryButtonStyle}"
                            Click="BtnImportArticles_Click"/>

                </StackPanel>
            </TabItem>

            <!-- =================================================
                 IMPORT TISKOVÝCH VERZÍ
                 ================================================= -->

            <TabItem Header="Import tiskových verzí">

                <StackPanel Margin="14">

                    <TextBlock Text="Import tiskových verzí, poznámek, úkolů a doplnění dekorace ze SAP cache."
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <Button x:Name="BtnImportPrintVersions"
                            Content="Importovat Soupis tiskových verzí"
                            Width="280"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DmsPrimaryButtonStyle}"
                            Click="BtnImportPrintVersions_Click"/>

                </StackPanel>
            </TabItem>

            <!-- =================================================
                 IMPORT ZAKÁZEK
                 ================================================= -->

            <TabItem Header="Import zakázek">

                <StackPanel Margin="14">

                    <TextBlock Text="Import historických quality zakázek."
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <Button x:Name="BtnImportOrders"
                            Content="Importovat zakázky"
                            Width="220"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DmsPrimaryButtonStyle}"
                            Click="BtnImportOrders_Click"/>

                </StackPanel>
            </TabItem>

            <!-- =================================================
                 IMPORT ZÁKAZNÍKŮ
                 ================================================= -->

            <TabItem Header="Import zákazníků">

                <StackPanel Margin="14">

                    <TextBlock Text="Import zákaznického číselníku z Excel exportu MS Lists."
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <Button x:Name="BtnImportCustomers"
                Content="Importovat zákazníky"
                Width="220"
                HorizontalAlignment="Left"
                Style="{StaticResource DmsPrimaryButtonStyle}"
                Click="BtnImportCustomers_Click"/>

                    <Border Margin="0,14,0,0"
                Padding="10,7"
                Background="{DynamicResource DmsBackgroundBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">

                        <TextBlock x:Name="TxtCustomersStatus"
                       Text="Zákazníci zatím nejsou importováni."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

                    </Border>

                </StackPanel>
            </TabItem>

        </TabControl>

    </Grid>
</UserControl>