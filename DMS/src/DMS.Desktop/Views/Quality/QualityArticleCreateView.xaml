<UserControl x:Class="DMS.Desktop.Views.Quality.QualityArticleCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">

    <ScrollViewer x:Name="RootScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly">

        <StackPanel Margin="18">

            <!-- =================================================
                 NADPIS
                 ================================================= -->

            <TextBlock x:Name="TxtTitle" Text="QA01 - Create quality data"
                       Style="{StaticResource DmsTitleTextStyle}"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="TxtSubtitle" Text="Create quality article data and the first print version from the SAP cache."
                       TextWrapping="Wrap"
                       Margin="0,0,0,14"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

            <!-- =================================================
                 SAP VSTUP
                 ================================================= -->

            <TextBlock x:Name="TxtSectionSapMaterial" Text="SAP material"
                       Style="{StaticResource DmsSectionTitleStyle}"/>

            <Grid Width="620"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,14">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="LblSapNumber"
                           Text="SAP number"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtSapInput"
                         Grid.Column="1"
                         Margin="0,4,8,4"
                         Style="{StaticResource DmsFormTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"
                         KeyDown="TxtSapInput_KeyDown"/>

                <Button x:Name="BtnLoadSap"
                        Grid.Column="2"
                        Content="Load"
                        Style="{StaticResource DmsPrimaryButtonStyle}"
                        Click="BtnLoadSap_Click"/>
            </Grid>

            <Border x:Name="DuplicateWarningBorder"
                    Visibility="Collapsed"
                    Margin="0,0,0,14"
                    Padding="12"
                    CornerRadius="8"
                    BorderThickness="1"
                    Background="#4A2020"
                    BorderBrush="#A65A5A">

                <TextBlock x:Name="TxtDuplicateWarning"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Foreground="#FFD8D8"/>
            </Border>

            <!-- =================================================
                 SAP ZÁKLAD
                 ================================================= -->

            <TextBlock x:Name="TxtSectionSapBase" Text="SAP base data"
                       Style="{StaticResource DmsSectionTitleStyle}"/>

            <Grid Margin="0,0,0,12">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           x:Name="LblSapId"
                           Text="SAP ID"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtSapMaterial"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,4,16,4"
                         IsReadOnly="True"
                         Style="{StaticResource DmsReadOnlyTextBoxStyle}"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           x:Name="LblOldNumber"
                           Text="Old number"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtOldMaterialNumber"
                         Grid.Row="0"
                         Grid.Column="3"
                         IsReadOnly="True"
                         Style="{StaticResource DmsReadOnlyTextBoxStyle}"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           x:Name="LblSapTitle"
                           Text="SAP title"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtSapTitle"
                         Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         Margin="0,4,0,4"
                         IsReadOnly="True"
                         Style="{StaticResource DmsReadOnlyTextBoxStyle}"/>
            </Grid>

            <!-- =================================================
                 INFORMACE O ARTIKLU
                 ================================================= -->

            <TextBlock x:Name="TxtSectionArticleInfo" Text="Article information"
                       Style="{StaticResource DmsSectionTitleStyle}"/>

            <Grid Margin="0,0,0,12">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           x:Name="LblImportantInfo"
                           Text="Important info"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtImportantInfo"
                         Grid.Row="0"
                         Grid.Column="1"
                         MinHeight="70"
                         Style="{StaticResource DmsMultilineTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           x:Name="LblArticleNotes"
                           Text="Article notes"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtArticleNotes"
                         Grid.Row="1"
                         Grid.Column="1"
                         MinHeight="70"
                         Style="{StaticResource DmsMultilineTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"/>
            </Grid>

            <!-- =================================================
                 PRVNÍ TISKOVÁ VERZE
                 ================================================= -->

            <TextBlock x:Name="TxtSectionFirstPrintVersion" Text="First print version"
                       Style="{StaticResource DmsSectionTitleStyle}"/>

            <Grid x:Name="PrintVersionForm"
                  Margin="0,0,0,8"
                  IsEnabled="False">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Číslo / název -->

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           x:Name="LblPrintVersionNumber"
                           Text="Print version number"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtPrintVersion"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,4,16,4"
                         Style="{StaticResource DmsFormTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           x:Name="LblPrintVersionTitle"
                           Text="Title"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtPrintVersionTitle"
                         Grid.Row="0"
                         Grid.Column="3"
                         Style="{StaticResource DmsFormTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"/>

                <!-- Zákazník / dekorace -->

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           x:Name="LblCustomer"
                           Text="Customer"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <Grid Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,4,16,4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtCustomer"
                             Grid.Column="0"
                             IsReadOnly="True"
                             Style="{StaticResource DmsReadOnlyTextBoxStyle}"
                             TextChanged="EditableControl_TextChanged"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource DmsSelectorButtonStyle}"
                            Click="BtnOpenCustomerSelector_Click"/>

                    <Popup x:Name="PopupCustomers"
                           PlacementTarget="{Binding ElementName=TxtCustomer}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">

                        <Border Style="{StaticResource DmsSelectorPopupBorderStyle}">
                            <ListBox x:Name="ListCustomers"
                                     Style="{StaticResource DmsSelectorListBoxStyle}"
                                     DisplayMemberPath="Name"
                                     SelectionChanged="ListCustomers_SelectionChanged"/>
                        </Border>
                    </Popup>
                </Grid>

                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           x:Name="LblDecoration"
                           Text="Decoration"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtDecoration"
                         Grid.Row="1"
                         Grid.Column="3"
                         IsReadOnly="True"
                         Style="{StaticResource DmsReadOnlyTextBoxStyle}"
                         ToolTip="Decoration is taken from the SAP cache."/>

                <!-- Barva / úprava skla -->

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           x:Name="LblColorType"
                           Text="Color"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <Grid Grid.Row="2"
                      Grid.Column="1"
                      Margin="0,4,16,4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtColorType"
                             Grid.Column="0"
                             IsReadOnly="True"
                             Style="{StaticResource DmsReadOnlyTextBoxStyle}"
                             TextChanged="EditableControl_TextChanged"
                             ToolTip="Multiple values can be selected."/>

                    <Button Grid.Column="1"
                            Style="{StaticResource DmsSelectorButtonStyle}"
                            Click="BtnOpenColorTypeSelector_Click"/>

                    <Popup x:Name="PopupColorTypes"
                           PlacementTarget="{Binding ElementName=TxtColorType}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">

                        <Border Style="{StaticResource DmsSelectorPopupBorderStyle}"
                                Width="460"
                                MaxHeight="380">

                            <DockPanel LastChildFill="True">

                                <StackPanel DockPanel.Dock="Bottom"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,8,0,0">

                                    <Button x:Name="BtnClearColorTypes"
                                            Content="Clear"
                                            Width="90"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource DmsFormButtonStyle}"
                                            Click="BtnClearColorTypes_Click"/>

                                    <Button x:Name="BtnApplyColorTypes"
                                            Content="Apply"
                                            Width="90"
                                            Style="{StaticResource DmsPrimaryButtonStyle}"
                                            Click="BtnApplyColorTypes_Click"/>
                                </StackPanel>

                                <ListBox x:Name="ListColorTypes"
                                         Style="{StaticResource DmsSelectorListBoxStyle}"
                                         DisplayMemberPath="Name"
                                         SelectionMode="Multiple"
                                         MinWidth="430"/>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>

                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           x:Name="LblGlassTreatment"
                           Text="Glass treatment"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <Grid Grid.Row="2"
                      Grid.Column="3"
                      Margin="0,4,0,4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtGlassTreatment"
                             Grid.Column="0"
                             IsReadOnly="True"
                             Style="{StaticResource DmsReadOnlyTextBoxStyle}"
                             TextChanged="EditableControl_TextChanged"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource DmsSelectorButtonStyle}"
                            Click="BtnOpenGlassTreatmentSelector_Click"/>

                    <Popup x:Name="PopupGlassTreatments"
                           PlacementTarget="{Binding ElementName=TxtGlassTreatment}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">

                        <Border Style="{StaticResource DmsSelectorPopupBorderStyle}">
                            <ListBox x:Name="ListGlassTreatments"
                                     Style="{StaticResource DmsSelectorListBoxStyle}"
                                     DisplayMemberPath="Name"
                                     SelectionChanged="ListGlassTreatments_SelectionChanged"/>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Třída / HD -->

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           x:Name="LblQualityClass"
                           Text="Quality class"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <Grid Grid.Row="3"
                      Grid.Column="1"
                      Margin="0,4,16,4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtQualityClass"
                             Grid.Column="0"
                             IsReadOnly="True"
                             Style="{StaticResource DmsReadOnlyTextBoxStyle}"
                             TextChanged="EditableControl_TextChanged"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource DmsSelectorButtonStyle}"
                            Click="BtnOpenQualityClassSelector_Click"/>

                    <Popup x:Name="PopupQualityClasses"
                           PlacementTarget="{Binding ElementName=TxtQualityClass}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">

                        <Border Style="{StaticResource DmsSelectorPopupBorderStyle}">
                            <ListBox x:Name="ListQualityClasses"
                                     Style="{StaticResource DmsSelectorListBoxStyle}"
                                     DisplayMemberPath="Name"
                                     SelectionChanged="ListQualityClasses_SelectionChanged"/>
                        </Border>
                    </Popup>
                </Grid>

                <TextBlock Grid.Row="3"
                           Grid.Column="2"
                           x:Name="LblHdNumber"
                           Text="HD number"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtHdNumber"
                         Grid.Row="3"
                         Grid.Column="3"
                         Style="{StaticResource DmsFormTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"/>

                <!-- Lokace -->

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           x:Name="LblSampleLocation"
                           Text="Sample location"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtSampleLocation"
                         Grid.Row="4"
                         Grid.Column="1"
                         Margin="0,4,16,4"
                         Style="{StaticResource DmsFormTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"/>

                <TextBlock Grid.Row="4"
                           Grid.Column="2"
                           x:Name="LblBoardLocation"
                           Text="Board location"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtBoardLocation"
                         Grid.Row="4"
                         Grid.Column="3"
                         Style="{StaticResource DmsFormTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"/>

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           x:Name="LblGaugeLocation"
                           Text="Gauge location"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtGaugeLocation"
                         Grid.Row="5"
                         Grid.Column="1"
                         Margin="0,4,16,4"
                         Style="{StaticResource DmsFormTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"/>

                <!-- Příznaky -->

                <StackPanel Grid.Row="5"
                            Grid.Column="2"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,8,0,8">

                    <CheckBox x:Name="ChkHasGauge"
                              Content="Gauge"
                              Margin="0,0,18,0"
                              Checked="EditableControl_Changed"
                              Unchecked="EditableControl_Changed"/>

                    <CheckBox x:Name="ChkComplaint"
                              Content="Complaint"
                              Margin="0,0,18,0"
                              Checked="EditableControl_Changed"
                              Unchecked="EditableControl_Changed"/>

                    <CheckBox x:Name="ChkSamplesOnCamera"
                              Content="Samples on camera"
                              Checked="EditableControl_Changed"
                              Unchecked="EditableControl_Changed"/>
                </StackPanel>

                <!-- Poznámky -->

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           x:Name="LblPrintVersionNotes"
                           Text="Notes"
                           Style="{StaticResource DmsFormLabelStyle}"/>

                <TextBox x:Name="TxtPrintVersionNotes"
                         Grid.Row="6"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         MinHeight="90"
                         Style="{StaticResource DmsMultilineTextBoxStyle}"
                         TextChanged="EditableControl_TextChanged"/>
            </Grid>

            <!-- =================================================
                 AKCE
                 ================================================= -->

            <StackPanel Orientation="Horizontal"
                        Margin="0,12,0,0">

                <Button x:Name="BtnCreate"
                        Content="Create quality data"
                        IsEnabled="False"
                        Margin="0,0,8,0"
                        Style="{StaticResource DmsPrimaryButtonStyle}"
                        Click="BtnCreate_Click"/>

                <Button x:Name="BtnClear"
                        Content="Clear"
                        Style="{StaticResource DmsFormButtonStyle}"
                        Click="BtnClear_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>