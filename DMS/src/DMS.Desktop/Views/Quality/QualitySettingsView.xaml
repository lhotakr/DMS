<UserControl x:Class="DMS.Desktop.Views.Quality.QualitySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsBackgroundBrush}">

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle"
                   Grid.Row="0"
                   Text="QASET - Quality settings"
                   Style="{StaticResource DmsTitleTextStyle}"
                   Margin="0,0,0,8"/>

        <TextBlock x:Name="TxtSubtitle"
                   Grid.Row="1"
                   Text="Manage quality master data and lookup values. New rows are green, modified rows are orange and rows marked for deletion are red."
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"
                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

        <TabControl x:Name="TabsSettings"
                    Grid.Row="2">

            <TabItem x:Name="TabCustomers"
                     Header="Customers">
                <DockPanel Margin="12">

                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <Button x:Name="BtnAddCustomer"
                                Content="Add"
                                Width="90"
                                Margin="0,0,8,0"
                                Style="{StaticResource DmsFormButtonStyle}"
                                Click="BtnAddCustomer_Click"/>

                        <Button x:Name="BtnDeleteCustomer"
                                Content="Delete"
                                Width="90"
                                Margin="0,0,8,0"
                                Style="{StaticResource DmsFormButtonStyle}"
                                Click="BtnDeleteCustomer_Click"/>

                        <Button x:Name="BtnSaveCustomers"
                                Content="Save"
                                Width="90"
                                Margin="0,0,8,0"
                                Style="{StaticResource DmsPrimaryButtonStyle}"
                                Click="BtnSaveCustomers_Click"/>

                        <Button x:Name="BtnReloadCustomers"
                                Content="Reload"
                                Width="90"
                                Style="{StaticResource DmsFormButtonStyle}"
                                Click="BtnReload_Click"/>

                    </StackPanel>

                    <DataGrid x:Name="GridCustomers"
                              Style="{StaticResource DmsEditableGridStyle}"
                              RowStyle="{StaticResource DmsEditableGridRowStyle}"
                              AutoGenerateColumns="False"
                              CellEditEnding="GridCustomers_CellEditEnding">

                        <DataGrid.Columns>

                            <DataGridTextColumn x:Name="ColCustomerName"
                                                Header="Name"
                                                Binding="{Binding Item.Name, UpdateSourceTrigger=PropertyChanged}"
                                                Width="320"
                                                MinWidth="220"/>

                            <DataGridCheckBoxColumn x:Name="ColCustomerActive"
                                                    Header="Active"
                                                    Binding="{Binding Item.IsActive, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    EditingElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    Width="90"
                                                    MinWidth="80"/>

                            <DataGridCheckBoxColumn x:Name="ColCustomerLoreal"
                                                    Header="L'Oréal"
                                                    Binding="{Binding Item.IsLoreal, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    EditingElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    Width="90"
                                                    MinWidth="80"/>

                            <DataGridTextColumn x:Name="ColCustomerSourceId"
                                                Header="Source ID"
                                                Binding="{Binding Item.SourceId}"
                                                Width="100"
                                                MinWidth="90"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn x:Name="ColCustomerJsonCode"
                                                Header="JSON Code"
                                                Binding="{Binding Item.Code, UpdateSourceTrigger=PropertyChanged}"
                                                Width="120"
                                                MinWidth="100"/>

                        </DataGrid.Columns>
                    </DataGrid>

                </DockPanel>
            </TabItem>

            <TabItem x:Name="TabColorTypes"
                     Header="Color types">
                <DockPanel Margin="12">

                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <Button x:Name="BtnAddColorType"
                                Content="Add"
                                Width="90"
                                Margin="0,0,8,0"
                                Style="{StaticResource DmsFormButtonStyle}"
                                Click="BtnAddColorType_Click"/>

                        <Button x:Name="BtnDeleteColorType"
                                Content="Delete"
                                Width="90"
                                Margin="0,0,8,0"
                                Style="{StaticResource DmsFormButtonStyle}"
                                Click="BtnDeleteColorType_Click"/>

                        <Button x:Name="BtnSaveColorTypes"
                                Content="Save"
                                Width="90"
                                Margin="0,0,8,0"
                                Style="{StaticResource DmsPrimaryButtonStyle}"
                                Click="BtnSaveColorTypes_Click"/>

                        <Button x:Name="BtnReloadColorTypes"
                                Content="Reload"
                                Width="90"
                                Style="{StaticResource DmsFormButtonStyle}"
                                Click="BtnReload_Click"/>

                    </StackPanel>

                    <DataGrid x:Name="GridColorTypes"
                              Style="{StaticResource DmsEditableGridStyle}"
                              RowStyle="{StaticResource DmsEditableGridRowStyle}"
                              AutoGenerateColumns="False"
                              CellEditEnding="GridLookup_CellEditEnding">

                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColColorCode" Header="Code" Binding="{Binding Item.Code, UpdateSourceTrigger=PropertyChanged}" Width="130" MinWidth="100"/>
                            <DataGridTextColumn x:Name="ColColorName" Header="Name" Binding="{Binding Item.Name, UpdateSourceTrigger=PropertyChanged}" Width="280" MinWidth="180"/>
                            <DataGridCheckBoxColumn x:Name="ColColorActive" Header="Active" Binding="{Binding Item.IsActive, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource DmsCenteredCheckBoxStyle}" EditingElementStyle="{StaticResource DmsCenteredCheckBoxStyle}" Width="90" MinWidth="80"/>
                            <DataGridTextColumn x:Name="ColColorSortOrder" Header="Sort order" Binding="{Binding Item.SortOrder, UpdateSourceTrigger=PropertyChanged}" Width="90" MinWidth="80"/>
                            <DataGridTextColumn x:Name="ColColorNotes" Header="Notes" Binding="{Binding Item.Notes, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="300"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </DockPanel>
            </TabItem>

            <TabItem x:Name="TabGlassTreatments"
                     Header="Glass treatments">
                <DockPanel Margin="12">

                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <Button x:Name="BtnAddGlassTreatment" Content="Add" Width="90" Margin="0,0,8,0" Style="{StaticResource DmsFormButtonStyle}" Click="BtnAddGlassTreatment_Click"/>
                        <Button x:Name="BtnDeleteGlassTreatment" Content="Delete" Width="90" Margin="0,0,8,0" Style="{StaticResource DmsFormButtonStyle}" Click="BtnDeleteGlassTreatment_Click"/>
                        <Button x:Name="BtnSaveGlassTreatments" Content="Save" Width="90" Margin="0,0,8,0" Style="{StaticResource DmsPrimaryButtonStyle}" Click="BtnSaveGlassTreatments_Click"/>
                        <Button x:Name="BtnReloadGlassTreatments" Content="Reload" Width="90" Style="{StaticResource DmsFormButtonStyle}" Click="BtnReload_Click"/>

                    </StackPanel>

                    <DataGrid x:Name="GridGlassTreatments"
                              Style="{StaticResource DmsEditableGridStyle}"
                              RowStyle="{StaticResource DmsEditableGridRowStyle}"
                              AutoGenerateColumns="False"
                              CellEditEnding="GridLookup_CellEditEnding">

                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColGlassCode" Header="Code" Binding="{Binding Item.Code, UpdateSourceTrigger=PropertyChanged}" Width="130" MinWidth="100"/>
                            <DataGridTextColumn x:Name="ColGlassName" Header="Name" Binding="{Binding Item.Name, UpdateSourceTrigger=PropertyChanged}" Width="280" MinWidth="180"/>
                            <DataGridCheckBoxColumn x:Name="ColGlassActive" Header="Active" Binding="{Binding Item.IsActive, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource DmsCenteredCheckBoxStyle}" EditingElementStyle="{StaticResource DmsCenteredCheckBoxStyle}" Width="90" MinWidth="80"/>
                            <DataGridTextColumn x:Name="ColGlassSortOrder" Header="Sort order" Binding="{Binding Item.SortOrder, UpdateSourceTrigger=PropertyChanged}" Width="90" MinWidth="80"/>
                            <DataGridTextColumn x:Name="ColGlassNotes" Header="Notes" Binding="{Binding Item.Notes, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="300"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </DockPanel>
            </TabItem>

            <TabItem x:Name="TabQualityClasses"
                     Header="Quality classes">
                <DockPanel Margin="12">

                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <Button x:Name="BtnAddQualityClass" Content="Add" Width="90" Margin="0,0,8,0" Style="{StaticResource DmsFormButtonStyle}" Click="BtnAddQualityClass_Click"/>
                        <Button x:Name="BtnDeleteQualityClass" Content="Delete" Width="90" Margin="0,0,8,0" Style="{StaticResource DmsFormButtonStyle}" Click="BtnDeleteQualityClass_Click"/>
                        <Button x:Name="BtnSaveQualityClasses" Content="Save" Width="90" Margin="0,0,8,0" Style="{StaticResource DmsPrimaryButtonStyle}" Click="BtnSaveQualityClasses_Click"/>
                        <Button x:Name="BtnReloadQualityClasses" Content="Reload" Width="90" Style="{StaticResource DmsFormButtonStyle}" Click="BtnReload_Click"/>

                    </StackPanel>

                    <DataGrid x:Name="GridQualityClasses"
                              Style="{StaticResource DmsEditableGridStyle}"
                              RowStyle="{StaticResource DmsEditableGridRowStyle}"
                              AutoGenerateColumns="False"
                              CellEditEnding="GridLookup_CellEditEnding">

                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColClassCode" Header="Code" Binding="{Binding Item.Code, UpdateSourceTrigger=PropertyChanged}" Width="130" MinWidth="100"/>
                            <DataGridTextColumn x:Name="ColClassName" Header="Name" Binding="{Binding Item.Name, UpdateSourceTrigger=PropertyChanged}" Width="280" MinWidth="180"/>
                            <DataGridCheckBoxColumn x:Name="ColClassActive" Header="Active" Binding="{Binding Item.IsActive, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource DmsCenteredCheckBoxStyle}" EditingElementStyle="{StaticResource DmsCenteredCheckBoxStyle}" Width="90" MinWidth="80"/>
                            <DataGridTextColumn x:Name="ColClassSortOrder" Header="Sort order" Binding="{Binding Item.SortOrder, UpdateSourceTrigger=PropertyChanged}" Width="90" MinWidth="80"/>
                            <DataGridTextColumn x:Name="ColClassNotes" Header="Notes" Binding="{Binding Item.Notes, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="300"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </DockPanel>
            </TabItem>

            <TabItem x:Name="TabPaths"
                     Header="Paths">
                <Border Style="{StaticResource DmsCardBorderStyle}"
                        Margin="12">
                    <TextBlock x:Name="TxtPaths"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                </Border>
            </TabItem>

        </TabControl>

        <TextBlock x:Name="TxtStatus"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

    </Grid>
</UserControl>
