<UserControl x:Class="DMS.Desktop.Views.Documents.ArticleDocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hlavička -->
        <TextBlock x:Name="TxtTitle"
                   Grid.Row="0"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,14"
                   Foreground="{DynamicResource DmsForegroundBrush}"/>

        <!-- Popisek složky -->
        <TextBlock Grid.Row="1"
                   Text="Složka dokumentů"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6"
                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

        <!-- Cesta složky -->
        <TextBox x:Name="TxtFolder"
                 Grid.Row="2"
                 IsReadOnly="True"
                 Margin="0,0,0,16"
                 Padding="10,6"
                 Background="{DynamicResource DmsBackgroundBrush}"
                 Foreground="{DynamicResource DmsForegroundBrush}"
                 BorderBrush="{DynamicResource DmsBorderBrush}"/>

        <!-- Dokumenty -->
        <DataGrid x:Name="DgvDocuments"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  MinHeight="260"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource DmsBackgroundBrush}"
                  Foreground="{DynamicResource DmsForegroundBrush}"
                  BorderBrush="{DynamicResource DmsBorderBrush}"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  ClipboardCopyMode="IncludeHeader"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  MouseDoubleClick="DgvDocuments_MouseDoubleClick">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                </Style>

                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,3"/>
                    <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Soubor"
                                    Binding="{Binding FileName}"
                                    Width="280"
                                    MinWidth="220"/>

                <DataGridTextColumn Header="Druh"
                                    Binding="{Binding DocumentKind}"
                                    Width="180"
                                    MinWidth="130"/>

                <DataGridTextColumn Header="Typ"
                                    Binding="{Binding Extension}"
                                    Width="80"
                                    MinWidth="70"/>

                <DataGridTextColumn Header="Velikost"
                                    Binding="{Binding SizeText}"
                                    Width="110"
                                    MinWidth="90"/>

                <DataGridTextColumn Header="Změněno"
                                    Binding="{Binding LastModified, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                    Width="170"
                                    MinWidth="150"/>

                <DataGridTextColumn Header="Cesta"
                                    Binding="{Binding FilePath}"
                                    Width="*"
                                    MinWidth="400"/>

                <DataGridTemplateColumn Header="Akce"
                                        Width="90"
                                        MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Otevřít"
                                    Padding="8,2"
                                    Tag="{Binding FilePath}"
                                    Click="BtnOpenDocument_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>