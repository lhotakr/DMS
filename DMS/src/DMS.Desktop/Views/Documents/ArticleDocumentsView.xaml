<UserControl x:Class="DMS.Desktop.Views.Documents.ArticleDocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsBackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="DmsDataGridTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource DmsBackgroundBrush}">
        <Border Background="{DynamicResource DmsPanelBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Nadpis -->
                <TextBlock x:Name="TxtTitle"
                           Grid.Row="0"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"
                           Margin="0,0,0,12"/>

                <!-- Popisek cesty -->
                <TextBlock Text="Složka dokumentů"
                           Grid.Row="1"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DmsMutedForegroundBrush}"
                           Margin="0,0,0,4"/>

                <!-- Cesta ke složce -->
                <Border Grid.Row="2"
                        Background="{DynamicResource DmsBackgroundBrush}"
                        BorderBrush="{DynamicResource DmsBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,0,0,16">

                    <TextBlock x:Name="TxtFolder"
                               FontSize="13"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Tabulka -->
                <DataGrid x:Name="DgvDocuments"
                          Grid.Row="3"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternationCount="2"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          MinHeight="260"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          MouseDoubleClick="DgvDocuments_MouseDoubleClick">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header=""
                                            Binding="{Binding IconText}"
                                            Width="55"
                                            ElementStyle="{StaticResource DmsDataGridTextStyle}"/>

                        <DataGridTextColumn Header="Soubor"
                                            Binding="{Binding FileName}"
                                            ElementStyle="{StaticResource DmsDataGridTextStyle}"
                                            Width="*"
                                            MinWidth="260"/>

                        <DataGridTextColumn Header="Druh"
                                            Binding="{Binding DocumentKind}"
                                            ElementStyle="{StaticResource DmsDataGridTextStyle}"
                                            Width="160"/>

                        <DataGridTextColumn Header="Typ"
                                            Binding="{Binding Extension}"
                                            ElementStyle="{StaticResource DmsDataGridTextStyle}"
                                            Width="80"/>

                        <DataGridTextColumn Header="Velikost"
                                            Binding="{Binding SizeText}"
                                            ElementStyle="{StaticResource DmsDataGridTextStyle}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Změněno"
                                            Binding="{Binding LastModifiedText}"
                                            ElementStyle="{StaticResource DmsDataGridTextStyle}"
                                            Width="150"/>

                        <DataGridTemplateColumn Header="Akce"
                                                Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Otevřít"
                                            Tag="{Binding FilePath}"
                                            Width="90"
                                            Height="28"
                                            HorizontalAlignment="Center"
                                            Background="{DynamicResource DmsAccentBrush}"
                                            Foreground="{DynamicResource DmsOnAccentBrush}"
                                            BorderBrush="{DynamicResource DmsAccentBrush}"
                                            Click="BtnOpenDocument_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>