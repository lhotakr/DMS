<UserControl x:Class="DMS.Desktop.Views.Documents.ArticleDocumentCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1120">

    <UserControl.Resources>
        <Style x:Key="Doc01DataGridColumnHeaderStyle"
               TargetType="{x:Type DataGridColumnHeader}"
               BasedOn="{StaticResource DmsDataGridColumnHeaderStyle}">
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,24">

            <Border Style="{StaticResource DmsCardBorderStyle}"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="TxtTitle"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,6"/>

                    <TextBlock x:Name="TxtSummary"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"
                               Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtFolderLabel"
                                   Grid.Column="0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>

                        <TextBlock x:Name="TxtFolder"
                                   Grid.Column="1"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtIndexLabel"
                                   Grid.Column="0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>

                        <TextBlock x:Name="TxtIndexPath"
                                   Grid.Column="1"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnCreate"
                                Style="{StaticResource DmsPrimaryButtonStyle}"
                                MinWidth="190"
                                Margin="0,0,8,0"
                                Click="BtnCreate_Click"/>

                        <Button x:Name="BtnOpenDoc02"
                                MinWidth="130"
                                Margin="0,0,8,0"
                                Click="BtnOpenDoc02_Click"/>

                        <Button x:Name="BtnOpenDoc03"
                                MinWidth="130"
                                Margin="0,0,8,0"
                                Click="BtnOpenDoc03_Click"/>

                        <Button x:Name="BtnOpenTec03"
                                MinWidth="130"
                                Margin="0,0,8,0"
                                Click="BtnOpenTec03_Click"/>

                        <Button x:Name="BtnRefresh"
                                MinWidth="120"
                                Click="BtnRefresh_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DmsCardBorderStyle}"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="TxtSapTitle"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock x:Name="TxtFieldMaterialNumberLabel" FontWeight="SemiBold" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                            <TextBlock x:Name="TxtFieldMaterialNumber" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource DmsForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                            <TextBlock x:Name="TxtFieldOldNumberLabel" FontWeight="SemiBold" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                            <TextBlock x:Name="TxtFieldOldNumber" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource DmsForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock x:Name="TxtFieldStatusLabel" FontWeight="SemiBold" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                            <TextBlock x:Name="TxtFieldStatus" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource DmsForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock x:Name="TxtFieldKindLabel" FontWeight="SemiBold" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                            <TextBlock x:Name="TxtFieldKind" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource DmsForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock x:Name="TxtFieldImportedAtLabel" FontWeight="SemiBold" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                            <TextBlock x:Name="TxtFieldImportedAt" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource DmsForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,0">
                            <TextBlock x:Name="TxtFieldDescriptionLabel" FontWeight="SemiBold" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                            <TextBlock x:Name="TxtFieldDescription" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource DmsForegroundBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DmsCardBorderStyle}"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="TxtDocumentStateTitle"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="TxtStatus"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"
                               Margin="0,0,0,10"/>

                    <Border x:Name="EmptyDocumentsPanel"
                            Padding="16"
                            Margin="0,4,0,0"
                            CornerRadius="8"
                            BorderThickness="1"
                            Background="{DynamicResource DmsBackgroundBrush}"
                            BorderBrush="{DynamicResource DmsBorderBrush}">
                        <StackPanel>
                            <TextBlock x:Name="TxtEmptyDocumentsTitle"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                            <TextBlock x:Name="TxtEmptyDocumentsBody"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="DgvExistingFiles"
                              Style="{StaticResource DmsDataGridStyle}"
                              RowStyle="{StaticResource DmsDataGridRowStyle}"
                              ColumnHeaderStyle="{StaticResource Doc01DataGridColumnHeaderStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeColumns="True"
                              CanUserReorderColumns="True"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              Visibility="Collapsed"
                              MinHeight="150"
                              MaxHeight="280"
                              Margin="0,4,0,0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ClipboardCopyMode="IncludeHeader"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColFileName"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding StoredFileName}"
                                                Width="300"
                                                MinWidth="220"/>
                            <DataGridTextColumn x:Name="ColKind"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding DocumentKind}"
                                                Width="170"
                                                MinWidth="140"/>
                            <DataGridTextColumn x:Name="ColSize"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding SizeText}"
                                                Width="100"
                                                MinWidth="90"/>
                            <DataGridTextColumn x:Name="ColUploadedBy"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding UploadedBy}"
                                                Width="155"
                                                MinWidth="130"/>
                            <DataGridTextColumn x:Name="ColUploadedAt"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding UploadedAtText}"
                                                Width="165"
                                                MinWidth="150"/>
                            <DataGridTextColumn x:Name="ColChangedBy"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding ChangedBy}"
                                                Width="155"
                                                MinWidth="130"/>
                            <DataGridTextColumn x:Name="ColChangedAt"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding ChangedAtText}"
                                                Width="165"
                                                MinWidth="150"/>
                            <DataGridTextColumn x:Name="ColFullPath"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding FullPath}"
                                                Width="420"
                                                MinWidth="280"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
