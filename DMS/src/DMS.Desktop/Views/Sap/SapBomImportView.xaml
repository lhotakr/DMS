<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DMS.Desktop.Views.Sap.SapBomImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">

    <UserControl.Resources>
        <Style x:Key="MappingTextCellStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        </Style>

        <Style x:Key="MappingCheckBoxCellStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitle" Text="BOM import"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>

            <TextBlock x:Name="TxtSubtitle" Text="Import SE16N exports of MAST, STKO, STAS and STPO into the local DMS cache. Alternative BOMs are split by STAS."
                       Margin="0,6,0,0"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Padding="14"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                Background="{DynamicResource DmsBackgroundBrush}"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="LblMast" Grid.Row="0" Grid.Column="0"
                           Text="MAST:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>

                <TextBox x:Name="TxtMastFile"
                         Grid.Row="0" Grid.Column="1"
                         Margin="0,0,8,8"
                         Background="{DynamicResource DmsPanelBrush}"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         BorderBrush="{DynamicResource DmsBorderBrush}"/>

                <Button x:Name="BtnSelectMast" Grid.Row="0" Grid.Column="2"
                        Content="Browse..."
                        Margin="0,0,0,8"
                        Click="BtnSelectMast_Click"/>

                <TextBlock x:Name="LblStko" Grid.Row="1" Grid.Column="0"
                           Text="STKO:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>

                <TextBox x:Name="TxtStkoFile"
                         Grid.Row="1" Grid.Column="1"
                         Margin="0,0,8,8"
                         Background="{DynamicResource DmsPanelBrush}"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         BorderBrush="{DynamicResource DmsBorderBrush}"/>

                <Button x:Name="BtnSelectStko" Grid.Row="1" Grid.Column="2"
                        Content="Browse..."
                        Margin="0,0,0,8"
                        Click="BtnSelectStko_Click"/>

                <TextBlock x:Name="LblStas" Grid.Row="2" Grid.Column="0"
                           Text="STAS:"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>

                <TextBox x:Name="TxtStasFile"
                         Grid.Row="2" Grid.Column="1"
                         IsReadOnly="True"
                         Margin="0,0,8,8"
                         Background="{DynamicResource DmsPanelBrush}"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         BorderBrush="{DynamicResource DmsBorderBrush}"/>

                <Button x:Name="BtnSelectStas" Grid.Row="2" Grid.Column="2"
                        Content="Browse STAS"
                        Click="BtnSelectStas_Click"
                        Margin="0,0,0,8"
                        Padding="12,6"/>

                <TextBlock x:Name="LblStpo" Grid.Row="3" Grid.Column="0"
                           Text="STPO:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>

                <TextBox x:Name="TxtStpoFile"
                         Grid.Row="3" Grid.Column="1"
                         Margin="0,0,8,8"
                         Background="{DynamicResource DmsPanelBrush}"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         BorderBrush="{DynamicResource DmsBorderBrush}"/>

                <Button x:Name="BtnSelectStpo" Grid.Row="3" Grid.Column="2"
                        Content="Browse..."
                        Margin="0,0,0,8"
                        Click="BtnSelectStpo_Click"/>

                <StackPanel Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            Margin="0,8,0,0">

                    <Button x:Name="BtnImport" Content="Import BOMs"
                            Width="180"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="BtnImport_Click"/>

                    <Button x:Name="BtnLoadCache" Content="Load latest cache"
                            Width="170"
                            Height="34"
                            Click="BtnLoadCache_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Mapování sloupců -->
        <Expander x:Name="ExpColumnMapping" Grid.Row="2"
          Header="Required export columns for MAST / STKO / STAS / STPO"
          IsExpanded="False"
          Margin="0,0,0,16"
          Foreground="{DynamicResource DmsForegroundBrush}"
          Background="{DynamicResource DmsBackgroundBrush}"
          HorizontalAlignment="Stretch">

            <Border BorderBrush="{DynamicResource DmsBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource DmsBackgroundBrush}"
            Padding="0">

                <DataGrid x:Name="DgvColumnMapping"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{DynamicResource DmsBackgroundBrush}"
                  Foreground="{DynamicResource DmsForegroundBrush}"
                  BorderBrush="{DynamicResource DmsBorderBrush}"
                  HorizontalAlignment="Stretch"
                  MaxHeight="260"
                  MinHeight="160"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  MinRowHeight="30">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <DataGridTemplateColumn x:Name="ColMappingTable" Header="Table" Width="90" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TableName}"
                                       TextWrapping="Wrap"
                                       Padding="6,4"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="ColMappingColumn" Header="Column" Width="110" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ColumnName}"
                                       TextWrapping="Wrap"
                                       Padding="6,4"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="ColMappingRequired" Header="Required" Width="90" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsRequired}"
                                      IsHitTestVisible="False"
                                      Focusable="False"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="ColMappingSapMeaning" Header="SAP meaning" Width="260" MinWidth="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SapMeaning}"
                                       TextWrapping="Wrap"
                                       Padding="6,4"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="ColMappingDmsMeaning" Header="DMS meaning" Width="*" MinWidth="500">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DmsMeaning}"
                                       TextWrapping="Wrap"
                                       Padding="6,4"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Expander>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="10"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    Background="{DynamicResource DmsBackgroundBrush}"
                    Margin="0,0,0,12">

                <TextBlock x:Name="TxtResult"
                           Text="Ready to import."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
            </Border>

            <DataGrid x:Name="DgvBoms"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="{DynamicResource DmsBackgroundBrush}"
                      Foreground="{DynamicResource DmsForegroundBrush}"
                      BorderBrush="{DynamicResource DmsBorderBrush}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      MaxHeight="420">

                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColMaterial" Header="Material"
                                        Binding="{Binding MaterialNumber}"
                                        Width="120"/>

                    <DataGridTextColumn x:Name="ColPlant" Header="Plant"
                                        Binding="{Binding Plant}"
                                        Width="70"/>

                    <DataGridTextColumn x:Name="ColMeaning" Header="Meaning"
                                        Binding="{Binding BomMeaning}"
                                        Width="220"/>

                    <DataGridTextColumn x:Name="ColUsage" Header="Usage"
                                        Binding="{Binding BomUsage}"
                                        Width="70"/>

                    <DataGridTextColumn x:Name="ColBom" Header="BOM"
                                        Binding="{Binding BomNumber}"
                                        Width="120"/>

                    <DataGridTextColumn x:Name="ColAlternative" Header="Alt."
                                        Binding="{Binding Alternative}"
                                        Width="60"/>

                    <DataGridTextColumn x:Name="ColBaseQuantity" Header="Base quantity"
                                        Binding="{Binding BaseQuantity}"
                                        Width="110"/>

                    <DataGridTextColumn x:Name="ColBaseUnit" Header="UoM"
                                        Binding="{Binding BaseUnit}"
                                        Width="70"/>

                    <DataGridTextColumn x:Name="ColItemCount" Header="Items"
                                        Binding="{Binding ItemCount}"
                                        Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>