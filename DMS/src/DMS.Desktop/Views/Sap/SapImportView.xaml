<UserControl x:Class="DMS.Desktop.Views.Sap.SapImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">

    <UserControl.Resources>
        <Style x:Key="MappingTextCellStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        </Style>

        <Style x:Key="MappingCheckBoxCellStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style TargetType="DataGridCell" x:Key="Sap00DataGridCellStyle">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitle"
                       Text="Material import"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>

            <TextBlock x:Name="TxtSubtitle"
                       Text="Import MARA and MAKT SE16N exports into the local DMS cache."
                       Margin="0,6,0,0"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Padding="14"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                Background="{DynamicResource DmsBackgroundBrush}"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="MARA:"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>

                <TextBox x:Name="TxtMaraFile"
                         Grid.Row="0"
                         Grid.Column="1"
                         IsReadOnly="True"
                         Margin="0,0,8,8"
                         Background="{DynamicResource DmsPanelBrush}"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         BorderBrush="{DynamicResource DmsBorderBrush}"/>

                <Button x:Name="BtnSelectMara"
                        Grid.Row="0"
                        Grid.Column="2"
                        Content="Select MARA"
                        Click="BtnSelectMara_Click"
                        Padding="12,6"
                        Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="MAKT:"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>

                <TextBox x:Name="TxtMaktFile"
                         Grid.Row="1"
                         Grid.Column="1"
                         IsReadOnly="True"
                         Margin="0,0,8,8"
                         Background="{DynamicResource DmsPanelBrush}"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         BorderBrush="{DynamicResource DmsBorderBrush}"/>

                <Button x:Name="BtnSelectMakt"
                        Grid.Row="1"
                        Grid.Column="2"
                        Content="Select MAKT"
                        Click="BtnSelectMakt_Click"
                        Padding="12,6"
                        Margin="0,0,0,8"/>

                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            Margin="0,8,0,0">

                    <Button x:Name="BtnImport"
                            Content="Run import"
                            Click="BtnImport_Click"
                            Width="160"
                            Padding="12,8"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource DmsAccentBrush}"
                            Foreground="{DynamicResource DmsOnAccentBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Expander x:Name="ExpColumnMapping"
                  Grid.Row="2"
                  Header="Required MARA / MAKT export columns"
                  IsExpanded="False"
                  Margin="0,0,0,16"
                  Foreground="{DynamicResource DmsForegroundBrush}"
                  Background="{DynamicResource DmsBackgroundBrush}"
                  HorizontalAlignment="Stretch">

            <Border BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource DmsBackgroundBrush}"
                    Padding="0">

                <DataGrid x:Name="DgvColumnMapping"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="{DynamicResource DmsBackgroundBrush}"
                          Foreground="{DynamicResource DmsForegroundBrush}"
                          BorderBrush="{DynamicResource DmsBorderBrush}"
                          HorizontalAlignment="Stretch"
                          MaxHeight="260"
                          MinHeight="160"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          MinRowHeight="30"
                          CellStyle="{StaticResource Sap00DataGridCellStyle}">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColTable"
                                            Header="Table"
                                            Binding="{Binding TableName}"
                                            Width="90"
                                            MinWidth="90"
                                            ElementStyle="{StaticResource MappingTextCellStyle}"/>

                        <DataGridTextColumn x:Name="ColColumn"
                                            Header="Column"
                                            Binding="{Binding ColumnName}"
                                            Width="110"
                                            MinWidth="110"
                                            ElementStyle="{StaticResource MappingTextCellStyle}"/>

                        <DataGridCheckBoxColumn x:Name="ColRequired"
                                                Header="Required"
                                                Binding="{Binding IsRequired}"
                                                ElementStyle="{StaticResource MappingCheckBoxCellStyle}"
                                                Width="90"
                                                MinWidth="90"/>

                        <DataGridTextColumn x:Name="ColSapMeaning"
                                            Header="SAP meaning"
                                            Binding="{Binding SapMeaning}"
                                            Width="260"
                                            MinWidth="220"
                                            ElementStyle="{StaticResource MappingTextCellStyle}"/>

                        <DataGridTextColumn x:Name="ColDmsMeaning"
                                            Header="DMS meaning"
                                            Binding="{Binding DmsMeaning}"
                                            Width="*"
                                            MinWidth="500"
                                            ElementStyle="{StaticResource MappingTextCellStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Expander>

        <TextBox x:Name="TxtResult"
                 Grid.Row="3"
                 MinHeight="260"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 Background="{DynamicResource DmsBackgroundBrush}"
                 Foreground="{DynamicResource DmsForegroundBrush}"
                 BorderBrush="{DynamicResource DmsBorderBrush}"
                 Padding="10"/>
    </Grid>
</UserControl>
