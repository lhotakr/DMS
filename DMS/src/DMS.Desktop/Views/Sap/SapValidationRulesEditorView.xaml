<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DMS.Desktop.Views.Sap.SapValidationRulesEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="{DynamicResource DmsPanelBrush}">

    <UserControl.Resources>

        <x:Array x:Key="ValidationOperators" Type="{x:Type sys:String}">
            <sys:String>Equals</sys:String>
            <sys:String>NotEquals</sys:String>
            <sys:String>Contains</sys:String>
            <sys:String>StartsWith</sys:String>
            <sys:String>EndsWith</sys:String>
            <sys:String>IsEmpty</sys:String>
            <sys:String>IsNotEmpty</sys:String>
            <sys:String>IsTrue</sys:String>
            <sys:String>IsFalse</sys:String>
            <sys:String>GreaterThan</sys:String>
            <sys:String>GreaterOrEqual</sys:String>
            <sys:String>LessThan</sys:String>
            <sys:String>LessOrEqual</sys:String>
        </x:Array>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValidationGridTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValidationGridTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hlavička -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TxtValidationTitle"
                       Text="SAP validation rules"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>

            <TextBlock x:Name="TxtPath"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <!-- Hlavní obsah: seznam + detail -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Seznam pravidel -->
            <DataGrid x:Name="DgvRules"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionChanged="DgvRules_SelectionChanged"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="{DynamicResource DmsBackgroundBrush}"
                      Foreground="{DynamicResource DmsForegroundBrush}"
                      BorderBrush="{DynamicResource DmsBorderBrush}">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridCheckBoxColumn x:Name="ColEnabled"
                                            Header="On"
                                            Binding="{Binding Enabled}"
                                            Width="50"/>
                    <DataGridTextColumn x:Name="ColSeverity"
                                        Header="Type"
                                        Binding="{Binding Severity}"
                                        Width="80"/>
                    <DataGridTextColumn x:Name="ColScope"
                                        Header="Scope"
                                        Binding="{Binding Scope}"
                                        Width="130"/>
                    <DataGridTextColumn x:Name="ColName"
                                        Header="Name"
                                        Binding="{Binding Name}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Detail pravidla -->
            <Border Grid.Column="2"
                    Padding="14"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    Background="{DynamicResource DmsBackgroundBrush}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtDetailTitle"
                               Text="Rule detail"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,12"/>

                    <!-- ID -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblId"
                                   Text="ID:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtId"
                                 Grid.Column="1"
                                 TextChanged="DetailChanged"
                                 Background="{DynamicResource DmsPanelBrush}"
                                 Foreground="{DynamicResource DmsForegroundBrush}"
                                 BorderBrush="{DynamicResource DmsBorderBrush}"/>
                    </Grid>

                    <!-- Název -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblName"
                                   Text="Name:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtName"
                                 Grid.Column="1"
                                 TextChanged="DetailChanged"
                                 Background="{DynamicResource DmsPanelBrush}"
                                 Foreground="{DynamicResource DmsForegroundBrush}"
                                 BorderBrush="{DynamicResource DmsBorderBrush}"/>
                    </Grid>

                    <!-- Scope + Severity + Active -->
                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblScope"
                                   Text="Scope:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtScope"
                                 Grid.Column="1"
                                 TextChanged="DetailChanged"
                                 Background="{DynamicResource DmsPanelBrush}"
                                 Foreground="{DynamicResource DmsForegroundBrush}"
                                 BorderBrush="{DynamicResource DmsBorderBrush}"/>
                        <TextBlock x:Name="LblSeverity"
                                   Grid.Column="2"
                                   Text="Type:"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtSeverity"
                                 Grid.Column="3"
                                 TextChanged="DetailChanged"
                                 Background="{DynamicResource DmsPanelBrush}"
                                 Foreground="{DynamicResource DmsForegroundBrush}"
                                 BorderBrush="{DynamicResource DmsBorderBrush}"/>
                        <CheckBox x:Name="ChkEnabled"
                                  Grid.Column="4"
                                  Content="Active"
                                  Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource DmsForegroundBrush}"
                                  Checked="DetailChanged"
                                  Unchecked="DetailChanged"/>
                    </Grid>

                    <!-- Zpráva + podmínky + pole -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="120"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TxtMessageLabel"
                                   Text="Message on rule match:"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>

                        <TextBox x:Name="TxtMessage"
                                 Grid.Row="1"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="DetailChanged"
                                 Background="{DynamicResource DmsPanelBrush}"
                                 Foreground="{DynamicResource DmsForegroundBrush}"
                                 BorderBrush="{DynamicResource DmsBorderBrush}"/>

                        <TextBlock x:Name="TxtConditionsLabel"
                                   Grid.Row="2"
                                   Text="Conditions:"
                                   FontWeight="Bold"
                                   Margin="0,10,0,4"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>

                        <DataGrid x:Name="DgvConditions"
                                  Grid.Row="3"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="False"
                                  CanUserAddRows="True"
                                  CellEditEnding="DgvConditions_CellEditEnding"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Background="{DynamicResource DmsPanelBrush}"
                                  Foreground="{DynamicResource DmsForegroundBrush}"
                                  BorderBrush="{DynamicResource DmsBorderBrush}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  MinRowHeight="30"
                                  MinHeight="150">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="ColCondField"
                                                        Header="Field"
                                                        Width="220" MinWidth="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Field}"
                                                       Style="{StaticResource ValidationGridTextBlockStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Field, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ValidationGridTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="ColCondOperator"
                                                        Header="Operator"
                                                        Width="190" MinWidth="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Operator}"
                                                       Style="{StaticResource ValidationGridTextBlockStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Operator, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ValidationGridTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="ColCondValue"
                                                        Header="Value"
                                                        Width="*" MinWidth="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Value}"
                                                       Style="{StaticResource ValidationGridTextBlockStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ValidationGridTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="TxtAvailableFieldsLabel"
                                   Grid.Row="4"
                                   Text="Available fields for selected scope:"
                                   FontWeight="Bold"
                                   Margin="0,10,0,4"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>

                        <TextBox x:Name="TxtAvailableFields"
                                 Grid.Row="5"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource DmsPanelBrush}"
                                 Foreground="{DynamicResource DmsMutedForegroundBrush}"
                                 BorderBrush="{DynamicResource DmsBorderBrush}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Tlačítka + status -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,12,0,0">
            <Button x:Name="BtnLoad"
                    Content="Load"
                    Width="110"
                    Margin="0,0,8,0"
                    Click="BtnLoad_Click"/>
            <Button x:Name="BtnSave"
                    Content="Save"
                    Width="110"
                    Margin="0,0,8,0"
                    Click="BtnSave_Click"/>
            <Button x:Name="BtnAdd"
                    Content="Add"
                    Width="110"
                    Margin="0,0,8,0"
                    Click="BtnAdd_Click"/>
            <Button x:Name="BtnDuplicate"
                    Content="Duplicate"
                    Width="120"
                    Margin="0,0,8,0"
                    Click="BtnDuplicate_Click"/>
            <Button x:Name="BtnDelete"
                    Content="Delete"
                    Width="110"
                    Margin="0,0,8,0"
                    Click="BtnDelete_Click"/>
            <Button x:Name="BtnValidate"
                    Content="Validate"
                    Width="120"
                    Margin="0,0,8,0"
                    Click="BtnValidate_Click"/>
            <TextBlock x:Name="TxtStatus"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>