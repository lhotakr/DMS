<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DMS.Desktop.Views.Sap.SapRoutingImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">

    <UserControl.Resources>
        <Style x:Key="MappingTextCellStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
        </Style>

        <Style x:Key="MappingCheckBoxCellStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Import pracovních postupů"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>

            <TextBlock Text="Import SE16N exportů MAPL, PLKO, PLAS a PLPO do lokální DMS cache. Alternativy pracovních postupů jsou rozdělené podle PLAS."
                       Margin="0,6,0,0"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Padding="14"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                Background="{DynamicResource DmsBackgroundBrush}"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="MAPL:"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>

                <TextBox x:Name="TxtMaplFile"
                         Grid.Row="0" Grid.Column="1"
                         IsReadOnly="True"
                         Margin="0,0,8,8"
                         Background="{DynamicResource DmsPanelBrush}"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         BorderBrush="{DynamicResource DmsBorderBrush}"/>

                <Button Grid.Row="0" Grid.Column="2"
                        Content="Vybrat MAPL"
                        Click="BtnSelectMapl_Click"
                        Margin="0,0,0,8"
                        Padding="12,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="PLKO:"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>

                <TextBox x:Name="TxtPlkoFile"
                         Grid.Row="1" Grid.Column="1"
                         IsReadOnly="True"
                         Margin="0,0,8,8"
                         Background="{DynamicResource DmsPanelBrush}"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         BorderBrush="{DynamicResource DmsBorderBrush}"/>

                <Button Grid.Row="1" Grid.Column="2"
                        Content="Vybrat PLKO"
                        Click="BtnSelectPlko_Click"
                        Margin="0,0,0,8"
                        Padding="12,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="PLPO:"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>

                <TextBox x:Name="TxtPlpoFile"
                         Grid.Row="2" Grid.Column="1"
                         IsReadOnly="True"
                         Margin="0,0,8,8"
                         Background="{DynamicResource DmsPanelBrush}"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         BorderBrush="{DynamicResource DmsBorderBrush}"/>

                <Button Grid.Row="2" Grid.Column="2"
                        Content="Vybrat PLPO"
                        Click="BtnSelectPlpo_Click"
                        Margin="0,0,0,8"
                        Padding="12,6"/>

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="PLAS:"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>

                <TextBox x:Name="TxtPlasFile"
                         Grid.Row="3" Grid.Column="1"
                         IsReadOnly="True"
                         Margin="0,0,8,8"
                         Background="{DynamicResource DmsPanelBrush}"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         BorderBrush="{DynamicResource DmsBorderBrush}"/>

                <Button Grid.Row="3" Grid.Column="2"
                        Content="Vybrat PLAS"
                        Click="BtnSelectPlas_Click"
                        Margin="0,0,0,8"
                        Padding="12,6"/>

                <StackPanel Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            Margin="0,8,0,0">

                    <Button Content="Spustit import"
                            Click="BtnImport_Click"
                            Width="160"
                            Padding="12,8"
                            Background="{DynamicResource DmsAccentBrush}"
                            Foreground="{DynamicResource DmsOnAccentBrush}"/>

                    <Button Content="Načíst cache"
                            Click="BtnLoadCache_Click"
                            Width="140"
                            Margin="8,0,0,0"
                            Padding="12,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mapování sloupců -->
        <Expander Grid.Row="2"
          Header="Požadované sloupce exportů MAPL / PLKO / PLPO"
          IsExpanded="False"
          Margin="0,0,0,16"
          Foreground="{DynamicResource DmsForegroundBrush}"
          Background="{DynamicResource DmsBackgroundBrush}"
          HorizontalAlignment="Stretch">

            <Border BorderBrush="{DynamicResource DmsBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource DmsBackgroundBrush}"
            Padding="0">

                <DataGrid x:Name="DgvColumnMapping"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{DynamicResource DmsBackgroundBrush}"
                  Foreground="{DynamicResource DmsForegroundBrush}"
                  BorderBrush="{DynamicResource DmsBorderBrush}"
                  HorizontalAlignment="Stretch"
                  MaxHeight="260"
                  MinHeight="160"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  MinRowHeight="30">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Tabulka" Width="90" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TableName}"
                                       TextWrapping="Wrap"
                                       Padding="6,4"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Sloupec" Width="110" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ColumnName}"
                                       TextWrapping="Wrap"
                                       Padding="6,4"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Povinný" Width="90" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsRequired}"
                                      IsHitTestVisible="False"
                                      Focusable="False"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="SAP význam" Width="260" MinWidth="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SapMeaning}"
                                       TextWrapping="Wrap"
                                       Padding="6,4"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="DMS význam" Width="*" MinWidth="500">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DmsMeaning}"
                                       TextWrapping="Wrap"
                                       Padding="6,4"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Expander>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="TxtResult"
                     Grid.Row="0"
                     MinHeight="100"
                     Margin="0,0,0,12"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     Background="{DynamicResource DmsBackgroundBrush}"
                     Foreground="{DynamicResource DmsForegroundBrush}"
                     BorderBrush="{DynamicResource DmsBorderBrush}"
                     Padding="10"/>

            <DataGrid x:Name="DgvRoutings"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="{DynamicResource DmsBackgroundBrush}"
                      Foreground="{DynamicResource DmsForegroundBrush}"
                      BorderBrush="{DynamicResource DmsBorderBrush}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      MaxHeight="420">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Materiál" Binding="{Binding MaterialNumber}" Width="120"/>
                    <DataGridTextColumn Header="Závod" Binding="{Binding Plant}" Width="70"/>
                    <DataGridTextColumn Header="Význam" Binding="{Binding RoutingMeaning}" Width="230"/>
                    <DataGridTextColumn Header="Skupina" Binding="{Binding GroupNumber}" Width="120"/>
                    <DataGridTextColumn Header="Alt." Binding="{Binding Alternative}" Width="60"/>
                    <DataGridTextColumn Header="Popis" Binding="{Binding Description}" Width="220"/>
                    <DataGridTextColumn Header="Operací" Binding="{Binding OperationCount}" Width="80"/>
                    <DataGridTextColumn Header="Varování" Binding="{Binding WarningCount}" Width="80"/>
                    <DataGridCheckBoxColumn Header="Kritická chyba" Binding="{Binding HasCriticalError}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>