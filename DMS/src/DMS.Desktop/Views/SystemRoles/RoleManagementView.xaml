<UserControl x:Class="DMS.Desktop.Views.SystemRoles.RoleManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="0">

            <TextBlock Text="SYS12 - Správa rolí"
                       Style="{StaticResource DmsTitleTextStyle}"/>

            <Border Style="{StaticResource DmsCardBorderStyle}"
                    Margin="0,0,0,12">

                <StackPanel>

                    <TextBlock Text="Role DMS"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Role se používají pro řízení přístupu k transakcím. Kód role doporučuji psát velkými písmeny bez mezer."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"
                               Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <TextBlock Text="Filtr:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBox x:Name="TxtFilter"
                                 Width="320"
                                 Margin="0,0,8,0"
                                 TextChanged="TxtFilter_TextChanged"/>

                        <CheckBox x:Name="ChkShowInactive"
                                  Content="Zobrazit neaktivní"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Checked="FilterChanged"
                                  Unchecked="FilterChanged"/>
                    </StackPanel>

                    <DataGrid x:Name="GridRoles"
                              Style="{StaticResource DmsDataGridStyle}"
                              RowStyle="{StaticResource DmsEditableGridRowStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="True"
                              MinHeight="420"
                              Margin="0,0,0,12">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Kód"
                                                Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                                Width="190"
                                                MinWidth="160"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                EditingElementStyle="{StaticResource DmsDataGridTextBoxEditingStyle}"/>

                            <DataGridTextColumn Header="Název"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                Width="260"
                                                MinWidth="220"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                EditingElementStyle="{StaticResource DmsDataGridTextBoxEditingStyle}"/>

                            <DataGridTextColumn Header="Popis"
                                                Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"
                                                MinWidth="360"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                EditingElementStyle="{StaticResource DmsDataGridTextBoxEditingStyle}"/>

                            <DataGridCheckBoxColumn Header="Aktivní"
                                                    Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    EditingElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    Width="100"
                                                    MinWidth="90"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Znovu načíst"
                                MinWidth="120"
                                Margin="0,0,8,0"
                                Click="BtnReload_Click"/>

                        <Button Content="Uložit"
                                MinWidth="120"
                                Margin="0,0,8,0"
                                Click="BtnSave_Click"/>
                        
                        <Button Content="Označit ke smazání"
                                MinWidth="150"
                                Margin="0,0,8,0"
                                Click="BtnMarkDeleted_Click"/>

                        <Button Content="Vrátit označení"
                                MinWidth="130"
                                Margin="0,0,8,0"
                                Click="BtnRestoreRow_Click"/>

                    </StackPanel>

                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtStatus"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>