<UserControl x:Class="DMS.Desktop.Views.Settings.ClientSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsBackgroundBrush}">

    <Grid Background="{DynamicResource DmsBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">

            <Border Background="{DynamicResource DmsPanelBrush}"
                    Padding="20"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                <StackPanel Width="520"
                            HorizontalAlignment="Left">

                    <TextBlock Text="Nastavení klienta"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"
                           Margin="0,0,0,16"/>

                    <TextBlock Text="Vzhled"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>

                    <Grid Width="520"
      Height="32"
      Margin="0,0,0,14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtThemeMode"
             Grid.Column="0"
             Height="32"
             IsReadOnly="True"
             VerticalContentAlignment="Center"
             Background="{DynamicResource DmsBackgroundBrush}"
             Foreground="{DynamicResource DmsForegroundBrush}"
             BorderBrush="{DynamicResource DmsBorderBrush}"
             CaretBrush="{DynamicResource DmsForegroundBrush}"/>

                        <Button x:Name="BtnThemeModeDropDown"
            Grid.Column="1"
            Content="▼"
            Height="32"
            Background="{DynamicResource DmsPanelBrush}"
            Foreground="{DynamicResource DmsForegroundBrush}"
            BorderBrush="{DynamicResource DmsBorderBrush}"
            Click="BtnThemeModeDropDown_Click"/>

                        <Popup x:Name="PopupThemeMode"
           PlacementTarget="{Binding ElementName=TxtThemeMode}"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True"
           Width="520">

                            <Border Background="{DynamicResource DmsPanelBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                BorderThickness="1">

                                <ListBox x:Name="LstThemeModes"
                     Background="{DynamicResource DmsPanelBrush}"
                     Foreground="{DynamicResource DmsForegroundBrush}"
                     BorderThickness="0"
                     MouseLeftButtonUp="LstThemeModes_MouseLeftButtonUp">
                                    <ListBoxItem Content="Light"/>
                                    <ListBoxItem Content="Dark"/>
                                    <ListBoxItem Content="Custom"/>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                    <TextBlock Text="Náhled"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>

                    <Border x:Name="PreviewBackground"
                        Background="{DynamicResource DmsBackgroundBrush}"
                        BorderBrush="{DynamicResource DmsBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,16">

                        <Border x:Name="PreviewPanel"
                            Background="{DynamicResource DmsPanelBrush}"
                            BorderBrush="{DynamicResource DmsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">

                            <StackPanel>
                                <TextBlock x:Name="PreviewTitle"
                                       Text="Ukázka DMS karty"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"
                                       Margin="0,0,0,8"/>

                                <TextBlock x:Name="PreviewText"
                                       Text="Běžný text, popisy polí a hodnoty."
                                       Foreground="{DynamicResource DmsForegroundBrush}"
                                       Margin="0,0,0,4"/>

                                <TextBlock x:Name="PreviewMutedText"
                                       Text="Pomocný tlumený text."
                                       Foreground="{DynamicResource DmsMutedForegroundBrush}"
                                       Margin="0,0,0,10"/>

                                <Button x:Name="PreviewButton"
                                    Content="Akční tlačítko"
                                    Width="130"
                                    Background="{DynamicResource DmsAccentBrush}"
                                    Foreground="{DynamicResource DmsOnAccentBrush}"
                                    BorderBrush="{DynamicResource DmsAccentBrush}"/>
                            </StackPanel>
                        </Border>
                    </Border>

                    <StackPanel x:Name="CustomColorsPanel">
                        <TextBlock Text="Vlastní barvy"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                        <TextBlock Text="Pozadí aplikace"/>
                        <TextBox x:Name="TxtBackgroundColor" Height="30" Margin="0,0,0,8"/>

                        <TextBlock Text="Panel / karta"/>
                        <TextBox x:Name="TxtPanelColor" Height="30" Margin="0,0,0,8"/>

                        <TextBlock Text="Text"/>
                        <TextBox x:Name="TxtForegroundColor" Height="30" Margin="0,0,0,8"/>

                        <TextBlock Text="Tlumený text"/>
                        <TextBox x:Name="TxtMutedForegroundColor" Height="30" Margin="0,0,0,8"/>

                        <TextBlock Text="Rámečky"/>
                        <TextBox x:Name="TxtBorderColor" Height="30" Margin="0,0,0,8"/>

                        <TextBlock Text="Akcentní barva"/>
                        <TextBox x:Name="TxtAccentColor" Height="30" Margin="0,0,0,8"/>

                        <TextBlock Text="Text na akcentní barvě"/>
                        <TextBox x:Name="TxtOnAccentColor" Height="30" Margin="0,0,0,14"/>
                    </StackPanel>

                    <TextBlock Text="Historie transakcí"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>

                    <TextBox x:Name="TxtMaxHistory"
                         Height="32"
                         Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                        <Button Content="Použít"
                            Width="90"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="BtnApply_Click"/>

                        <Button Content="Uložit"
                            Width="90"
                            Height="32"
                            Background="{DynamicResource DmsAccentBrush}"
                            Foreground="{DynamicResource DmsOnAccentBrush}"
                            BorderBrush="{DynamicResource DmsAccentBrush}"
                            Click="BtnSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>