<UserControl x:Class="DMS.Desktop.Views.Settings.ClientSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsBackgroundBrush}">

    <Grid Background="{DynamicResource DmsBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">

            <Border Background="{DynamicResource DmsPanelBrush}"
                    Padding="20"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                <StackPanel Width="520"
                            HorizontalAlignment="Left">

                    <TextBlock x:Name="TxtTitle"
                               Text="Nastavení klienta"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,16"/>

                    <TextBlock x:Name="TxtAppearanceTitle"
                               Text="Vzhled"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="TxtThemeTitle"
                               Text="Motiv"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,6"/>

                    <!-- Motiv - vlastní DMS selector bez ComboBoxu -->
                    <Button x:Name="BtnThemeSelector"
                            Width="260"
                            Height="36"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,14"
                            Tag="Light"
                            Click="BtnThemeSelector_Click"
                            Background="{DynamicResource DmsBackgroundBrush}"
                            Foreground="{DynamicResource DmsForegroundBrush}"
                            BorderBrush="{DynamicResource DmsBorderBrush}"
                            BorderThickness="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Padding="0">
                        <Grid>
                            <TextBlock x:Name="TxtThemeModeValue"
                                       Text="Light"
                                       VerticalAlignment="Center"
                                       Margin="10,0,34,0"
                                       Foreground="{DynamicResource DmsForegroundBrush}"
                                       FontSize="13"
                                       LineHeight="16"
                                       LineStackingStrategy="BlockLineHeight"/>

                            <TextBlock Text="▼"
                                       Width="28"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource DmsMutedForegroundBrush}"
                                       FontSize="12"/>
                        </Grid>
                    </Button>

                    <Popup x:Name="PopupThemeMode"
                           PlacementTarget="{Binding ElementName=BtnThemeSelector}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource DmsPanelBrush}"
                                BorderBrush="{DynamicResource DmsBorderBrush}"
                                BorderThickness="1"
                                MinWidth="{Binding ActualWidth, ElementName=BtnThemeSelector}">
                            <ListBox x:Name="LstThemeModes"
                                     Background="{DynamicResource DmsPanelBrush}"
                                     Foreground="{DynamicResource DmsForegroundBrush}"
                                     BorderThickness="0"
                                     MouseLeftButtonUp="LstThemeModes_MouseLeftButtonUp">
                                <ListBoxItem Tag="Light" Content="Light"/>
                                <ListBoxItem Tag="Dark" Content="Dark"/>
                                <ListBoxItem Tag="HG" Content="HG"/>
                                <ListBoxItem Tag="Custom" Content="Custom"/>
                            </ListBox>
                        </Border>
                    </Popup>

                    <TextBlock x:Name="TxtPreviewTitleLabel"
                               Text="Náhled"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,6"/>

                    <Border x:Name="PreviewBackground"
                            Background="{DynamicResource DmsBackgroundBrush}"
                            BorderBrush="{DynamicResource DmsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,16">

                        <Border x:Name="PreviewPanel"
                                Background="{DynamicResource DmsPanelBrush}"
                                BorderBrush="{DynamicResource DmsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">

                            <StackPanel>
                                <TextBlock x:Name="PreviewTitle"
                                           Text="Ukázka DMS karty"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource DmsForegroundBrush}"
                                           Margin="0,0,0,8"/>

                                <TextBlock x:Name="PreviewText"
                                           Text="Běžný text, popisy polí a hodnoty."
                                           Foreground="{DynamicResource DmsForegroundBrush}"
                                           Margin="0,0,0,4"/>

                                <TextBlock x:Name="PreviewMutedText"
                                           Text="Pomocný tlumený text."
                                           Foreground="{DynamicResource DmsMutedForegroundBrush}"
                                           Margin="0,0,0,10"/>

                                <Button x:Name="PreviewButton"
                                        Content="Akční tlačítko"
                                        Width="130"
                                        Style="{StaticResource DmsPrimaryButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </Border>

                    <TextBlock x:Name="TxtLanguageTitle"
                               Text="Jazyk aplikace"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,6"/>

                    <!-- Jazyk - vlastní DMS selector bez ComboBoxu -->
                    <Button x:Name="BtnLanguageSelector"
                            Width="260"
                            Height="36"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,6"
                            Tag="Auto"
                            Click="BtnLanguageSelector_Click"
                            Background="{DynamicResource DmsBackgroundBrush}"
                            Foreground="{DynamicResource DmsForegroundBrush}"
                            BorderBrush="{DynamicResource DmsBorderBrush}"
                            BorderThickness="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Padding="0">
                        <Grid>
                            <TextBlock x:Name="TxtLanguageModeValue"
                                       Text="Podle systému"
                                       VerticalAlignment="Center"
                                       Margin="10,0,34,0"
                                       Foreground="{DynamicResource DmsForegroundBrush}"
                                       FontSize="13"
                                       LineHeight="16"
                                       LineStackingStrategy="BlockLineHeight"/>

                            <TextBlock Text="▼"
                                       Width="28"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource DmsMutedForegroundBrush}"
                                       FontSize="12"/>
                        </Grid>
                    </Button>

                    <Popup x:Name="PopupLanguageMode"
                           PlacementTarget="{Binding ElementName=BtnLanguageSelector}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource DmsPanelBrush}"
                                BorderBrush="{DynamicResource DmsBorderBrush}"
                                BorderThickness="1"
                                MinWidth="{Binding ActualWidth, ElementName=BtnLanguageSelector}">
                            <ListBox x:Name="LstLanguageModes"
                                     Background="{DynamicResource DmsPanelBrush}"
                                     Foreground="{DynamicResource DmsForegroundBrush}"
                                     BorderThickness="0"
                                     MouseLeftButtonUp="LstLanguageModes_MouseLeftButtonUp">
                                <ListBoxItem Tag="Auto" Content="Podle systému"/>
                                <ListBoxItem Tag="cs-CZ" Content="Čeština"/>
                                <ListBoxItem Tag="de-DE" Content="Deutsch"/>
                                <ListBoxItem Tag="en-US" Content="English"/>
                            </ListBox>
                        </Border>
                    </Popup>

                    <TextBlock x:Name="TxtLanguageHelp"
                               Text="Při volbě podle systému DMS použije jazyk Windows, pokud je podporovaný. Jinak použije angličtinu."
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

                    <StackPanel x:Name="CustomColorsPanel">
                        <TextBlock x:Name="TxtCustomColorsTitle"
                                   Text="Vlastní barvy"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource DmsForegroundBrush}"
                                   Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtBackgroundColorLabel"
                                   Text="Pozadí aplikace"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtBackgroundColor"
                                 Height="30"
                                 Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtPanelColorLabel"
                                   Text="Panel / karta"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtPanelColor"
                                 Height="30"
                                 Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtForegroundColorLabel"
                                   Text="Text"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtForegroundColor"
                                 Height="30"
                                 Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtMutedForegroundColorLabel"
                                   Text="Tlumený text"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtMutedForegroundColor"
                                 Height="30"
                                 Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtBorderColorLabel"
                                   Text="Rámečky"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtBorderColor"
                                 Height="30"
                                 Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtAccentColorLabel"
                                   Text="Akcentní barva"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtAccentColor"
                                 Height="30"
                                 Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtOnAccentColorLabel"
                                   Text="Text na akcentní barvě"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtOnAccentColor"
                                 Height="30"
                                 Margin="0,0,0,14"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtStartupTransactionTitle"
                               Text="Počáteční transakce"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="TxtStartupTransaction"
                             Height="32"
                             ToolTip="Například QAMENU. Prázdná hodnota automatické spuštění vypne."
                             Margin="0,0,0,4"/>

                    <TextBlock x:Name="TxtStartupTransactionHelp"
                               Text="Transakce se automaticky otevře při spuštění DMS."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"
                               Margin="0,0,0,14"/>

                    <TextBlock x:Name="TxtFunctionKeysTitle"
                               Text="Funkční klávesy"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,4,0,6"/>

                    <TextBlock x:Name="TxtFunctionKeysHelp"
                               Text="SAP-like ovládání DMS. Význam kláves je jednotný, zde lze jednotlivé klávesy pouze zapnout nebo vypnout."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"
                               Margin="0,0,0,8"/>

                    <CheckBox x:Name="ChkFunctionKeysEnabled"
                              Content="Používat funkční klávesy"
                              Margin="0,0,0,6"/>

                    <CheckBox x:Name="ChkShowFunctionKeyBar"
                              Content="Zobrazovat spodní lištu funkčních kláves"
                              Margin="0,0,0,10"/>

                    <WrapPanel Margin="0,0,0,14">
                        <CheckBox x:Name="ChkFunctionKeyF1" Content="F1 Nápověda" Margin="0,0,16,6"/>
                        <CheckBox x:Name="ChkFunctionKeyF2" Content="F2 Změnit" Margin="0,0,16,6"/>
                        <CheckBox x:Name="ChkFunctionKeyF3" Content="F3 Zpět" Margin="0,0,16,6"/>
                        <CheckBox x:Name="ChkFunctionKeyF4" Content="F4 Výběr" Margin="0,0,16,6"/>
                        <CheckBox x:Name="ChkFunctionKeyF5" Content="F5 Obnovit" Margin="0,0,16,6"/>
                        <CheckBox x:Name="ChkFunctionKeyF6" Content="F6 Nový" Margin="0,0,16,6"/>
                        <CheckBox x:Name="ChkFunctionKeyF7" Content="F7 Předchozí" Margin="0,0,16,6"/>
                        <CheckBox x:Name="ChkFunctionKeyF8" Content="F8 Provést / uložit" Margin="0,0,16,6"/>
                        <CheckBox x:Name="ChkFunctionKeyF9" Content="F9 Následující" Margin="0,0,16,6"/>
                        <CheckBox x:Name="ChkFunctionKeyF12" Content="F12 Zrušit" Margin="0,0,16,6"/>
                    </WrapPanel>

                    <TextBlock x:Name="TxtDocumentationTitle"
                               Text="Dokumentace"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,2,0,6"/>

                    <TextBlock x:Name="TxtDocumentationHelp"
                               Text="F1 otevře kontextovou nápovědu v samostatném okně. HELP otevře plnou dokumentaci DMS."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"
                               Margin="0,0,0,8"/>

                    <CheckBox x:Name="ChkDocumentationHelpEnabled"
                              Content="Zobrazovat uživatelskou nápovědu"
                              Margin="0,0,0,6"/>

                    <CheckBox x:Name="ChkDocumentationTechnicalInfo"
                              Content="Zobrazovat technické informace"
                              Margin="0,0,0,14"/>

                    <TextBlock x:Name="TxtHistoryTitle"
                               Text="Historie transakcí"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="TxtMaxHistory"
                             Height="32"
                             Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button x:Name="BtnApply"
                                Content="Použít"
                                Width="90"
                                Height="32"
                                Margin="0,0,8,0"
                                Style="{StaticResource DmsFormButtonStyle}"
                                Click="BtnApply_Click"/>

                        <Button x:Name="BtnSave"
                                Content="Uložit"
                                Width="90"
                                Height="32"
                                Style="{StaticResource DmsPrimaryButtonStyle}"
                                Click="BtnSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
