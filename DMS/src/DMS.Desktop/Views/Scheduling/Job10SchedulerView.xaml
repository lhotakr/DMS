<UserControl x:Class="DMS.Desktop.Views.Scheduling.Job10SchedulerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">
    <UserControl.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
        </Style>

        <Style x:Key="Job10GridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TxtTitle"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>
            <TextBlock x:Name="TxtSubtitle"
                       Margin="0,4,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="2.8*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    Background="{DynamicResource DmsBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnAdd"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Click="BtnAdd_Click"/>
                        <Button x:Name="BtnDelete"
                                Padding="12,6"
                                Click="BtnDelete_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="GridJobs"
          Grid.Row="2"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserReorderColumns="True"
          CanUserResizeColumns="True"
          CanUserSortColumns="True"
          SelectionMode="Single"
          SelectionUnit="FullRow"
          HeadersVisibility="Column"
          GridLinesVisibility="All"
          RowHeight="34"
          MinRowHeight="34"
          EnableRowVirtualization="True"
          EnableColumnVirtualization="True"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          Background="{DynamicResource DmsBackgroundBrush}"
          Foreground="{DynamicResource DmsForegroundBrush}"
          BorderBrush="{DynamicResource DmsBorderBrush}"
          CellStyle="{StaticResource Job10GridCellStyle}"
          SelectionChanged="GridJobs_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn x:Name="ColEnabled"
                                Width="72"
                                MinWidth="72"
                                Binding="{Binding IsEnabled}"/>

                            <DataGridTextColumn x:Name="ColName"
                            Width="180"
                            MinWidth="140"
                            Binding="{Binding Name}"/>

                            <DataGridTextColumn x:Name="ColTemplate"
                            Width="280"
                            MinWidth="190"
                            Binding="{Binding TemplateName}"/>

                            <DataGridTextColumn x:Name="ColCron"
                            Width="155"
                            MinWidth="135"
                            Binding="{Binding CronExpression}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="TxtJobsFile"
                               Grid.Row="4"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="16"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    Background="{DynamicResource DmsBackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TxtEditorTitle"
                                   Margin="0,0,0,12"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <CheckBox x:Name="ChkEnabled"
                                  Margin="0,0,0,12"/>

                        <TextBlock x:Name="LblName"/>
                        <TextBox x:Name="TxtName"
                                 Margin="0,4,0,10"/>

                        <TextBlock x:Name="LblTemplate"/>
                        <ComboBox x:Name="CmbTemplate"
                                  Margin="0,4,0,10"
                                  IsEditable="False"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Name"
                                  SelectionChanged="CmbTemplate_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               ToolTip="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Border Margin="0,0,0,14"
                                Padding="10"
                                CornerRadius="5"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource DmsBorderBrush}"
                                Background="{DynamicResource DmsPanelBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="LblSummarySource" Grid.Row="0"/>
                                <TextBlock x:Name="TxtSummarySource" Grid.Row="0" Grid.Column="1"/>

                                <TextBlock x:Name="LblSummaryReport" Grid.Row="1"/>
                                <TextBlock x:Name="TxtSummaryReport" Grid.Row="1" Grid.Column="1"/>

                                <TextBlock x:Name="LblSummaryPeriod" Grid.Row="2"/>
                                <TextBlock x:Name="TxtSummaryPeriod" Grid.Row="2" Grid.Column="1"/>

                                <TextBlock x:Name="LblSummaryWorkcenters" Grid.Row="3"/>
                                <TextBlock x:Name="TxtSummaryWorkcenters"
                                           Grid.Row="3"
                                           Grid.Column="1"
                                           TextWrapping="Wrap"/>

                                <TextBlock x:Name="LblSummaryFilters" Grid.Row="4"/>
                                <TextBlock x:Name="TxtSummaryFilters"
                                           Grid.Row="4"
                                           Grid.Column="1"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="LblCron"/>
                        <TextBox x:Name="TxtCron"
                                 Margin="0,4,0,3"
                                 LostFocus="TxtCron_LostFocus"/>
                        <TextBlock x:Name="TxtCronHelp"
                                   Margin="0,0,0,3"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                        <TextBlock x:Name="TxtNextRun"
                                   Margin="0,0,0,10"
                                   FontSize="11"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

                        <TextBlock x:Name="LblTimeZone"/>
                        <TextBox x:Name="TxtTimeZone"
                                 Margin="0,4,0,10"
                                 Text="Europe/Prague"/>

                        <Separator Margin="0,4,0,12"/>

                        <TextBlock x:Name="LblFileNameTemplate"/>
                        <TextBox x:Name="TxtFileNameTemplate"
                                 Margin="0,4,0,14"/>

                        <Border Margin="0,0,0,14"
                                Padding="10"
                                CornerRadius="5"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource DmsBorderBrush}"
                                Background="{DynamicResource DmsPanelBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="220"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="TxtDeliveriesTitle" FontWeight="SemiBold"/>
                                    <ListBox x:Name="LstDeliveries" Grid.Row="2" SelectionChanged="LstDeliveries_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,3">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource DmsMutedForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <WrapPanel Grid.Row="4">
                                        <Button x:Name="BtnAddServerDelivery" Margin="0,0,5,5" Padding="8,5" Click="BtnAddServerDelivery_Click"/>
                                        <Button x:Name="BtnAddEmailDelivery" Margin="0,0,5,5" Padding="8,5" Click="BtnAddEmailDelivery_Click"/>
                                        <Button x:Name="BtnAddSharePointDelivery" Margin="0,0,5,5" Padding="8,5" Click="BtnAddSharePointDelivery_Click"/>
                                        <Button x:Name="BtnDuplicateDelivery" Margin="0,0,5,5" Padding="8,5" Click="BtnDuplicateDelivery_Click"/>
                                        <Button x:Name="BtnDeleteDelivery" Margin="0,0,5,5" Padding="8,5" Click="BtnDeleteDelivery_Click"/>
                                    </WrapPanel>
                                </Grid>
                                <Border Grid.Column="2" Padding="10" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource DmsBorderBrush}">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkDeliveryEnabled" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="LblDeliveryType"/>
                                        <TextBlock x:Name="TxtDeliveryType" Margin="0,2,0,10" FontWeight="SemiBold"/>
                                        <StackPanel x:Name="PanelServerDelivery" Visibility="Collapsed">
                                            <TextBlock x:Name="LblTargetPath"/>
                                            <TextBox x:Name="TxtTargetPath" Margin="0,4,0,8"/>
                                        </StackPanel>
                                        <StackPanel x:Name="PanelEmailDelivery" Visibility="Collapsed">
                                            <TextBlock x:Name="LblEmailRecipients"/>
                                            <TextBox x:Name="TxtEmailRecipients" Margin="0,4,0,8" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="LblEmailSubject"/>
                                            <TextBox x:Name="TxtEmailSubject" Margin="0,4,0,8"/>
                                        </StackPanel>
                                        <StackPanel x:Name="PanelSharePointDelivery" Visibility="Collapsed">
                                            <TextBlock x:Name="LblSharePointTarget"/>
                                            <TextBox x:Name="TxtSharePointTarget"
                                                     Margin="0,4,0,8"
                                                     MinHeight="72"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Disabled"/>
                                            <TextBlock x:Name="TxtSharePointHint" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnSave"
                                    Padding="14,7"
                                    Margin="0,0,8,0"
                                    Click="BtnSave_Click"/>
                            <Button x:Name="BtnRunNow"
                                    Padding="14,7"
                                    Background="{DynamicResource DmsAccentBrush}"
                                    Foreground="{DynamicResource DmsOnAccentBrush}"
                                    Click="BtnRunNow_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtStatus"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

            <Button x:Name="BtnReload"
                    Grid.Column="1"
                    Padding="12,6"
                    Click="BtnReload_Click"/>
        </Grid>
    </Grid>
</UserControl>
