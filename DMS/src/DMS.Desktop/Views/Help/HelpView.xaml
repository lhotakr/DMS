<UserControl x:Class="DMS.Desktop.Views.Help.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsBackgroundBrush}">

    <Grid Background="{DynamicResource DmsBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TxtTitle"
                       Text="HELP - Dokumentace DMS"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DmsForegroundBrush}"
                       Margin="0,0,0,6"/>
            <TextBlock x:Name="TxtSubtitle"
                       Text="Uživatelská příručka a dokumentace transakcí přímo v DMS."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    Background="{DynamicResource DmsPanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="TxtSearch"
                             Grid.Row="0"
                             Height="32"
                             Margin="0,0,0,10"
                             ToolTip="Hledat v dokumentaci"
                             TextChanged="TxtSearch_TextChanged"/>

                    <TreeView x:Name="TreeTopics"
                              Grid.Row="1"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource DmsForegroundBrush}"
                              SelectedItemChanged="TreeTopics_SelectedItemChanged"/>

                    <TextBlock x:Name="TxtCount"
                               Grid.Row="2"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"/>

            <Border Grid.Column="2"
                    Padding="16"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    Background="{DynamicResource DmsPanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtDocumentTitle"
                                   Grid.Column="0"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource DmsForegroundBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="BtnRunTransaction"
                                Grid.Column="1"
                                Content="Spustit transakci"
                                MinWidth="140"
                                Height="32"
                                Margin="12,0,0,0"
                                Style="{StaticResource DmsFormButtonStyle}"
                                Click="BtnRunTransaction_Click"
                                Visibility="Collapsed"/>
                    </Grid>

                    <FlowDocumentScrollViewer x:Name="DocViewer"
                                              Grid.Row="1"
                                              IsToolBarVisible="False"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="Transparent"/>

                    <Border x:Name="TechnicalInfoBorder"
                            Grid.Row="2"
                            Margin="0,12,0,0"
                            Padding="10"
                            CornerRadius="5"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource DmsBorderBrush}"
                            Background="{DynamicResource DmsBackgroundBrush}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TxtTechnicalInfo"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock x:Name="TxtHint"
                               Grid.Row="3"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"
                               TextWrapping="Wrap"
                               Text="Tip: F1 otevře kontextovou nápovědu k právě používané transakci v samostatném okně."/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
