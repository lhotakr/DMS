<UserControl x:Class="DMS.Desktop.Views.Mes.MesDeviceEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TxtTitle"
                       Text="MES02 - Editace zařízení"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>
            <TextBlock x:Name="TxtSubtitle"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Padding="12"
                Margin="0,0,0,12"
                Background="{DynamicResource DmsBackgroundBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtSummary"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBlock x:Name="TxtFilePath"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    <TextBlock x:Name="TxtHint"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                    <Button x:Name="BtnReload"
                            Content="Načíst"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="BtnReload_Click"/>
                    <Button x:Name="BtnAdd"
                            Content="Přidat"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="BtnAdd_Click"/>
                    <Button x:Name="BtnDelete"
                            Content="Smazat vybrané"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="BtnDelete_Click"/>
                    <Button x:Name="BtnSave"
                            Content="Uložit TXT"
                            Padding="12,6"
                            Click="BtnSave_Click"
                            Background="{DynamicResource DmsAccentBrush}"
                            Foreground="{DynamicResource DmsOnAccentBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="GridDevices"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource DmsBackgroundBrush}"
                  Foreground="{DynamicResource DmsForegroundBrush}"
                  BorderBrush="{DynamicResource DmsBorderBrush}"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,2"/>
                    <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="MinWidth" Value="80"/>
                    <Setter Property="Padding" Value="4"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColAddress" Header="Adresa / hostname" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="180" MinWidth="140"/>
                <DataGridTextColumn x:Name="ColCategory" Header="Typ" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="130" MinWidth="100"/>
                <DataGridTextColumn x:Name="ColName" Header="Název" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="240" MinWidth="160"/>
                <DataGridTextColumn x:Name="ColNote" Header="Poznámka" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="280"/>
                <DataGridTextColumn x:Name="ColSourceLine" Header="Řádek" Binding="{Binding SourceLineNumber}" Width="70" MinWidth="60" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="TxtStatusLine"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
    </Grid>
</UserControl>
