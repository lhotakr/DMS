<Window x:Class="DMS.Desktop.Views.Dialogs.ArticleSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Výběr artiklu"
        Width="900"
        Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DmsBackgroundBrush}">

    <Grid Margin="16"
          Background="{DynamicResource DmsBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Výběr artiklu"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource DmsForegroundBrush}"
                   Margin="0,0,0,14"/>

        <Border Grid.Row="1"
                Background="{DynamicResource DmsPanelBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="SAP číslo:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DmsForegroundBrush}"
                           Margin="0,0,8,8"/>

                <TextBox x:Name="TxtSapNumber"
                         Grid.Row="0"
                         Grid.Column="1"
                         Height="30"
                         Margin="0,0,16,8"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Staré číslo:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DmsForegroundBrush}"
                           Margin="0,0,8,8"/>

                <TextBox x:Name="TxtOldNumber"
                         Grid.Row="0"
                         Grid.Column="3"
                         Height="30"
                         Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Označení:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DmsForegroundBrush}"
                           Margin="0,0,8,0"/>

                <TextBox x:Name="TxtDescription"
                         Grid.Row="1"
                         Grid.Column="1"
                         Height="30"
                         Margin="0,0,16,0"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="Dekorace:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DmsForegroundBrush}"
                           Margin="0,0,8,0"/>

                <TextBox x:Name="TxtDecoration"
                         Grid.Row="1"
                         Grid.Column="3"
                         Height="30"
                         ToolTip="Například D, B, E, P"/>
            </Grid>
        </Border>

        <DataGrid x:Name="DgvArticles"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  MouseDoubleClick="DgvArticles_MouseDoubleClick">

            <DataGrid.Columns>
                <DataGridTextColumn Header="SAP číslo"
                                    Binding="{Binding SapArticleNumber}"
                                    Width="130"/>

                <DataGridTextColumn Header="Označení"
                                    Binding="{Binding Description}"
                                    Width="*"
                                    MinWidth="260"/>

                <DataGridTextColumn Header="Staré číslo"
                                    Binding="{Binding OldMaterialNumber}"
                                    Width="150"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding MaterialStatusName}"
                                    Width="160"/>

                <DataGridTextColumn Header="Dekorace"
                                    Binding="{Binding DecorationsText}"
                                    Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">

            <Button Content="Hledat"
                    Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="BtnSearch_Click"/>

            <Button Content="Zrušit"
                    Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="BtnCancel_Click"/>

            <Button Content="Vybrat"
                    Width="90"
                    Height="32"
                    Background="{DynamicResource DmsAccentBrush}"
                    Foreground="{DynamicResource DmsOnAccentBrush}"
                    BorderBrush="{DynamicResource DmsAccentBrush}"
                    Click="BtnSelect_Click"/>
        </StackPanel>
    </Grid>
</Window>