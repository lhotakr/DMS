<Window x:Class="DMS.Desktop.Views.Dialogs.ArticleNumberPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zadání čísla artiklu"
        Height="190"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Zadej SAP číslo artiklu"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#0B2A4A"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1"
                   Text="Například: 1000018165"
                   FontSize="13"
                   Foreground="Gray"
                   Margin="0,0,0,8"/>

        <TextBox x:Name="TxtArticleNumber"
                 Grid.Row="2"
                 Height="32"
                 FontSize="15"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,12"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Zrušit"
                    Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="BtnCancel_Click"/>

            <Button Content="OK"
                    Width="90"
                    Height="32"
                    IsDefault="True"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>