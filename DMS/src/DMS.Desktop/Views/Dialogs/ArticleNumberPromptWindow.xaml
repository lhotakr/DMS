<Window x:Class="DMS.Desktop.Views.Dialogs.ArticleNumberPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Výběr SAP materiálu"
        Width="1050"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DmsBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,14">

            <TextBlock x:Name="TxtTitle"
                       Text="Výběr SAP materiálu"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>

            <TextBlock x:Name="TxtSubtitle"
                       Text=""
                       FontSize="13"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource DmsPanelBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="SAP číslo:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DmsForegroundBrush}"
                           Margin="0,0,8,8"/>

                <TextBox x:Name="TxtSapNumber"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,16,8"
                         KeyDown="Filter_KeyDown"
                         TextChanged="Filter_TextChanged"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Staré číslo:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DmsForegroundBrush}"
                           Margin="0,0,8,8"/>

                <TextBox x:Name="TxtOldNumber"
                         Grid.Row="0"
                         Grid.Column="3"
                         Margin="0,0,0,8"
                         KeyDown="Filter_KeyDown"
                         TextChanged="Filter_TextChanged"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Označení:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DmsForegroundBrush}"
                           Margin="0,0,8,0"/>

                <TextBox x:Name="TxtDescription"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="0,0,16,0"
                         KeyDown="Filter_KeyDown"
                         TextChanged="Filter_TextChanged"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="Typ / info:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DmsForegroundBrush}"
                           Margin="0,0,8,0"/>

                <TextBox x:Name="TxtDecoration"
                         Grid.Row="1"
                         Grid.Column="3"
                         KeyDown="Filter_KeyDown"
                         TextChanged="Filter_TextChanged"/>
            </Grid>
        </Border>

        <DataGrid x:Name="DgArticles"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="DgArticles_MouseDoubleClick"
                  Background="{DynamicResource DmsPanelBrush}"
                  Foreground="{DynamicResource DmsForegroundBrush}"
                  BorderBrush="{DynamicResource DmsBorderBrush}"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">

            <DataGrid.Columns>
                <DataGridTextColumn Header="SAP číslo"
                                    Binding="{Binding SapNumber}"
                                    Width="130"/>

                <DataGridTextColumn Header="Označení"
                                    Binding="{Binding Description}"
                                    Width="*"/>

                <DataGridTextColumn Header="Staré číslo"
                                    Binding="{Binding OldNumber}"
                                    Width="160"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="80"/>

                <DataGridTextColumn Header="Typ"
                                    Binding="{Binding MaterialKind}"
                                    Width="130"/>

                <DataGridTextColumn Header="Info"
                                    Binding="{Binding ExtraInfo}"
                                    Width="190"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3"
                   Margin="0,12,0,0">

            <TextBlock x:Name="TxtStatus"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Hledat"
                        Width="90"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        Click="BtnSearch_Click"/>

                <Button Content="Zrušit"
                        Width="90"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        Click="BtnCancel_Click"/>

                <Button Content="Vybrat"
                        Width="90"
                        Padding="10,6"
                        Background="{DynamicResource DmsAccentBrush}"
                        Foreground="{DynamicResource DmsOnAccentBrush}"
                        Click="BtnOk_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>