<UserControl x:Class="DMS.Desktop.Views.Screens.Scr10PreparationQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1300">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="SCR10 – Fronta přípravy sít" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,0" Opacity="0.7"
                       Text="Přehled aktuálních a plánovaných zakázek s vazbou na síta z kusovníků SAP."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ToggleButton x:Name="CurrentModeButton" Grid.Column="0" Padding="14,6"
                          IsChecked="True" Click="CurrentModeButton_Click" Content="● Aktuální"/>
            <ToggleButton x:Name="PlannedModeButton" Grid.Column="2" Padding="14,6"
                          Click="PlannedModeButton_Click" Content="○ Výhled"/>

            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Skupina:"/>

            <ComboBox x:Name="GroupFilterCombo" Grid.Column="6" MinWidth="180">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Code, TargetNullValue=Všechny skupiny}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock x:Name="AutoRefreshText" Grid.Column="8"
                       VerticalAlignment="Center" Text="⟳ 1 s"/>
            <Button x:Name="SettingsButton" Grid.Column="10" Padding="10,6"
                    Click="SettingsButton_Click" Content="⚙"/>
            <Button x:Name="RefreshButton" Grid.Column="12" Padding="14,6"
                    Click="RefreshButton_Click" Content="Obnovit"/>
        </Grid>

        <DataGrid x:Name="QueueGrid" Grid.Row="3"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserResizeColumns="True"
                  CanUserReorderColumns="True" SelectionMode="Single"
                  SelectionUnit="FullRow" EnableRowVirtualization="True"
                  EnableColumnVirtualization="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" RowHeight="30"
                  MinColumnWidth="70" FrozenColumnCount="2"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Stroj" Binding="{Binding WorkcenterCode}" Width="90"/>
                <DataGridTemplateColumn Header="Stav stroje" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Margin="0,0,7,0"
                                         VerticalAlignment="Center" Fill="{Binding WorkcenterStateColor}"/>
                                <TextBlock VerticalAlignment="Center" Text="{Binding WorkcenterState}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Zakázka" Binding="{Binding OrderCode}" Width="110"/>
                <DataGridTextColumn Header="Artikl" Binding="{Binding ProductCode}" Width="155"/>
                <DataGridTextColumn Header="SAP číslo" Binding="{Binding SapNumber}" Width="125"/>
                <DataGridTextColumn Header="Velikost zakázky" Binding="{Binding OrderQuantity, StringFormat=N0}" Width="125"/>
                <DataGridTextColumn Header="Vyrobeno" Binding="{Binding ProducedQuantity, StringFormat=N0}" Width="105"/>
                <DataGridTextColumn Header="Zbývá" Binding="{Binding RemainingQuantity, StringFormat=N0}" Width="105"/>
                <DataGridTextColumn Header="Operace" Binding="{Binding OperationCode}" Width="90"/>
                <DataGridTextColumn Header="Síto" Binding="{Binding ScreenText}" Width="300"/>
                <DataGridTextColumn Header="Potřeba sít" Binding="{Binding ScreensNeeded}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RowsText" Grid.Column="0" Text="Řádků: 0"/>
            <TextBlock x:Name="WorkcentersText" Grid.Column="2" Text="Strojů: 0"/>
            <TextBlock x:Name="LastRefreshText" Grid.Column="4" Text="Poslední obnovení: —"/>
            <TextBlock x:Name="StatusText" Grid.Column="6" Opacity="0.7" Text="Připraveno"/>
        </Grid>
    </Grid>
</UserControl>