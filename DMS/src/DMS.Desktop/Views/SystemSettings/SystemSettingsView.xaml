<UserControl x:Class="DMS.Desktop.Views.SystemSettings.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="0">

            <!-- Nadpis -->
            <TextBlock Text="SYS01 - Nastavení systému DMS"
                       Style="{StaticResource DmsTitleTextStyle}"/>

            <!-- Karta -->
            <Border Style="{StaticResource DmsCardBorderStyle}"
                    Margin="0,0,0,12">

                <StackPanel>

                    <!-- Sekce dokumentového úložiště -->
                    <TextBlock Text="Dokumentové úložiště"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="Kořen dokumentů"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,4"/>

                    <TextBox x:Name="TxtDocumentsRootPath"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Kořen složek SAP ID / artiklů"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,4"/>

                    <TextBox x:Name="TxtArticleFoldersRootPath"
                             Margin="0,0,0,12"/>

                    <CheckBox x:Name="ChkCreateArticleFoldersOnSapImport"
                              Content="Zakládat složky automaticky při SAP importu"
                              Margin="0,0,0,18"/>

                    <!-- Podsložky -->
                    <TextBlock Text="Podsložky artiklu"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,4,0,8"/>

                    <DataGrid x:Name="GridSubFolders"
                              Style="{StaticResource DmsDataGridStyle}"
                              MinHeight="160"
                              Margin="0,0,0,18">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Kód"
                                                Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                EditingElementStyle="{StaticResource DmsDataGridTextBoxEditingStyle}"
                                                Width="120"
                                                MinWidth="100"/>

                            <DataGridTextColumn Header="Název"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                EditingElementStyle="{StaticResource DmsDataGridTextBoxEditingStyle}"
                                                Width="280"
                                                MinWidth="220"/>

                            <DataGridTextColumn Header="Relativní cesta"
                                                Binding="{Binding RelativePath, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                EditingElementStyle="{StaticResource DmsDataGridTextBoxEditingStyle}"
                                                Width="240"
                                                MinWidth="180"/>

                            <DataGridCheckBoxColumn Header="Aktivní"
                                                    Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    EditingElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    Width="110"
                                                    MinWidth="100"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Rozsahy SAP ID -->
                    <TextBlock Text="Rozsahy SAP ID pro zakládání složek"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,4,0,8"/>

                    <TextBlock Text="Aktivní rozsahy určují, pro které SAP ID se budou zakládat složky. Výchozí doporučení je pouze rozsah 1000000000–1099999999 pro hlavní artikly / flakony."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"
                               Margin="0,0,0,8"/>

                    <DataGrid x:Name="GridMaterialRanges"
                              Style="{StaticResource DmsDataGridStyle}"
                              MinHeight="150"
                              Margin="0,0,0,18">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Název"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                EditingElementStyle="{StaticResource DmsDataGridTextBoxEditingStyle}"
                                                Width="360"
                                                MinWidth="260"/>

                            <DataGridTextColumn Header="Od"
                                                Binding="{Binding From, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                EditingElementStyle="{StaticResource DmsDataGridTextBoxEditingStyle}"
                                                Width="170"
                                                MinWidth="150"/>

                            <DataGridTextColumn Header="Do"
                                                Binding="{Binding To, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                EditingElementStyle="{StaticResource DmsDataGridTextBoxEditingStyle}"
                                                Width="170"
                                                MinWidth="150"/>

                            <DataGridCheckBoxColumn Header="Aktivní"
                                                    Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    EditingElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    Width="110"
                                                    MinWidth="100"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Tlačítka -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Vygenerovat složky"
                                MinWidth="160"
                                Margin="0,0,8,0"
                                Click="BtnGenerateFolders_Click"/>

                        <Button Content="Test cest"
                                MinWidth="110"
                                Margin="0,0,8,0"
                                Click="BtnTestPaths_Click"/>

                        <Button Content="Uložit"
                                MinWidth="110"
                                Click="BtnSave_Click"/>

                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Status -->
            <TextBlock x:Name="TxtStatus"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>