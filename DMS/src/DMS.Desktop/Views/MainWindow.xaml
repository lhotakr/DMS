<Window x:Class="DMS.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DMS FiGUI Shell"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/DMS_SystemIcon.ico"
        Background="{DynamicResource DmsBackgroundBrush}">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New"
                        Executed="NewWindowCommand_Executed" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Key="N"
                    Modifiers="Control"
                    Command="ApplicationCommands.New" />
    </Window.InputBindings>

    <DockPanel x:Name="RootPanel"
               Background="{DynamicResource DmsBackgroundBrush}">

        <!-- Horní lišta -->
        <Border x:Name="TopBar"
                DockPanel.Dock="Top"
                Background="{DynamicResource DmsAccentBrush}"
                Padding="12">

            <DockPanel LastChildFill="True">
                <TextBlock Text="DMS FiGUI Shell"
                           DockPanel.Dock="Left"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsOnAccentBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <TextBlock x:Name="TxtCurrentUser"
                           Text="Uživatel: ..."
                           DockPanel.Dock="Right"
                           Foreground="{DynamicResource DmsOnAccentBrush}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- Transakční řádek -->
        <Border x:Name="TransactionBar"
                DockPanel.Dock="Top"
                Background="{DynamicResource DmsPanelBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10">

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Transakce:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>

                <Grid Width="420"
      Height="32">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtTransaction"
             Grid.Column="0"
             Height="32"
             VerticalContentAlignment="Center"
             KeyDown="TxtTransaction_KeyDown"
             Background="{DynamicResource DmsBackgroundBrush}"
             Foreground="{DynamicResource DmsForegroundBrush}"
             BorderBrush="{DynamicResource DmsBorderBrush}"
             CaretBrush="{DynamicResource DmsForegroundBrush}"/>

                    <Button x:Name="BtnTransactionHistory"
            Grid.Column="1"
            Content="▼"
            Height="32"
            Background="{DynamicResource DmsPanelBrush}"
            Foreground="{DynamicResource DmsForegroundBrush}"
            BorderBrush="{DynamicResource DmsBorderBrush}"
            Click="BtnTransactionHistory_Click"/>

                    <Popup x:Name="PopupTransactionHistory"
           PlacementTarget="{Binding ElementName=TxtTransaction}"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True"
           Width="420">

                        <Border Background="{DynamicResource DmsPanelBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                BorderThickness="1"
                MaxHeight="320">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox x:Name="LstTransactionHistory"
                         Background="{DynamicResource DmsPanelBrush}"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         BorderThickness="0"
                         MouseLeftButtonUp="LstTransactionHistory_MouseLeftButtonUp"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>

                <Button Content="★"
                        Width="40"
                        Height="32"
                        Margin="8,0,0,0"
                        Background="{DynamicResource DmsPanelBrush}"
                        Foreground="{DynamicResource DmsForegroundBrush}"
                        BorderBrush="{DynamicResource DmsBorderBrush}"
                        Click="BtnAddFavorite_Click"/>
            </StackPanel>
        </Border>

        <!-- Stavový řádek -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource DmsPanelBrush}"
                   Foreground="{DynamicResource DmsForegroundBrush}">
            <StatusBarItem Content="DB: lokální režim" />
            <StatusBarItem Content="SAP TEST: nepřipojeno" />
            <StatusBarItem Content="MES import: nepřipraven" />
            <StatusBarItem Content="SSO: Windows login" />
            <StatusBarItem Content="verze 0.1" />
        </StatusBar>

        <!-- Levé menu -->
        <Border x:Name="LeftMenuPanel"
                DockPanel.Dock="Left"
                Width="283"
                Background="{DynamicResource DmsPanelBrush}"
                Padding="16"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
                <StackPanel>
                    <TextBlock Text="Oblíbené"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"
                           Margin="0,0,0,8"/>

                    <ListBox x:Name="LstFavorites"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         DisplayMemberPath="DisplayText"
                         PreviewMouseRightButtonDown="LstFavorites_PreviewMouseRightButtonDown"
                         Margin="0,0,0,8">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <EventSetter Event="MouseLeftButtonUp"
                                         Handler="FavoriteItem_MouseLeftButtonUp"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Odebrat z oblíbených"
                                      Click="RemoveFavoriteMenuItem_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <Separator Margin="0,12"
                           Background="{DynamicResource DmsBorderBrush}"/>

                    <TextBlock Text="Moduly"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"
                           Margin="0,0,0,8"/>

                    <ListBox x:Name="LstModules"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         DisplayMemberPath="DisplayText"
                         SelectionChanged="LstModules_SelectionChanged"
                         Margin="0,0,0,8"/>

                    <Separator Margin="0,12"
                           Background="{DynamicResource DmsBorderBrush}"/>

                    <TextBlock Text="Transakce v modulu"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"
                           Margin="0,0,0,8"/>

                    <ListBox x:Name="LstModuleTransactions"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         Margin="0,0,0,8"
                         HorizontalContentAlignment="Stretch">

                        <ListBox.Resources>
                            <Style x:Key="FlatIconButtonStyle" TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                            </Style>
                        </ListBox.Resources>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                        Style="{StaticResource FlatIconButtonStyle}"
                                        Content="{Binding FavoriteIcon}"
                                        ToolTip="{Binding FavoriteToolTip}"
                                        Tag="{Binding Code}"
                                        Click="BtnToggleFavorite_Click"/>

                                    <Button Grid.Column="1"
                                        Style="{StaticResource FlatIconButtonStyle}"
                                        Tag="{Binding Code}"
                                        HorizontalContentAlignment="Left"
                                        Click="BtnExecuteModuleTransaction_Click">
                                        <TextBlock Text="{Binding DisplayText}"
                                               Foreground="{DynamicResource DmsForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Pracovní plocha -->
        <Grid Background="{DynamicResource DmsBackgroundBrush}"
              Margin="20">

            <ScrollViewer x:Name="WorkspaceScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  CanContentScroll="False">

                <Border x:Name="WorkspaceHost"
                    Background="{DynamicResource DmsPanelBrush}"
                    Padding="24"
                    CornerRadius="4"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1">

                    <Grid x:Name="WorkspacePanel">
                        <StackPanel>
                            <TextBlock Text="Vítejte v DMS"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{DynamicResource DmsForegroundBrush}"
                   Margin="0,0,0,16"/>

                            <TextBlock Text="Zadejte transakci nebo vyberte položku z menu."
                   FontSize="16"
                   Foreground="{DynamicResource DmsForegroundBrush}"
                   Margin="0,4"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>