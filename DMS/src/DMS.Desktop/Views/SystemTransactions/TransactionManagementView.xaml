<UserControl x:Class="DMS.Desktop.Views.SystemTransactions.TransactionManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="0">

            <TextBlock Text="SYS11 - Správa transakcí"
                       Style="{StaticResource DmsTitleTextStyle}"/>

            <Border Style="{StaticResource DmsCardBorderStyle}"
                    Margin="0,0,0,12">

                <StackPanel>

                    <TextBlock Text="Transakce DMS"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Code a HandlerKey jsou záměrně pouze pro čtení. Jejich změna může rozbít vazbu na dispatcher a handlery."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"
                               Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <TextBlock Text="Filtr:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBox x:Name="TxtFilter"
                                 Width="320"
                                 Margin="0,0,8,0"
                                 TextChanged="TxtFilter_TextChanged"/>

                        <CheckBox x:Name="ChkShowInactive"
                                  Content="Zobrazit neaktivní"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Checked="FilterChanged"
                                  Unchecked="FilterChanged"/>
                    </StackPanel>

                    <DataGrid x:Name="GridTransactions"
                              Style="{StaticResource DmsDataGridStyle}"
                              RowStyle="{StaticResource DmsEditableGridRowStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              MinHeight="420"
                              Margin="0,0,0,12">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Kód"
                                                Binding="{Binding Code}"
                                                IsReadOnly="True"
                                                Width="90"
                                                MinWidth="80"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"/>

                            <DataGridTextColumn Header="Název"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                Width="220"
                                                MinWidth="180"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                EditingElementStyle="{StaticResource DmsDataGridTextBoxEditingStyle}"/>

                            <DataGridComboBoxColumn x:Name="CmbModuleColumn"
                                                    Header="Modul"
                                                    SelectedItemBinding="{Binding Module, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="170"
                                                    MinWidth="150"/>

                            <DataGridTextColumn Header="Popis"
                                                Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"
                                                MinWidth="320"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                EditingElementStyle="{StaticResource DmsDataGridTextBoxEditingStyle}"/>

                            <DataGridTextColumn Header="Handler"
                                                Binding="{Binding HandlerKey}"
                                                IsReadOnly="True"
                                                Width="190"
                                                MinWidth="160"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"/>

                            <DataGridCheckBoxColumn Header="SAP ID"
                                                    Binding="{Binding RequiresArticleNumber, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    EditingElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    Width="80"
                                                    MinWidth="70"/>

                            <DataGridCheckBoxColumn Header="Aktivní"
                                                    Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    EditingElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    Width="90"
                                                    MinWidth="80"/>

                            <DataGridTextColumn Header="Role"
                                                Binding="{Binding RolesText}"
                                                IsReadOnly="True"
                                                Width="280"
                                                MinWidth="220"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Znovu načíst"
                                MinWidth="120"
                                Margin="0,0,8,0"
                                Click="BtnReload_Click"/>

                        <Button Content="Uložit"
                                MinWidth="120"
                                Click="BtnSave_Click"/>

                        <Button Content="Upravit role"
                                MinWidth="120"
                                Margin="0,0,8,0"
                                Click="BtnEditRoles_Click"/>

                    </StackPanel>

                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtStatus"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>