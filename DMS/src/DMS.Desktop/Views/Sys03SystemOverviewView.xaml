<UserControl x:Class="DMS.Desktop.Views.SystemOverview.Sys03SystemOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsBackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="DmsFieldLabelTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource DmsMutedForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3,10,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DmsFieldValueTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource DmsBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">

            <StackPanel Margin="20"
                        MaxWidth="1320"
                        HorizontalAlignment="Left">

                <TextBlock x:Name="TxtTitle"
                           Text="SYS03 - System Overview"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"
                           Margin="0,0,0,6"/>

                <TextBlock x:Name="TxtSubtitle"
                           Text="Read-only overview of DMS runtime, configuration and SYS01 settings."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DmsMutedForegroundBrush}"
                           Margin="0,0,0,18"/>

                <UniformGrid Columns="3"
                             Margin="0,0,0,14">

                    <Border Style="{StaticResource DmsCardBorderStyle}"
                            Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock x:Name="TxtEnvironmentTitle"
                                       Text="Environment"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"
                                       Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="TxtEnvironmentLabel" Grid.Row="0" Grid.Column="0" Text="Environment:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtEnvironmentValue" Grid.Row="0" Grid.Column="1" Text="-" Style="{StaticResource DmsFieldValueTextStyle}"/>

                                <TextBlock x:Name="TxtConfigurationModeLabel" Grid.Row="1" Grid.Column="0" Text="Config mode:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtConfigurationModeValue" Grid.Row="1" Grid.Column="1" Text="-" Style="{StaticResource DmsFieldValueTextStyle}"/>

                                <TextBlock x:Name="TxtSapModeLabel" Grid.Row="2" Grid.Column="0" Text="SAP:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtSapModeValue" Grid.Row="2" Grid.Column="1" Text="-" Style="{StaticResource DmsFieldValueTextStyle}"/>

                                <TextBlock x:Name="TxtMesModeLabel" Grid.Row="3" Grid.Column="0" Text="MES:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtMesModeValue" Grid.Row="3" Grid.Column="1" Text="-" Style="{StaticResource DmsFieldValueTextStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DmsCardBorderStyle}"
                            Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock x:Name="TxtUserTitle"
                                       Text="Current user"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"
                                       Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="TxtWindowsLoginLabel" Grid.Row="0" Grid.Column="0" Text="Windows:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtWindowsLoginValue" Grid.Row="0" Grid.Column="1" Text="-" Style="{StaticResource DmsFieldValueTextStyle}"/>

                                <TextBlock x:Name="TxtDisplayNameLabel" Grid.Row="1" Grid.Column="0" Text="Name:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtDisplayNameValue" Grid.Row="1" Grid.Column="1" Text="-" Style="{StaticResource DmsFieldValueTextStyle}"/>

                                <TextBlock x:Name="TxtRolesLabel" Grid.Row="2" Grid.Column="0" Text="Roles:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtRolesValue" Grid.Row="2" Grid.Column="1" Text="-" TextWrapping="Wrap" Style="{StaticResource DmsFieldValueTextStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DmsCardBorderStyle}"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="TxtTransactionTitle"
                                       Text="Transactions"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"
                                       Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="TxtVisibleTransactionsLabel" Grid.Row="0" Grid.Column="0" Text="Visible:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtVisibleTransactionsValue" Grid.Row="0" Grid.Column="1" Text="-" Style="{StaticResource DmsFieldValueTextStyle}"/>

                                <TextBlock x:Name="TxtVisibleModulesLabel" Grid.Row="1" Grid.Column="0" Text="Modules:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtVisibleModulesValue" Grid.Row="1" Grid.Column="1" Text="-" Style="{StaticResource DmsFieldValueTextStyle}"/>

                                <TextBlock x:Name="TxtDefaultArticleLabel" Grid.Row="2" Grid.Column="0" Text="Default article:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtDefaultArticleValue" Grid.Row="2" Grid.Column="1" Text="-" Style="{StaticResource DmsFieldValueTextStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource DmsCardBorderStyle}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="TxtSystemPathsTitle"
                                   Text="System paths"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource DmsForegroundBrush}"
                                   Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="TxtConfigRootLabel" Grid.Row="0" Grid.Column="0" Text="Configuration:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                            <TextBlock x:Name="TxtConfigRootValue" Grid.Row="0" Grid.Column="1" Text="-" TextWrapping="Wrap" Style="{StaticResource DmsFieldValueTextStyle}"/>
                            <TextBlock x:Name="TxtConfigRootStatus" Grid.Row="0" Grid.Column="2" Text="-" FontWeight="Bold" HorizontalAlignment="Right"/>

                            <TextBlock x:Name="TxtDocumentsRootLabel" Grid.Row="1" Grid.Column="0" Text="Documents:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                            <TextBlock x:Name="TxtDocumentsRootValue" Grid.Row="1" Grid.Column="1" Text="-" TextWrapping="Wrap" Style="{StaticResource DmsFieldValueTextStyle}"/>
                            <TextBlock x:Name="TxtDocumentsRootStatus" Grid.Row="1" Grid.Column="2" Text="-" FontWeight="Bold" HorizontalAlignment="Right"/>

                            <TextBlock x:Name="TxtArticleRootLabel" Grid.Row="2" Grid.Column="0" Text="Article folders:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                            <TextBlock x:Name="TxtArticleRootValue" Grid.Row="2" Grid.Column="1" Text="-" TextWrapping="Wrap" Style="{StaticResource DmsFieldValueTextStyle}"/>
                            <TextBlock x:Name="TxtArticleRootStatus" Grid.Row="2" Grid.Column="2" Text="-" FontWeight="Bold" HorizontalAlignment="Right"/>

                            <TextBlock x:Name="TxtLogsRootLabel" Grid.Row="3" Grid.Column="0" Text="Logs:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                            <TextBlock x:Name="TxtLogsRootValue" Grid.Row="3" Grid.Column="1" Text="-" TextWrapping="Wrap" Style="{StaticResource DmsFieldValueTextStyle}"/>
                            <TextBlock x:Name="TxtLogsRootStatus" Grid.Row="3" Grid.Column="2" Text="-" FontWeight="Bold" HorizontalAlignment="Right"/>

                            <TextBlock x:Name="TxtSystemSettingsFileLabel" Grid.Row="4" Grid.Column="0" Text="SYS01 file:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                            <TextBlock x:Name="TxtSystemSettingsFileValue" Grid.Row="4" Grid.Column="1" Text="-" TextWrapping="Wrap" Style="{StaticResource DmsFieldValueTextStyle}"/>
                            <TextBlock x:Name="TxtSystemSettingsFileStatus" Grid.Row="4" Grid.Column="2" Text="-" FontWeight="Bold" HorizontalAlignment="Right"/>

                            <TextBlock x:Name="TxtSapCacheFileLabel" Grid.Row="5" Grid.Column="0" Text="SAP cache:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                            <TextBlock x:Name="TxtSapCacheFileValue" Grid.Row="5" Grid.Column="1" Text="-" TextWrapping="Wrap" Style="{StaticResource DmsFieldValueTextStyle}"/>
                            <TextBlock x:Name="TxtSapCacheFileStatus" Grid.Row="5" Grid.Column="2" Text="-" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2"
                             Margin="0,0,0,14">

                    <Border Style="{StaticResource DmsCardBorderStyle}"
                            Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock x:Name="TxtSys01SummaryTitle"
                                       Text="SYS01 summary"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"
                                       Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="TxtAutoFoldersLabel" Grid.Row="0" Grid.Column="0" Text="Auto folder creation:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtAutoFoldersValue" Grid.Row="0" Grid.Column="1" Text="-" Style="{StaticResource DmsFieldValueTextStyle}"/>

                                <TextBlock x:Name="TxtSubFoldersCountLabel" Grid.Row="1" Grid.Column="0" Text="Active subfolders:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtSubFoldersCountValue" Grid.Row="1" Grid.Column="1" Text="-" Style="{StaticResource DmsFieldValueTextStyle}"/>

                                <TextBlock x:Name="TxtRangesCountLabel" Grid.Row="2" Grid.Column="0" Text="Active SAP ID ranges:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtRangesCountValue" Grid.Row="2" Grid.Column="1" Text="-" Style="{StaticResource DmsFieldValueTextStyle}"/>

                                <TextBlock x:Name="TxtLogoPathLabel" Grid.Row="3" Grid.Column="0" Text="Header logo:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtLogoPathValue" Grid.Row="3" Grid.Column="1" Text="-" TextWrapping="Wrap" Style="{StaticResource DmsFieldValueTextStyle}"/>

                                <TextBlock x:Name="TxtLogoSizeLabel" Grid.Row="4" Grid.Column="0" Text="Header logo size:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtLogoSizeValue" Grid.Row="4" Grid.Column="1" Text="-" Style="{StaticResource DmsFieldValueTextStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DmsCardBorderStyle}"
                            Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TxtLocalizationTitle"
                                       Text="Localization"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"
                                       Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="TxtLocalizationRootLabel" Grid.Row="0" Grid.Column="0" Text="Folder:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtLocalizationRootValue" Grid.Row="0" Grid.Column="1" Text="-" TextWrapping="Wrap" Style="{StaticResource DmsFieldValueTextStyle}"/>
                                <TextBlock x:Name="TxtLocalizationRootStatus" Grid.Row="0" Grid.Column="2" Text="-" FontWeight="Bold" HorizontalAlignment="Right"/>

                                <TextBlock x:Name="TxtLocalizationIndexLabel" Grid.Row="1" Grid.Column="0" Text="Index:" Style="{StaticResource DmsFieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtLocalizationIndexValue" Grid.Row="1" Grid.Column="1" Text="-" TextWrapping="Wrap" Style="{StaticResource DmsFieldValueTextStyle}"/>
                                <TextBlock x:Name="TxtLocalizationIndexStatus" Grid.Row="1" Grid.Column="2" Text="-" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource DmsCardBorderStyle}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="TxtSubFoldersTitle"
                                   Text="Article subfolders"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource DmsForegroundBrush}"
                                   Margin="0,0,0,10"/>

                        <DataGrid x:Name="GridSubFolders"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MinHeight="120"
                                  MaxHeight="220"
                                  Style="{StaticResource DmsDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn x:Name="ColSubFolderActive" Binding="{Binding IsActive}" Width="80"/>
                                <DataGridTextColumn x:Name="ColSubFolderCode" Binding="{Binding Code}" Width="120"/>
                                <DataGridTextColumn x:Name="ColSubFolderName" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn x:Name="ColSubFolderRelativePath" Binding="{Binding RelativePath}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DmsCardBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="TxtMaterialRangesTitle"
                                   Text="SAP ID ranges"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource DmsForegroundBrush}"
                                   Margin="0,0,0,10"/>

                        <DataGrid x:Name="GridMaterialRanges"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MinHeight="120"
                                  MaxHeight="220"
                                  Style="{StaticResource DmsDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn x:Name="ColRangeActive" Binding="{Binding IsActive}" Width="80"/>
                                <DataGridTextColumn x:Name="ColRangeName" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn x:Name="ColRangeFrom" Binding="{Binding From}" Width="150"/>
                                <DataGridTextColumn x:Name="ColRangeTo" Binding="{Binding To}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
