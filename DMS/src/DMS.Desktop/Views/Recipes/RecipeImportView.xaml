<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DMS.Desktop.Views.Recipes.RecipeImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TxtTitle" Text="REC04 — Import receptur"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>
            <TextBlock x:Name="TxtSubtitle"
                       Margin="0,5,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1">
            <TabItem x:Name="TabSpray" Header="Laky / postřik">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="BtnLoadSpray" Width="150" Margin="0,0,8,0" Click="BtnLoadSpray_Click"/>
                        <Button x:Name="BtnSaveSpray" Width="140" Margin="0,0,8,0" Click="BtnSaveSpray_Click" IsEnabled="False"/>
                        <Button x:Name="BtnExportSpray" Width="140" Click="BtnExportSpray_Click" IsEnabled="False"/>
                    </StackPanel>

                    <Border Grid.Row="1" Padding="10" Margin="0,0,0,10" CornerRadius="6"
                            BorderThickness="1" BorderBrush="{DynamicResource DmsBorderBrush}"
                            Background="{DynamicResource DmsBackgroundBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/><ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="100"/><ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="90"/><ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblSprayArticle" Grid.Column="0" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtSprayArticle" Grid.Column="1"/>
                            <TextBlock x:Name="LblSprayHd" Grid.Column="2" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtSprayHd" Grid.Column="3"/>
                            <TextBlock x:Name="LblSprayColor" Grid.Column="4" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtSprayColor" Grid.Column="5"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid x:Name="GridSprayLayers" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserResizeColumns="True" CanUserReorderColumns="True"
                                  SelectionChanged="GridSprayLayers_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColSprayLayer" Binding="{Binding LayerCode}" Width="75" MinWidth="70"/>
                                <DataGridTextColumn x:Name="ColSprayKText" Binding="{Binding KText}" Width="*" MinWidth="155"/>
                                <DataGridTextColumn x:Name="ColSprayType" Binding="{Binding TypeText}" Width="75" MinWidth="70"/>
                                <DataGridTextColumn x:Name="ColSprayItems" Binding="{Binding ComponentCount}" Width="70" MinWidth="65"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="GridSprayComponents" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      CanUserResizeColumns="True" CanUserReorderColumns="True"
                                      SelectionChanged="GridComponents_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColSourceTextS" Binding="{Binding SourceText}" Width="1.2*" MinWidth="180"/>
                                    <DataGridTextColumn x:Name="ColSourceGramsS" Binding="{Binding SourceQuantityText}" Width="95" MinWidth="85"/>
                                    <DataGridTextColumn x:Name="ColBomGramsS" Binding="{Binding BomGrams, StringFormat=0.000000}" Width="120" MinWidth="105"/>
                                    <DataGridTextColumn x:Name="ColSapNumberS" Binding="{Binding SapMaterialNumber}" Width="135" MinWidth="120"/>
                                    <DataGridTextColumn x:Name="ColSapTextS" Binding="{Binding SapDescription}" Width="2*" MinWidth="220"/>
                                    <DataGridTextColumn x:Name="ColMatchS" Binding="{Binding MatchScoreText}" Width="80" MinWidth="75"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBox x:Name="TxtSprayTexts" Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True"
                                     TextWrapping="Wrap" MinHeight="55"/>
                        </Grid>
                    </Grid>

                    <ContentControl Grid.Row="3" x:Name="SprayAssignmentHost" Margin="0,10,0,0"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabScreen" Header="Barvy / sítotisk">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="BtnLoadScreen" Width="150" Margin="0,0,8,0" Click="BtnLoadScreen_Click"/>
                        <Button x:Name="BtnSaveScreen" Width="140" Margin="0,0,8,0" Click="BtnSaveScreen_Click" IsEnabled="False"/>
                        <Button x:Name="BtnExportScreen" Width="140" Click="BtnExportScreen_Click" IsEnabled="False"/>
                    </StackPanel>

                    <Border Grid.Row="1" Padding="10" Margin="0,0,0,10" CornerRadius="6"
                            BorderThickness="1" BorderBrush="{DynamicResource DmsBorderBrush}"
                            Background="{DynamicResource DmsBackgroundBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/><ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="100"/><ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="140"/><ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblRecipeNumber" Grid.Column="0" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtRecipeNumber" Grid.Column="1"/>
                            <TextBlock x:Name="LblRecipeKText" Grid.Column="2" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtRecipeKText" Grid.Column="3"/>
                            <TextBlock x:Name="LblRecipeTotal" Grid.Column="4" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtRecipeTotal" Grid.Column="5"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="GridScreenComponents" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="2"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserResizeColumns="True" CanUserReorderColumns="True"
                              SelectionChanged="GridComponents_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColSourceTextP" Binding="{Binding SourceText}" Width="1.1*" MinWidth="170"/>
                            <DataGridTextColumn x:Name="ColSourceGramsP" Binding="{Binding SourceQuantityText}" Width="90" MinWidth="85"/>
                            <DataGridTextColumn x:Name="ColBomGramsP" Binding="{Binding BomGrams, StringFormat=0.000000}" Width="115" MinWidth="105"/>
                            <DataGridTextColumn x:Name="ColSapNumberP" Binding="{Binding SapMaterialNumber}" Width="135" MinWidth="120"/>
                            <DataGridTextColumn x:Name="ColSapTextP" Binding="{Binding SapDescription}" Width="1.7*" MinWidth="200"/>
                            <DataGridTextColumn x:Name="ColMatchP" Binding="{Binding MatchScoreText}" Width="80" MinWidth="75"/>
                            <DataGridCheckBoxColumn x:Name="ColHardenerP" Binding="{Binding IsHardener}" Width="85" MinWidth="80"/>
                            <DataGridTextColumn x:Name="ColHardenerStatusP" Binding="{Binding HardenerStatus}" Width="135" MinWidth="120"/>
                            <DataGridTextColumn x:Name="ColRuleP" Binding="{Binding GeneratedByRule}" Width="1.2*" MinWidth="160"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock x:Name="TxtScreenWarnings" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                        <ContentControl x:Name="ScreenAssignmentHost"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabSettings" Header="Nastavení">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/><ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="190"/><ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblComponentPrefix" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBox x:Name="TxtComponentPrefix" Grid.Row="0" Grid.Column="1" Margin="0,0,12,0"/>
                        <TextBlock x:Name="LblMatchThreshold" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBox x:Name="TxtMatchThreshold" Grid.Row="0" Grid.Column="3"/>

                        <CheckBox x:Name="ChkAddMissingHardener"
                                  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                  Margin="0,10,12,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblHardenerTolerance"
                                   Grid.Row="1" Grid.Column="2"
                                   Margin="0,10,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBox x:Name="TxtHardenerTolerance"
                                 Grid.Row="1" Grid.Column="3"
                                 Margin="0,10,0,0"/>
                    </Grid>

                    <GroupBox x:Name="GroupHardenerRules" Grid.Row="1" Margin="0,0,0,10">
                        <Grid Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid x:Name="GridHardenerRules" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutoGenerateColumns="False" CanUserAddRows="True"
                                      CanUserResizeColumns="True" CanUserReorderColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColRuleFamily" Binding="{Binding Family}" Width="1*" MinWidth="140"/>
                                    <DataGridTextColumn x:Name="ColRuleRatio" Binding="{Binding RatioPercent}" Width="140" MinWidth="125"/>
                                    <DataGridTextColumn x:Name="ColRuleHardener" Binding="{Binding HardenerText}" Width="2*" MinWidth="220"/>
                                    <DataGridCheckBoxColumn x:Name="ColRuleActive" Binding="{Binding IsActive}" Width="100" MinWidth="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button x:Name="BtnDeleteRule" Grid.Row="1" Width="150" Margin="0,8,0,0" HorizontalAlignment="Left" Click="BtnDeleteRule_Click"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox x:Name="GroupAliases" Grid.Row="2" Margin="0,0,0,10">
                        <Grid Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid x:Name="GridAliases" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserResizeColumns="True" CanUserReorderColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColAliasSource" Binding="{Binding SourceText}" Width="1.2*" MinWidth="220"/>
                                    <DataGridTextColumn x:Name="ColAliasSap" Binding="{Binding MaterialNumber}" Width="160" MinWidth="140"/>
                                    <DataGridTextColumn x:Name="ColAliasText" Binding="{Binding SapDescription}" Width="2*" MinWidth="260"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button x:Name="BtnDeleteAlias" Grid.Row="1" Width="150" Margin="0,8,0,0" HorizontalAlignment="Left" Click="BtnDeleteAlias_Click"/>
                        </Grid>
                    </GroupBox>

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button x:Name="BtnSaveSettings" Width="150" Margin="0,0,8,0" Click="BtnSaveSettings_Click"/>
                        <TextBlock x:Name="TxtSettingsStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
