<UserControl x:Class="DMS.Desktop.Views.QualityOrders.QualityOrderPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">
    <UserControl.Resources>
        <Style x:Key="QOPickerFilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Foreground" Value="{DynamicResource DmsMutedForegroundBrush}"/>
        </Style>

        <Style x:Key="QOPickerFilterTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="QOPickerColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0,6,0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QOPickerCellTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TxtTitle"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,4"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>
            <TextBlock x:Name="TxtHint"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,10"
                BorderThickness="1"
                Background="{DynamicResource DmsBackgroundBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}">
            <WrapPanel>
                <StackPanel Width="160" Margin="0,0,8,8">
                    <TextBlock x:Name="LblFilterOrder" Style="{StaticResource QOPickerFilterLabelStyle}"/>
                    <TextBox x:Name="TxtFilterOrder"
                             Style="{StaticResource QOPickerFilterTextBoxStyle}"
                             TextChanged="FilterChanged"/>
                </StackPanel>

                <StackPanel Width="220" Margin="0,0,8,8">
                    <TextBlock x:Name="LblFilterPrintVersion" Style="{StaticResource QOPickerFilterLabelStyle}"/>
                    <TextBox x:Name="TxtFilterPrintVersion"
                             Style="{StaticResource QOPickerFilterTextBoxStyle}"
                             TextChanged="FilterChanged"/>
                </StackPanel>

                <StackPanel Width="360" Margin="0,0,8,8">
                    <TextBlock x:Name="LblFilterText" Style="{StaticResource QOPickerFilterLabelStyle}"/>
                    <TextBox x:Name="TxtFilterText"
                             Style="{StaticResource QOPickerFilterTextBoxStyle}"
                             TextChanged="FilterChanged"/>
                </StackPanel>

                <Button x:Name="BtnRefresh"
                        Margin="12,18,0,8"
                        MinWidth="110"
                        Height="32"
                        Click="BtnRefresh_Click"
                        Style="{StaticResource DmsFormButtonStyle}"/>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="GridOrders"
                  Grid.Row="2"
                  Style="{StaticResource DmsDataGridStyle}"
                  RowStyle="{StaticResource DmsDataGridRowStyle}"
                  ColumnHeaderStyle="{StaticResource QOPickerColumnHeaderStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  MinColumnWidth="48"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  MouseDoubleClick="GridOrders_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="ColScheduleLight" Width="44" MinWidth="44" MaxWidth="44">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="16"
                                     Height="16"
                                     Stroke="{DynamicResource DmsBorderBrush}"
                                     StrokeThickness="1"
                                     HorizontalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#E53935"/>
                                        <Setter Property="ToolTip" Value="{Binding ScheduleStatusText}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScheduleStatusCode}" Value="Scheduled">
                                                <Setter Property="Fill" Value="#F5A623"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ScheduleStatusCode}" Value="Finished">
                                                <Setter Property="Fill" Value="#2ECC71"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="ColReleaseIcon" Width="48" MinWidth="48" MaxWidth="48">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⊘"/>
                                        <Setter Property="Foreground" Value="#E53935"/>
                                        <Setter Property="ToolTip" Value="{Binding ReleasedText}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReleaseStatusCode}" Value="Released">
                                                <Setter Property="Text" Value="✓"/>
                                                <Setter Property="Foreground" Value="#2ECC71"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn x:Name="ColOrder" Binding="{Binding OrderNumber}" Width="95" MinWidth="90" ElementStyle="{StaticResource QOPickerCellTextBlockStyle}"/>
                <DataGridTextColumn x:Name="ColPrintVersion" Binding="{Binding PrintVersionNumber}" Width="175" MinWidth="160" ElementStyle="{StaticResource QOPickerCellTextBlockStyle}"/>
                <DataGridTextColumn x:Name="ColSap" Binding="{Binding SapMaterialNumber}" Width="115" MinWidth="105" ElementStyle="{StaticResource QOPickerCellTextBlockStyle}"/>
                <DataGridTextColumn x:Name="ColCustomer" Binding="{Binding Customer}" Width="150" MinWidth="130" ElementStyle="{StaticResource QOPickerCellTextBlockStyle}"/>
                <DataGridTextColumn x:Name="ColMachine" Binding="{Binding Machine}" Width="130" MinWidth="110" ElementStyle="{StaticResource QOPickerCellTextBlockStyle}"/>
                <DataGridTextColumn x:Name="ColStatus" Binding="{Binding ScheduleStatusText}" Width="125" MinWidth="110" ElementStyle="{StaticResource QOPickerCellTextBlockStyle}"/>
                <DataGridTextColumn x:Name="ColNotes" Binding="{Binding Notes}" Width="360" MinWidth="260" ElementStyle="{StaticResource QOPickerCellTextBlockStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="TxtCount"
                   Grid.Row="3"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
    </Grid>
</UserControl>
