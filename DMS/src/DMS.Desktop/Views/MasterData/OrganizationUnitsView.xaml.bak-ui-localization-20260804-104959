<UserControl x:Class="DMS.Desktop.Views.MasterData.OrganizationUnitsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12">
  <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Padding="12" BorderThickness="1" CornerRadius="8" Background="{DynamicResource DmsPanelBrush}" BorderBrush="{DynamicResource DmsBorderBrush}">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="Organizační struktura" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource DmsForegroundBrush}"/><CheckBox x:Name="ChkShowInactive" Content="Zobrazit neaktivní" Margin="0,8,0,8" Foreground="{DynamicResource DmsForegroundBrush}" Checked="FilterChanged" Unchecked="FilterChanged"/></StackPanel>
    <TreeView x:Name="TreeUnits" SelectedItemChanged="TreeUnits_SelectedItemChanged" Background="{DynamicResource DmsBackgroundBrush}" Foreground="{DynamicResource DmsForegroundBrush}">
     <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}"><TextBlock Text="{Binding DisplayText}"/></HierarchicalDataTemplate></TreeView.ItemTemplate>
    </TreeView>
   </DockPanel>
  </Border>
  <Border Grid.Column="2" Padding="16" BorderThickness="1" CornerRadius="8" Background="{DynamicResource DmsPanelBrush}" BorderBrush="{DynamicResource DmsBorderBrush}">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Detail organizační jednotky" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource DmsForegroundBrush}" Margin="0,0,0,12"/>
    <Grid Grid.Row="1" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Kód" Foreground="{DynamicResource DmsMutedForegroundBrush}"/><TextBox x:Name="TxtCode" Grid.Column="1"/></Grid>
    <Grid Grid.Row="2" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Název" Foreground="{DynamicResource DmsMutedForegroundBrush}"/><TextBox x:Name="TxtName" Grid.Column="1"/></Grid>
    <Grid Grid.Row="3" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Externí kód" Foreground="{DynamicResource DmsMutedForegroundBrush}"/><TextBox x:Name="TxtExternalCode" Grid.Column="1"/></Grid>
    <Grid Grid.Row="4" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Pořadí" Foreground="{DynamicResource DmsMutedForegroundBrush}"/><TextBox x:Name="TxtSortOrder" Grid.Column="1"/></Grid>
    <Grid Grid.Row="5" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Popis" Foreground="{DynamicResource DmsMutedForegroundBrush}"/><TextBox x:Name="TxtDescription" Grid.Column="1" AcceptsReturn="True" Height="90" TextWrapping="Wrap"/><CheckBox x:Name="ChkActive" Grid.Column="1" Content="Aktivní" VerticalAlignment="Bottom" Margin="0,0,0,-28" Foreground="{DynamicResource DmsForegroundBrush}"/></Grid>
    <TextBlock x:Name="TxtStatus" Grid.Row="6" Margin="0,45,0,8" TextWrapping="Wrap" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
    <WrapPanel Grid.Row="7"><Button Content="Přidat kořen" Click="AddRoot_Click" Margin="0,0,8,0"/><Button Content="Přidat podřízenou" Click="AddChild_Click" Margin="0,0,8,0"/><Button Content="Uložit" Click="Save_Click" Margin="0,0,8,0"/><Button Content="Deaktivovat / aktivovat" Click="ToggleActive_Click"/></WrapPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
