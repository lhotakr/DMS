<UserControl x:Class="DMS.Desktop.Views.MasterData.UnitsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Padding="12" BorderThickness="1" CornerRadius="8" BorderBrush="{DynamicResource DmsBorderBrush}" Background="{DynamicResource DmsPanelBrush}"><DockPanel><Button DockPanel.Dock="Bottom" Content="Přidat veličinu" Click="AddDimension_Click" Margin="0,8,0,0"/><ListBox x:Name="ListDimensions" DisplayMemberPath="Name" SelectionChanged="DimensionChanged" Background="{DynamicResource DmsBackgroundBrush}" Foreground="{DynamicResource DmsForegroundBrush}"/></DockPanel></Border>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DataGrid x:Name="GridUnits" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="True" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource DmsBackgroundBrush}" Foreground="{DynamicResource DmsForegroundBrush}"><DataGrid.Columns><DataGridTextColumn Header="Kód" Binding="{Binding Code}" Width="100"/><DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="90"/><DataGridTextColumn Header="Název" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="Násobek k základu" Binding="{Binding ScaleToBase}" Width="150"/><DataGridTextColumn Header="Posun" Binding="{Binding OffsetToBase}" Width="100"/><DataGridTextColumn Header="Desetinná místa" Binding="{Binding DecimalPlaces}" Width="120"/><DataGridCheckBoxColumn Header="Výchozí" Binding="{Binding IsDefault}" Width="80"/><DataGridCheckBoxColumn Header="Aktivní" Binding="{Binding IsActive}" Width="70"/></DataGrid.Columns></DataGrid>
   <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" BorderThickness="1" CornerRadius="8" BorderBrush="{DynamicResource DmsBorderBrush}" Background="{DynamicResource DmsPanelBrush}"><StackPanel><TextBlock Text="Zkušební přepočet" FontWeight="Bold" FontSize="18"/><WrapPanel Margin="0,8,0,0"><TextBox x:Name="TxtValue" Width="100" Text="2,5"/><ComboBox x:Name="CmbSource" Width="130" Margin="6,0" DisplayMemberPath="Symbol"/><TextBlock Text="→" FontSize="20" VerticalAlignment="Center"/><ComboBox x:Name="CmbTarget" Width="130" Margin="6,0" DisplayMemberPath="Symbol"/><Button Content="Přepočítat" Click="Convert_Click"/><TextBlock x:Name="TxtResult" Margin="14,4,0,0" FontWeight="Bold" Foreground="{DynamicResource DmsForegroundBrush}"/></WrapPanel><WrapPanel Margin="0,10,0,0"><Button Content="Uložit jednotky" Click="Save_Click" Margin="0,0,8,0"/><TextBlock x:Name="TxtStatus" Margin="8,4,0,0" Foreground="{DynamicResource DmsMutedForegroundBrush}"/></WrapPanel></StackPanel></Border>
  </Grid>
 </Grid>
</UserControl>
