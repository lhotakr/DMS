<UserControl x:Class="DMS.Desktop.Views.MasterData.UnitsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="240"/>
   <ColumnDefinition Width="12"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <Border Grid.Column="0" Padding="12" BorderThickness="1" CornerRadius="8"
          BorderBrush="{DynamicResource DmsBorderBrush}" Background="{DynamicResource DmsPanelBrush}">
   <DockPanel>
    <Button x:Name="BtnAddDimension" DockPanel.Dock="Bottom" Click="AddDimension_Click" Margin="0,10,0,0"/>
    <TextBlock x:Name="TxtDimensionsTitle" DockPanel.Dock="Top" Margin="0,0,0,8"
               FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DmsForegroundBrush}"/>
    <ListBox x:Name="ListDimensions" SelectionChanged="DimensionChanged"
             Background="{DynamicResource DmsBackgroundBrush}" Foreground="{DynamicResource DmsForegroundBrush}">
     <ListBox.ItemTemplate>
      <DataTemplate>
       <StackPanel Margin="4,3">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Code}" FontSize="11" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
       </StackPanel>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>

  <Grid Grid.Column="2">
   <Grid.RowDefinitions>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <DataGrid x:Name="GridUnits" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="False"
             CanUserAddRows="True" HorizontalScrollBarVisibility="Auto"
             Background="{DynamicResource DmsBackgroundBrush}" Foreground="{DynamicResource DmsForegroundBrush}">
    <DataGrid.Columns>
     <DataGridTextColumn x:Name="ColCode" Binding="{Binding Code}" Width="105" MinWidth="90"/>
     <DataGridTextColumn x:Name="ColSymbol" Binding="{Binding Symbol}" Width="100" MinWidth="80"/>
     <DataGridTextColumn x:Name="ColName" Binding="{Binding Name}" Width="220" MinWidth="160"/>
     <DataGridTextColumn x:Name="ColScale" Binding="{Binding ScaleToBase}" Width="170" MinWidth="140"/>
     <DataGridTextColumn x:Name="ColOffset" Binding="{Binding OffsetToBase}" Width="110" MinWidth="90"/>
     <DataGridTextColumn x:Name="ColDecimals" Binding="{Binding DecimalPlaces}" Width="135" MinWidth="110"/>
     <DataGridCheckBoxColumn x:Name="ColDefault" Binding="{Binding IsDefault}" Width="90"/>
     <DataGridCheckBoxColumn x:Name="ColActive" Binding="{Binding IsActive}" Width="85"/>
    </DataGrid.Columns>
   </DataGrid>

   <Border Grid.Row="1" Margin="0,12,0,0" Padding="14" BorderThickness="1" CornerRadius="8"
           BorderBrush="{DynamicResource DmsBorderBrush}" Background="{DynamicResource DmsPanelBrush}">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>

     <TextBlock x:Name="TxtConverterTitle" Grid.Row="0" FontWeight="Bold" FontSize="18"
                Foreground="{DynamicResource DmsForegroundBrush}"/>

     <Grid Grid.Row="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="125"/>
       <ColumnDefinition Width="155"/>
       <ColumnDefinition Width="40"/>
       <ColumnDefinition Width="155"/>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="TxtValue" Grid.Column="0" Text="2,5" VerticalContentAlignment="Center"/>
      <ComboBox x:Name="CmbSource" Grid.Column="1" Margin="8,0,0,0">
       <ComboBox.ItemTemplate>
        <DataTemplate><TextBlock Text="{Binding DisplayText}"/></DataTemplate>
       </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Column="2" Text="→" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <ComboBox x:Name="CmbTarget" Grid.Column="3">
       <ComboBox.ItemTemplate>
        <DataTemplate><TextBlock Text="{Binding DisplayText}"/></DataTemplate>
       </ComboBox.ItemTemplate>
      </ComboBox>
      <Button x:Name="BtnConvert" Grid.Column="4" Margin="8,0,0,0" Click="Convert_Click" MinWidth="110"/>
      <TextBlock x:Name="TxtResult" Grid.Column="5" Margin="16,5,0,0" FontWeight="Bold"
                 Foreground="{DynamicResource DmsForegroundBrush}"/>
     </Grid>

     <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="BtnSave" Grid.Column="0" Click="Save_Click" MinWidth="130"/>
      <TextBlock x:Name="TxtStatus" Grid.Column="1" Margin="14,5,0,0" TextWrapping="Wrap"
                 Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
     </Grid>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
