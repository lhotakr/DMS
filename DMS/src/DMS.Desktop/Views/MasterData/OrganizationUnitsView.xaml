<UserControl x:Class="DMS.Desktop.Views.MasterData.OrganizationUnitsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="2*" MinWidth="360"/>
   <ColumnDefinition Width="12"/>
   <ColumnDefinition Width="3*" MinWidth="520"/>
  </Grid.ColumnDefinitions>

  <Border Grid.Column="0" Padding="12" BorderThickness="1" CornerRadius="8"
          Background="{DynamicResource DmsPanelBrush}" BorderBrush="{DynamicResource DmsBorderBrush}">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock x:Name="TxtTreeTitle" FontSize="20" FontWeight="Bold"
                Foreground="{DynamicResource DmsForegroundBrush}"/>
     <CheckBox x:Name="ChkShowInactive" Margin="0,8,0,10"
               Foreground="{DynamicResource DmsForegroundBrush}"
               Checked="FilterChanged" Unchecked="FilterChanged"/>
    </StackPanel>
    <TreeView x:Name="TreeUnits" SelectedItemChanged="TreeUnits_SelectedItemChanged"
              Background="{DynamicResource DmsBackgroundBrush}"
              Foreground="{DynamicResource DmsForegroundBrush}">
     <TreeView.ItemTemplate>
      <HierarchicalDataTemplate ItemsSource="{Binding Children}">
       <TextBlock Text="{Binding DisplayText}"/>
      </HierarchicalDataTemplate>
     </TreeView.ItemTemplate>
    </TreeView>
   </DockPanel>
  </Border>

  <Border Grid.Column="2" Padding="16" BorderThickness="1" CornerRadius="8"
          Background="{DynamicResource DmsPanelBrush}" BorderBrush="{DynamicResource DmsBorderBrush}">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="TxtDetailTitle" Grid.Row="0" FontSize="20" FontWeight="Bold"
               Foreground="{DynamicResource DmsForegroundBrush}" Margin="0,0,0,14"/>

    <Grid Grid.Row="1" Margin="0,4">
     <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="TxtCodeLabel" VerticalAlignment="Center" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
     <TextBox x:Name="TxtCode" Grid.Column="1"/>
    </Grid>

    <Grid Grid.Row="2" Margin="0,4">
     <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="TxtNameLabel" VerticalAlignment="Center" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
     <TextBox x:Name="TxtName" Grid.Column="1"/>
    </Grid>

    <Grid Grid.Row="3" Margin="0,4">
     <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="TxtExternalCodeLabel" VerticalAlignment="Center" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
     <TextBox x:Name="TxtExternalCode" Grid.Column="1"/>
    </Grid>

    <Grid Grid.Row="4" Margin="0,4">
     <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="TxtSortOrderLabel" VerticalAlignment="Center" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
     <TextBox x:Name="TxtSortOrder" Grid.Column="1" Width="140" HorizontalAlignment="Left"/>
    </Grid>

    <Grid Grid.Row="5" Margin="0,4">
     <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="TxtDescriptionLabel" VerticalAlignment="Top" Margin="0,5,0,0"
                Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
     <TextBox x:Name="TxtDescription" Grid.Column="1" AcceptsReturn="True" MinHeight="95"
              TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    </Grid>

    <CheckBox x:Name="ChkActive" Grid.Row="6" Margin="170,10,0,0"
              Foreground="{DynamicResource DmsForegroundBrush}"/>

    <TextBlock x:Name="TxtStatus" Grid.Row="7" Margin="0,18,0,10" TextWrapping="Wrap"
               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

    <WrapPanel Grid.Row="8">
     <Button x:Name="BtnAddRoot" Click="AddRoot_Click" Margin="0,0,8,0" MinWidth="120"/>
     <Button x:Name="BtnAddChild" Click="AddChild_Click" Margin="0,0,8,0" MinWidth="150"/>
     <Button x:Name="BtnSave" Click="Save_Click" Margin="0,0,8,0" MinWidth="100"/>
     <Button x:Name="BtnToggleActive" Click="ToggleActive_Click" MinWidth="165"/>
    </WrapPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
