<UserControl x:Class="DMS.Desktop.Views.Framework.FrameworkPerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="26"
                       FontWeight="Bold"/>
            <TextBlock x:Name="SubtitleText"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Opacity="0.85"/>
        </StackPanel>

        <WrapPanel Grid.Row="1"
                   Margin="0,16,0,12">
            <Button x:Name="RefreshButton"
                    Click="RefreshButton_Click"
                    MinWidth="125"
                    Padding="14,8"
                    Margin="0,0,8,0"/>
            <Button x:Name="ClearButton"
                    Click="ClearButton_Click"
                    MinWidth="145"
                    Padding="14,8"
                    Margin="0,0,8,0"/>
            <Button x:Name="ExportCsvButton"
                    Click="ExportCsvButton_Click"
                    MinWidth="125"
                    Padding="14,8"
                    Margin="0,0,8,0"/>
            <Button x:Name="ExportJsonButton"
                    Click="ExportJsonButton_Click"
                    MinWidth="125"
                    Padding="14,8"
                    Margin="0,0,8,0"/>
            <Button x:Name="GcButton"
                    Click="GcButton_Click"
                    MinWidth="125"
                    Padding="14,8"
                    Margin="0,0,8,0"/>
            <Button x:Name="LogButton"
                    Click="LogButton_Click"
                    MinWidth="125"
                    Padding="14,8"/>
        </WrapPanel>

        <UniformGrid Grid.Row="2"
                     Columns="6"
                     Margin="0,0,0,12">
            <Border Margin="0,0,8,0"
                    Padding="10"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock x:Name="CpuLabel" Opacity="0.75"/>
                    <TextBlock x:Name="CpuValue" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Margin="0,0,8,0"
                    Padding="10"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock x:Name="MemoryLabel" Opacity="0.75"/>
                    <TextBlock x:Name="MemoryValue" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Margin="0,0,8,0"
                    Padding="10"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock x:Name="ManagedLabel" Opacity="0.75"/>
                    <TextBlock x:Name="ManagedValue" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Margin="0,0,8,0"
                    Padding="10"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock x:Name="FpsLabel" Opacity="0.75"/>
                    <TextBlock x:Name="FpsValue" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Margin="0,0,8,0"
                    Padding="10"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock x:Name="DelayLabel" Opacity="0.75"/>
                    <TextBlock x:Name="DelayValue" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Padding="10"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock x:Name="GcLabel" Opacity="0.75"/>
                    <TextBlock x:Name="GcValue" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="8"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <TextBlock x:Name="CpuChartLabel"
                               VerticalAlignment="Top"
                               FontWeight="SemiBold"/>
                    <Canvas x:Name="CpuCanvas"
                            Margin="0,24,0,0"
                            ClipToBounds="True">
                        <Polyline x:Name="CpuLine"
                                  Stroke="{DynamicResource DmsAccentBrush}"
                                  StrokeThickness="2"/>
                    </Canvas>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="8"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <TextBlock x:Name="MemoryChartLabel"
                               VerticalAlignment="Top"
                               FontWeight="SemiBold"/>
                    <Canvas x:Name="MemoryCanvas"
                            Margin="0,24,0,0"
                            ClipToBounds="True">
                        <Polyline x:Name="MemoryLine"
                                  Stroke="{DynamicResource DmsAccentBrush}"
                                  StrokeThickness="2"/>
                    </Canvas>
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    Padding="8"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <TextBlock x:Name="FpsChartLabel"
                               VerticalAlignment="Top"
                               FontWeight="SemiBold"/>
                    <Canvas x:Name="FpsCanvas"
                            Margin="0,24,0,0"
                            ClipToBounds="True">
                        <Polyline x:Name="FpsLine"
                                  Stroke="{DynamicResource DmsAccentBrush}"
                                  StrokeThickness="2"/>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="TransactionSummaryGrid"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn CanUserResize="True" x:Name="TransactionColumn"
                                        Binding="{Binding TransactionCode}"
                                        Width="120"/>
                    <DataGridTextColumn CanUserResize="True" x:Name="CountColumn"
                                        Binding="{Binding Count}"
                                        Width="80"/>
                    <DataGridTextColumn CanUserResize="True" x:Name="AverageColumn"
                                        Binding="{Binding AverageText}"
                                        Width="110"/>
                    <DataGridTextColumn CanUserResize="True" x:Name="P95Column"
                                        Binding="{Binding P95Text}"
                                        Width="110"/>
                    <DataGridTextColumn CanUserResize="True" x:Name="MaximumColumn"
                                        Binding="{Binding MaximumText}"
                                        Width="110"/>
                    <DataGridTextColumn CanUserResize="True" x:Name="FailureColumn"
                                        Binding="{Binding Failures}"
                                        Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid x:Name="RecentGrid"
                      Grid.Column="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn CanUserResize="True" x:Name="TimeColumn"
                                        Binding="{Binding TimestampText}"
                                        Width="115"/>
                    <DataGridTextColumn CanUserResize="True" x:Name="RecentTransactionColumn"
                                        Binding="{Binding TransactionCode}"
                                        Width="120"/>
                    <DataGridTextColumn CanUserResize="True" x:Name="DurationColumn"
                                        Binding="{Binding DurationText}"
                                        Width="120"/>
                    <DataGridTextColumn CanUserResize="True" x:Name="ResultColumn"
                                        Binding="{Binding Result}"
                                        Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <DataGrid x:Name="JsonGrid"
                  Grid.Row="5"
                  Margin="0,12,0,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn CanUserResize="True" x:Name="JsonFileColumn"
                                    Binding="{Binding FileName}"
                                    Width="180"/>
                <DataGridTextColumn CanUserResize="True" x:Name="JsonSizeColumn"
                                    Binding="{Binding SizeText}"
                                    Width="110"/>
                <DataGridTextColumn CanUserResize="True" x:Name="JsonLoadColumn"
                                    Binding="{Binding LoadText}"
                                    Width="110"/>
                <DataGridTextColumn CanUserResize="True" x:Name="JsonRootColumn"
                                    Binding="{Binding RootType}"
                                    Width="120"/>
                <DataGridTextColumn CanUserResize="True" x:Name="JsonStatusColumn"
                                    Binding="{Binding Status}"
                                    Width="100"/>
                <DataGridTextColumn CanUserResize="True" x:Name="JsonPathColumn"
                                    Binding="{Binding Path}"
                                    Width="2*"
                                    MinWidth="300"/>
                <DataGridTextColumn CanUserResize="True" x:Name="JsonErrorColumn"
                                    Binding="{Binding Error}"
                                    Width="2*"
                                    MinWidth="220"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="FooterText"
                   Grid.Row="6"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Opacity="0.75"/>
    </Grid>
</UserControl>
