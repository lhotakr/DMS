<UserControl x:Class="DMS.Desktop.Views.Framework.FrameworkMasterDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="26"
                       FontWeight="Bold"/>
            <TextBlock x:Name="SubtitleText"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Opacity="0.85"/>
        </StackPanel>

        <WrapPanel Grid.Row="1"
                   Margin="0,16,0,12">
            <Button x:Name="ReloadButton"
                    Click="ReloadButton_Click"
                    MinWidth="130"
                    Padding="14,8"
                    Margin="0,0,8,0"/>
            <Button x:Name="Sys01Button"
                    Click="Sys01Button_Click"
                    MinWidth="135"
                    Padding="14,8"
                    Margin="0,0,8,0"/>
            <Button x:Name="UsersButton"
                    Click="UsersButton_Click"
                    MinWidth="135"
                    Padding="14,8"
                    Margin="0,0,8,0"/>
            <Button x:Name="CopyButton"
                    Click="CopyButton_Click"
                    MinWidth="145"
                    Padding="14,8"/>
        </WrapPanel>

        <UniformGrid Grid.Row="2"
                     Columns="5"
                     Margin="0,0,0,12">
            <Border Margin="0,0,8,0"
                    Padding="10"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock x:Name="OrganizationsLabel" Opacity="0.75"/>
                    <TextBlock x:Name="OrganizationsValue" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Margin="0,0,8,0"
                    Padding="10"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock x:Name="PeopleLabel" Opacity="0.75"/>
                    <TextBlock x:Name="PeopleValue" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Margin="0,0,8,0"
                    Padding="10"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock x:Name="DimensionsLabel" Opacity="0.75"/>
                    <TextBlock x:Name="DimensionsValue" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Margin="0,0,8,0"
                    Padding="10"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock x:Name="UnitsLabel" Opacity="0.75"/>
                    <TextBlock x:Name="UnitsValue" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Padding="10"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock x:Name="HealthLabel" Opacity="0.75"/>
                    <TextBlock x:Name="HealthValue" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <DataGrid x:Name="RegistryGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="EntityColumn"
                                    CanUserResize="True"
                                    Binding="{Binding Code}"
                                    Width="160"/>
                <DataGridTextColumn x:Name="EntityNameColumn"
                                    CanUserResize="True"
                                    Binding="{Binding Name}"
                                    Width="210"/>
                <DataGridTextColumn x:Name="FileColumn"
                                    CanUserResize="True"
                                    Binding="{Binding FileName}"
                                    Width="190"/>
                <DataGridTextColumn x:Name="CountColumn"
                                    CanUserResize="True"
                                    Binding="{Binding Count}"
                                    Width="90"/>
                <DataGridTextColumn x:Name="ActiveColumn"
                                    CanUserResize="True"
                                    Binding="{Binding Active}"
                                    Width="90"/>
                <DataGridTextColumn x:Name="KeyColumn"
                                    CanUserResize="True"
                                    Binding="{Binding KeyField}"
                                    Width="190"/>
                <DataGridTextColumn x:Name="DependenciesColumn"
                                    CanUserResize="True"
                                    Binding="{Binding Dependencies}"
                                    Width="190"/>
                <DataGridTextColumn x:Name="PathColumn"
                                    CanUserResize="True"
                                    Binding="{Binding Path}"
                                    Width="2*"
                                    MinWidth="280"/>
                <DataGridTextColumn x:Name="DescriptionColumn"
                                    CanUserResize="True"
                                    Binding="{Binding Description}"
                                    Width="2*"
                                    MinWidth="280"/>
            </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="HealthGrid"
                  Grid.Row="4"
                  Margin="0,12,0,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="SeverityColumn"
                                    CanUserResize="True"
                                    Binding="{Binding Severity}"
                                    Width="110"/>
                <DataGridTextColumn x:Name="AreaColumn"
                                    CanUserResize="True"
                                    Binding="{Binding Area}"
                                    Width="150"/>
                <DataGridTextColumn x:Name="CheckColumn"
                                    CanUserResize="True"
                                    Binding="{Binding Check}"
                                    Width="300"/>
                <DataGridTextColumn x:Name="DetailsColumn"
                                    CanUserResize="True"
                                    Binding="{Binding Details}"
                                    Width="2*"
                                    MinWidth="420"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="FooterText"
                   Grid.Row="5"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Opacity="0.75"/>
    </Grid>
</UserControl>
