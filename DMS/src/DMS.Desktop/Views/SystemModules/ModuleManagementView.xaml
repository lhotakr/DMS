<UserControl x:Class="DMS.Desktop.Views.SystemModules.ModuleManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="0">

            <TextBlock Text="SYS13 - Správa modulů"
                       Style="{StaticResource DmsTitleTextStyle}"/>

            <Border Style="{StaticResource DmsCardBorderStyle}"
                    Margin="0,0,0,12">

                <StackPanel>

                    <TextBlock Text="Moduly DMS"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Moduly určují členění transakcí v levém menu. Název modulu se používá v transactions.json."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"
                               Margin="0,0,0,12"/>

                    <DataGrid x:Name="GridModules"
                              Style="{StaticResource DmsDataGridStyle}"
                              RowStyle="{StaticResource DmsEditableGridRowStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="True"
                              MinHeight="420"
                              Margin="0,0,0,12">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Kód"
                                                Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                                Width="180"
                                                MinWidth="150"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                EditingElementStyle="{StaticResource DmsDataGridTextBoxEditingStyle}"/>

                            <DataGridTextColumn Header="Název"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                Width="220"
                                                MinWidth="180"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                EditingElementStyle="{StaticResource DmsDataGridTextBoxEditingStyle}"/>

                            <DataGridTextColumn Header="Popis"
                                                Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"
                                                MinWidth="360"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                EditingElementStyle="{StaticResource DmsDataGridTextBoxEditingStyle}"/>

                            <DataGridTextColumn Header="Pořadí"
                                                Binding="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged}"
                                                Width="90"
                                                MinWidth="80"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                EditingElementStyle="{StaticResource DmsDataGridTextBoxEditingStyle}"/>

                            <DataGridCheckBoxColumn Header="Aktivní"
                                                    Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    EditingElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    Width="100"
                                                    MinWidth="90"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Znovu načíst"
                                MinWidth="120"
                                Margin="0,0,8,0"
                                Click="BtnReload_Click"/>

                        <Button Content="Uložit"
                                MinWidth="120"
                                Margin="0,0,8,0"
                                Click="BtnSave_Click"/>

                        <Button Content="Označit ke smazání"
                                MinWidth="150"
                                Margin="0,0,8,0"
                                Click="BtnMarkDeleted_Click"/>

                        <Button Content="Vrátit označení"
                                MinWidth="130"
                                Margin="0,0,8,0"
                                Click="BtnRestoreRow_Click"/>

                    </StackPanel>

                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtStatus"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>