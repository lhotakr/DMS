<Window x:Class="DMS.Desktop.Views.SystemTransactions.RoleSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select transaction roles"
        Width="620"
        Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DmsBackgroundBrush}">

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,12">
            <TextBlock x:Name="TxtTitle"
                       Text="Transaction roles"
                       Style="{StaticResource DmsTitleTextStyle}"/>

            <TextBlock x:Name="TxtSubtitle"
                       Text="Select roles that are allowed to execute the transaction."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <ListBox x:Name="ListRoles"
                 Grid.Row="1"
                 Margin="0,0,0,12"
                 Background="{DynamicResource DmsBackgroundBrush}"
                 BorderBrush="{DynamicResource DmsBorderBrush}"
                 Foreground="{DynamicResource DmsForegroundBrush}">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,4,0,4"
                              Foreground="{DynamicResource DmsForegroundBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding Code}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                            <TextBlock Text="{Binding Description}"
                                       Foreground="{DynamicResource DmsMutedForegroundBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button x:Name="BtnCancel"
                    Content="Cancel"
                    MinWidth="100"
                    Margin="0,0,8,0"
                    Click="BtnCancel_Click"/>

            <Button x:Name="BtnOk"
                    Content="OK"
                    MinWidth="100"
                    Style="{StaticResource DmsPrimaryButtonStyle}"
                    Click="BtnOk_Click"/>
        </StackPanel>

    </Grid>
</Window>
