<UserControl x:Class="DMS.Desktop.Views.SystemTransactions.TransactionManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DMS.Desktop.Views.SystemTransactions"
             x:Name="Root"
             Background="{DynamicResource DmsBackgroundBrush}">

    <UserControl.Resources>
        <local:Sys11TransactionTextConverter x:Key="Sys11TransactionTextConverter"/>

        <Style x:Key="Sys11DataGridTextBlockElementStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource DmsDataGridTextBlockElementStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource DmsOnAccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="0">

            <TextBlock x:Name="TxtTitle"
                       Text="SYS11 - Transaction management"
                       Style="{StaticResource DmsTitleTextStyle}"/>

            <Border Style="{StaticResource DmsCardBorderStyle}"
                    Margin="0,0,0,12">

                <StackPanel>

                    <TextBlock x:Name="TxtSubtitle"
                               Text="Manage transaction definitions stored in transactions.json."
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="TxtTechnicalNote"
                               Text="Code and HandlerKey are read-only on purpose. Changing them can break dispatcher and handler mapping."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"
                               Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <TextBlock x:Name="TxtFilterLabel"
                                   Text="Filter:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"
                                   Margin="0,0,8,0"/>

                        <TextBox x:Name="TxtFilter"
                                 Width="320"
                                 Margin="0,0,8,0"
                                 TextChanged="TxtFilter_TextChanged"/>

                        <CheckBox x:Name="ChkShowInactive"
                                  Content="Show inactive"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Checked="FilterChanged"
                                  Unchecked="FilterChanged"/>
                    </StackPanel>

                    <DataGrid x:Name="GridTransactions"
                              Style="{StaticResource DmsDataGridStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              MinHeight="420"
                              Margin="0,0,0,12"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow"
                                   BasedOn="{StaticResource DmsEditableGridRowStyle}">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource DmsOnAccentBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Code"
                                                Binding="{Binding Code}"
                                                SortMemberPath="Code"
                                                IsReadOnly="True"
                                                Width="90"
                                                MinWidth="80"
                                                ElementStyle="{StaticResource Sys11DataGridTextBlockElementStyle}"/>

                            <DataGridTemplateColumn Header="Name"
                                                    SortMemberPath="Name"
                                                    Width="220"
                                                    MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource Sys11TransactionTextConverter}, ConverterParameter=Name}"
                                                   Style="{StaticResource Sys11DataGridTextBlockElementStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DmsDataGridTextBoxEditingStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Module"
                                                    SortMemberPath="Module"
                                                    Width="170"
                                                    MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource Sys11TransactionTextConverter}, ConverterParameter=Module}"
                                                   Style="{StaticResource Sys11DataGridTextBlockElementStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableModules, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValue="{Binding Module, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="RawName"
                                                  DisplayMemberPath="DisplayName"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Description"
                                                    SortMemberPath="Description"
                                                    Width="*"
                                                    MinWidth="320">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource Sys11TransactionTextConverter}, ConverterParameter=Description}"
                                                   Style="{StaticResource Sys11DataGridTextBlockElementStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DmsDataGridTextBoxEditingStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Handler key"
                                                Binding="{Binding HandlerKey}"
                                                SortMemberPath="HandlerKey"
                                                IsReadOnly="True"
                                                Width="190"
                                                MinWidth="160"
                                                ElementStyle="{StaticResource Sys11DataGridTextBlockElementStyle}"/>

                            <DataGridCheckBoxColumn Header="Requires SAP ID"
                                                    Binding="{Binding RequiresArticleNumber, UpdateSourceTrigger=PropertyChanged}"
                                                    SortMemberPath="RequiresArticleNumber"
                                                    ElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    EditingElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    Width="110"
                                                    MinWidth="90"/>

                            <DataGridCheckBoxColumn Header="Active"
                                                    Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                                    SortMemberPath="IsActive"
                                                    ElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    EditingElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    Width="90"
                                                    MinWidth="80"/>

                            <DataGridTextColumn Header="Roles"
                                                Binding="{Binding RolesText}"
                                                SortMemberPath="RolesText"
                                                IsReadOnly="True"
                                                Width="280"
                                                MinWidth="220"
                                                ElementStyle="{StaticResource Sys11DataGridTextBlockElementStyle}"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button x:Name="BtnReload"
                                Content="Reload"
                                MinWidth="120"
                                Margin="0,0,8,0"
                                Click="BtnReload_Click"/>

                        <Button x:Name="BtnSave"
                                Content="Save transactions"
                                MinWidth="140"
                                Margin="0,0,8,0"
                                Style="{StaticResource DmsPrimaryButtonStyle}"
                                Click="BtnSave_Click"/>

                        <Button x:Name="BtnEditRoles"
                                Content="Edit roles"
                                MinWidth="120"
                                Click="BtnEditRoles_Click"/>

                    </StackPanel>

                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtStatus"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
