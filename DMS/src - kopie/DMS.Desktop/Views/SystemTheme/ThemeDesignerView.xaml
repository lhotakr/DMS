<UserControl x:Class="DMS.Desktop.Views.SystemTheme.ThemeDesignerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <StackPanel Grid.Row="0">
   <TextBlock x:Name="TxtTitle" FontSize="26" FontWeight="Bold"/>
   <TextBlock x:Name="TxtSubtitle" Margin="0,5,0,0" TextWrapping="Wrap"
              Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
  </StackPanel>

  <Grid Grid.Row="1" Margin="0,14,0,8">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="300"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>

   <TextBlock x:Name="LblProfile" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <ComboBox x:Name="CmbProfiles" Grid.Column="1" MinHeight="30"
             SelectionChanged="ProfileChanged" DisplayMemberPath="DisplayName"/>
   <Button x:Name="BtnNewProfile" Grid.Column="2" Margin="8,0,0,0" Click="NewProfile_Click"/>
   <Button x:Name="BtnCloneProfile" Grid.Column="3" Margin="8,0,0,0" Click="CloneProfile_Click"/>
   <Button x:Name="BtnSaveProfile" Grid.Column="4" Margin="8,0,0,0" Click="SaveProfile_Click"/>
   <Button x:Name="BtnActivateProfile" Grid.Column="5" Margin="8,0,0,0" Click="ActivateProfile_Click"/>
   <Button x:Name="BtnImport" Grid.Column="6" Margin="8,0,0,0" Click="Import_Click"/>
   <Button x:Name="BtnExport" Grid.Column="7" Margin="8,0,0,0" Click="Export_Click"/>
  </Grid>

  <Grid Grid.Row="2" Margin="0,0,0,10">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="440"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>

   <TextBlock x:Name="LblScope" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <ComboBox x:Name="CmbScope" Grid.Column="1" MinHeight="30"
             SelectionChanged="ScopeChanged" DisplayMemberPath="DisplayName"/>
   <Button x:Name="BtnReload" Grid.Column="2" Margin="8,0,0,0" Click="Reload_Click"/>
   <Button x:Name="BtnPreview" Grid.Column="3" Margin="8,0,0,0" Click="Preview_Click"/>
   <Button x:Name="BtnApplyLive" Grid.Column="4" Margin="8,0,0,0" Click="ApplyLive_Click"/>
  </Grid>

  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="3*"/>
    <ColumnDefinition Width="12"/>
    <ColumnDefinition Width="2*"/>
   </Grid.ColumnDefinitions>

   <TabControl Grid.Column="0" x:Name="EditorTabs">
    <TabItem x:Name="TabResources">
     <Grid Margin="10">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="TxtResourcesHelp" Grid.Row="0" Margin="0,0,0,8"
                 TextWrapping="Wrap" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
      <DataGrid x:Name="GridResources" Grid.Row="1" AutoGenerateColumns="False"
                IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False"
                CanUserResizeColumns="True" CanUserReorderColumns="True">
       <DataGrid.Columns>
        <DataGridTextColumn x:Name="ColResourceKey" Binding="{Binding Key}" IsReadOnly="True" Width="240"/>
        <DataGridTextColumn x:Name="ColResourceType" Binding="{Binding ResourceType}" IsReadOnly="True" Width="130"/>
        <DataGridTextColumn x:Name="ColInherited" Binding="{Binding InheritedValue}" IsReadOnly="True" Width="180"/>
        <DataGridTextColumn x:Name="ColOverride" Binding="{Binding OverrideValue, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
        <DataGridTextColumn x:Name="ColEffective" Binding="{Binding EffectiveValue}" IsReadOnly="True" Width="180"/>
        <DataGridTextColumn x:Name="ColSource" Binding="{Binding Source}" IsReadOnly="True" Width="140"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </TabItem>

    <TabItem x:Name="TabProperties">
     <Grid Margin="10">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="TxtPropertiesHelp" Grid.Row="0" Margin="0,0,0,8"
                 TextWrapping="Wrap" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
      <DataGrid x:Name="GridProperties" Grid.Row="1" AutoGenerateColumns="False"
                CanUserAddRows="False" CanUserDeleteRows="False"
                CanUserResizeColumns="True" CanUserReorderColumns="True">
       <DataGrid.Columns>
        <DataGridCheckBoxColumn x:Name="ColPropertyActive" Binding="{Binding IsActive}" Width="70"/>
        <DataGridTextColumn x:Name="ColSelectorKind" Binding="{Binding SelectorKind, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
        <DataGridTextColumn x:Name="ColSelector" Binding="{Binding Selector, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
        <DataGridTextColumn x:Name="ColProperty" Binding="{Binding Property, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
        <DataGridTextColumn x:Name="ColValue" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
       </DataGrid.Columns>
      </DataGrid>
      <WrapPanel Grid.Row="2" Margin="0,8,0,0">
       <Button x:Name="BtnAddProperty" Click="AddProperty_Click"/>
       <Button x:Name="BtnDeleteProperty" Margin="8,0,0,0" Click="DeleteProperty_Click"/>
      </WrapPanel>
     </Grid>
    </TabItem>

    <TabItem x:Name="TabAdvanced">
     <Grid Margin="10">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="TxtAdvancedHelp" Grid.Row="0" Margin="0,0,0,8"
                 TextWrapping="Wrap" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
      <TextBox x:Name="TxtAdvancedXaml" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
               TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               FontFamily="Consolas" FontSize="13"/>
      <WrapPanel Grid.Row="2" Margin="0,8,0,0">
       <Button x:Name="BtnValidateXaml" Click="ValidateXaml_Click"/>
       <Button x:Name="BtnInsertTemplate" Margin="8,0,0,0" Click="InsertTemplate_Click"/>
       <Button x:Name="BtnRestoreScope" Margin="8,0,0,0" Click="RestoreScope_Click"/>
      </WrapPanel>
     </Grid>
    </TabItem>
   </TabControl>

   <Border Grid.Column="2" x:Name="PreviewHost" Padding="14"
           BorderBrush="{DynamicResource DmsBorderBrush}" BorderThickness="1" CornerRadius="8"
           Background="{DynamicResource DmsPanelBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel x:Name="PreviewRoot">
      <TextBlock x:Name="TxtPreviewTitle" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
      <TextBlock x:Name="TxtPreviewScope" Foreground="{DynamicResource DmsMutedForegroundBrush}" Margin="0,0,0,12"/>
      <Border Padding="12" BorderBrush="{DynamicResource DmsBorderBrush}" BorderThickness="1"
              CornerRadius="6" Background="{DynamicResource DmsBackgroundBrush}">
       <StackPanel>
        <TextBlock Text="DMS Preview" FontWeight="Bold" FontSize="18"/>
        <TextBlock x:Name="TxtPreviewBody" Margin="0,4,0,10" TextWrapping="Wrap"/>
        <TextBox Text="Editable text" Margin="0,0,0,8"/>
        <ComboBox SelectedIndex="0" Margin="0,0,0,8">
         <ComboBoxItem Content="Option A"/>
         <ComboBoxItem Content="Option B"/>
        </ComboBox>
        <WrapPanel Margin="0,0,0,10">
         <Button Content="Primary" Style="{DynamicResource DmsPrimaryButtonStyle}"/>
         <Button Content="Normal" Margin="8,0,0,0"/>
         <CheckBox Content="Check box" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </WrapPanel>
        <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" Height="180" IsReadOnly="True"
                  CanUserResizeColumns="True" CanUserReorderColumns="True">
         <DataGrid.Columns>
          <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90"/>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
         </DataGrid.Columns>
        </DataGrid>
       </StackPanel>
      </Border>
      <TextBlock x:Name="TxtPreviewIssues" Margin="0,10,0,0" TextWrapping="Wrap"
                 Foreground="{DynamicResource DmsWarningBrush}"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>

  <Grid Grid.Row="4" Margin="0,10,0,0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <TextBlock x:Name="TxtStatus" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
              Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
   <Button x:Name="BtnOpenLog" Grid.Column="1" Click="OpenLog_Click"/>
  </Grid>
 </Grid>
</UserControl>
