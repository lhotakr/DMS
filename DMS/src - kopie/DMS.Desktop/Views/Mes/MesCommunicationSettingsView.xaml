<UserControl x:Class="DMS.Desktop.Views.Mes.MesCommunicationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DMS.Desktop.Views.Mes"
             xmlns:loc="clr-namespace:DMS.Desktop.Localization"
             Background="{DynamicResource DmsPanelBrush}">
    <UserControl.Resources>
        <loc:DmsEnumTextConverter x:Key="DmsEnumTextConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="TxtTitle"
                           Text="MES00 - Nastavení MES komunikace"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
                <TextBlock x:Name="TxtSubtitle"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Padding="14"
                    Margin="0,0,0,12"
                    Background="{DynamicResource DmsBackgroundBrush}"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtMonitoringSection"
                               Grid.Row="0"
                               Grid.ColumnSpan="3"
                               Text="Monitoring"
                               FontWeight="Bold"
                               FontSize="16"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <CheckBox x:Name="ChkMonitoringEnabled"
                              Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Content="Povolit monitoring"
                              Margin="0,0,0,8"
                              Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <TextBlock x:Name="TxtDevicesFilePathLabel" Grid.Row="2" Grid.Column="0" Text="Soubor devices.txt" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtDevicesFilePath" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" MinWidth="520" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtDevicesFilePathHint" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

                    <TextBlock x:Name="TxtStationsFilePathLabel" Grid.Row="4" Grid.Column="0" Text="Soubor stanic" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtStationsFilePath" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" MinWidth="520" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtStationsFilePathHint" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

                    <TextBlock x:Name="TxtStationSnapshotsFolderLabel" Grid.Row="6" Grid.Column="0" Text="Složka snímků stanic" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtStationSnapshotsFolder" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" MinWidth="520" Margin="0,0,0,8"/>

                    <TextBlock x:Name="TxtPingTimeoutLabel" Grid.Row="7" Grid.Column="0" Text="Timeout pingu [ms]" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtPingTimeout" Grid.Row="7" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtPingTimeoutHint" Grid.Row="7" Grid.Column="2" Text="250 až 30000" VerticalAlignment="Center" Margin="10,0,0,8" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

                    <TextBlock x:Name="TxtStationPollTimeoutLabel" Grid.Row="8" Grid.Column="0" Text="Timeout čtení stanice [ms]" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtStationPollTimeout" Grid.Row="8" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtStationPollTimeoutHint" Grid.Row="8" Grid.Column="2" Text="250 až 30000" VerticalAlignment="Center" Margin="10,0,0,8" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

                    <TextBlock x:Name="TxtMaxParallelismLabel" Grid.Row="9" Grid.Column="0" Text="Paralelní kontroly" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtMaxParallelism" Grid.Row="9" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtMaxParallelismHint" Grid.Row="9" Grid.Column="2" Text="1 až 64" VerticalAlignment="Center" Margin="10,0,0,8" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

                    <TextBlock x:Name="TxtAutoRefreshLabel" Grid.Row="10" Grid.Column="0" Text="Automatická kontrola [s]" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtAutoRefresh" Grid.Row="10" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtAutoRefreshHint" Grid.Row="10" Grid.Column="2" Text="10 až 3600" VerticalAlignment="Center" Margin="10,0,0,8" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

                    <TextBlock x:Name="TxtStationAutoRefreshLabel" Grid.Row="11" Grid.Column="0" Text="Auto čtení stanic [s]" VerticalAlignment="Center" Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtStationAutoRefresh" Grid.Row="11" Grid.Column="1" Width="160" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TxtStationAutoRefreshHint" Grid.Row="11" Grid.Column="2" Text="1 až 3600" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Padding="14"
                    Margin="0,0,0,12"
                    Background="{DynamicResource DmsBackgroundBrush}"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="430"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtWorkplacesSection"
                               Grid.Row="0"
                               Text="Pracoviště a význam signálů"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBlock x:Name="TxtWorkplacesHint"
                               Grid.Row="1"
                               Margin="0,4,0,10"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtWorkplaceLabel"
                                   Grid.Column="0"
                                   Text="Pracoviště / zařízení"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <ComboBox x:Name="CmbWorkplace"
                                  Grid.Column="1"
                                  MinWidth="520"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="DisplayText"
                                  SelectionChanged="CmbWorkplace_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="145"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding StationCode}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1"
                                                   Margin="10,0"
                                                   Text="{Binding DeviceName}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding IpAddress}"
                                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="BtnReloadWorkplaces"
                                Grid.Column="2"
                                Content="Načíst pracoviště"
                                Padding="12,6"
                                Margin="8,0,0,0"
                                Click="BtnReloadWorkplaces_Click"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtWorkplaceNameLabel"
                                   Grid.Column="0"
                                   Text="Název zařízení"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtWorkplaceName"
                                 Grid.Column="1"
                                 Margin="6,0,16,0"
                                 IsReadOnly="True"/>
                        <TextBlock x:Name="TxtWorkplaceIpLabel"
                                   Grid.Column="2"
                                   Text="IP adresa"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtWorkplaceIp"
                                 Grid.Column="3"
                                 Margin="6,0,0,0"
                                 IsReadOnly="True"/>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtWorkplaceDriverLabel" Grid.Column="0" Text="Ovladač" VerticalAlignment="Center" Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <ComboBox x:Name="CmbWorkplaceDriver" Grid.Column="1" Margin="6,0,16,0" IsEditable="True"/>
                        <TextBlock x:Name="TxtWorkplacePortLabel" Grid.Column="2" Text="Port" VerticalAlignment="Center" Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtWorkplacePort" Grid.Column="3" Margin="6,0,16,0"/>
                        <TextBlock x:Name="TxtWorkplaceStopTimeoutLabel" Grid.Column="4" Text="Stop po [s]" VerticalAlignment="Center" Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtWorkplaceStopTimeout" Grid.Column="5" Margin="6,0,16,0"/>
                        <CheckBox x:Name="ChkWorkplaceEnabled" Grid.Column="6" Content="Aktivní" VerticalAlignment="Center" Foreground="{DynamicResource DmsForegroundBrush}"/>
                    </Grid>

                    <Grid Grid.Row="5" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtWorkplaceUnitIdLabel"
                                   Grid.Column="0"
                                   Text="Unit ID"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtWorkplaceUnitId"
                                 Grid.Column="1"
                                 Margin="6,0,16,0"/>
                        <TextBlock x:Name="TxtWorkplacePollIntervalLabel"
                                   Grid.Column="2"
                                   Text="Čtení [ms]"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtWorkplacePollInterval"
                                 Grid.Column="3"
                                 Margin="6,0,16,0"/>
                        <TextBlock x:Name="TxtWorkplaceTimeoutLabel"
                                   Grid.Column="4"
                                   Text="Timeout [ms]"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtWorkplaceTimeout"
                                 Grid.Column="5"
                                 Margin="6,0,16,0"/>
                        <TextBlock x:Name="TxtWorkplaceStaleAfterLabel"
                                   Grid.Column="6"
                                   Text="Stará data [s]"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtWorkplaceStaleAfter"
                                 Grid.Column="7"
                                 Margin="6,0,16,0"/>
                        <TextBlock x:Name="TxtModbusAddressHint"
                                   Grid.Column="8"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    </Grid>

                    <DataGrid x:Name="GridSignalMappings"
                              Grid.Row="6"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              ColumnHeaderHeight="36"
                              RowHeight="30"
                              MinColumnWidth="55"
                              FrozenColumnCount="4"
                              EnableColumnVirtualization="False"
                              Background="{DynamicResource DmsPanelBrush}"
                              Foreground="{DynamicResource DmsForegroundBrush}"
                              BorderBrush="{DynamicResource DmsBorderBrush}"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource DmsDataGridColumnHeaderStyle}">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="MinWidth" Value="55"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                            <Style TargetType="DataGridCell"
                                   BasedOn="{StaticResource DmsDataGridCellStyle}">
                                <Setter Property="Padding" Value="7,3"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                            <Style x:Key="MesMappingTextStyle"
                                   TargetType="TextBlock"
                                   BasedOn="{StaticResource DmsDataGridTextBlockElementStyle}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </Style>
                            <Style x:Key="MesMappingEditTextStyle"
                                   TargetType="TextBox"
                                   BasedOn="{StaticResource DmsDataGridTextBoxEditingStyle}">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColMappingPoint"
                                                Header="Bod"
                                                Binding="{Binding Code}"
                                                Width="110"
                                                MinWidth="95"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource MesMappingTextStyle}"/>
                            <DataGridTextColumn x:Name="ColMappingModule"
                                                Header="Modul"
                                                Binding="{Binding ModuleType}"
                                                Width="140"
                                                MinWidth="125"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource MesMappingTextStyle}"/>
                            <DataGridTextColumn x:Name="ColMappingSlot"
                                                Header="Slot"
                                                Binding="{Binding Slot}"
                                                Width="60"
                                                MinWidth="55"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource MesMappingTextStyle}"/>
                            <DataGridTextColumn x:Name="ColMappingChannel"
                                                Header="Kanál"
                                                Binding="{Binding Channel}"
                                                Width="70"
                                                MinWidth="65"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource MesMappingTextStyle}"/>
                            <DataGridTextColumn x:Name="ColMappingLogicalSignal"
                                                Header="Význam signálu"
                                                Binding="{Binding LogicalSignal, UpdateSourceTrigger=PropertyChanged}"
                                                Width="200"
                                                MinWidth="170"
                                                ElementStyle="{StaticResource MesMappingTextStyle}"
                                                EditingElementStyle="{StaticResource MesMappingEditTextStyle}"/>
                            <DataGridTextColumn x:Name="ColMappingDisplayName"
                                                Header="Zobrazený název"
                                                Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                Width="220"
                                                MinWidth="180"
                                                ElementStyle="{StaticResource MesMappingTextStyle}"
                                                EditingElementStyle="{StaticResource MesMappingEditTextStyle}"/>
                            <DataGridCheckBoxColumn x:Name="ColMappingEnabled"
                                                    Header="Aktivní"
                                                    Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="80"
                                                    MinWidth="75"/>
                            <DataGridCheckBoxColumn x:Name="ColMappingMes03"
                                                    Header="MES03"
                                                    Binding="{Binding VisibleInMes03, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="80"
                                                    MinWidth="75"/>
                            <DataGridCheckBoxColumn x:Name="ColMappingInverted"
                                                    Header="Invertovat"
                                                    Binding="{Binding Inverted, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="90"
                                                    MinWidth="85"/>
                            <DataGridTemplateColumn x:Name="ColMappingArea"
                                                    Header="Oblast"
                                                    Width="145"
                                                    MinWidth="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Area, Converter={StaticResource DmsEnumTextConverter}, ConverterParameter=MES.ModbusArea}"
                                                   Style="{StaticResource MesMappingTextStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding ModbusAreas, RelativeSource={RelativeSource AncestorType={x:Type local:MesCommunicationSettingsView}}}"
                                                  SelectedItem="{Binding Area, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="ColMappingAddress"
                                                Header="Adresa (0-based)"
                                                Binding="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                                                Width="130"
                                                MinWidth="115"
                                                ElementStyle="{StaticResource MesMappingTextStyle}"
                                                EditingElementStyle="{StaticResource MesMappingEditTextStyle}"/>
                            <DataGridTemplateColumn x:Name="ColMappingDataType"
                                                    Header="Datový typ"
                                                    Width="125"
                                                    MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DataType, Converter={StaticResource DmsEnumTextConverter}, ConverterParameter=MES.DataType}"
                                                   Style="{StaticResource MesMappingTextStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding ModbusDataTypes, RelativeSource={RelativeSource AncestorType={x:Type local:MesCommunicationSettingsView}}}"
                                                  SelectedItem="{Binding DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="ColMappingBitIndex"
                                                Header="Bit 0-15"
                                                Binding="{Binding BitIndexText, UpdateSourceTrigger=PropertyChanged}"
                                                Width="95"
                                                MinWidth="85"
                                                ElementStyle="{StaticResource MesMappingTextStyle}"
                                                EditingElementStyle="{StaticResource MesMappingEditTextStyle}"/>
                            <DataGridTemplateColumn x:Name="ColMappingWordOrder"
                                                    Header="Pořadí slov"
                                                    Width="165"
                                                    MinWidth="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding WordOrder, Converter={StaticResource DmsEnumTextConverter}, ConverterParameter=MES.WordOrder}"
                                                   Style="{StaticResource MesMappingTextStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding ModbusWordOrders, RelativeSource={RelativeSource AncestorType={x:Type local:MesCommunicationSettingsView}}}"
                                                  SelectedItem="{Binding WordOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="7" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtWorkplaceControllerLabel" Text="Řadič" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                            <TextBox x:Name="TxtWorkplaceController" Margin="0,4,12,0" MinWidth="360"/>
                            <TextBlock x:Name="TxtMappingPath" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                            <TextBlock x:Name="TxtMappingStatus" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button x:Name="BtnApplyBrTemplate" Content="Použít B&amp;R šablonu" Padding="12,6" Margin="0,0,8,0" Click="BtnApplyBrTemplate_Click"/>
                            <Button x:Name="BtnSwapCounters" Content="Prohodit čítače" Padding="12,6" Margin="0,0,8,0" Click="BtnSwapCounters_Click"/>
                            <Button x:Name="BtnTestModbus" Content="Testovat Modbus" Padding="12,6" Margin="0,0,8,0" Click="BtnTestModbus_Click"/>
                            <Button x:Name="BtnSaveMapping" Content="Uložit mapování" Padding="12,6" Click="BtnSaveMapping_Click" Background="{DynamicResource DmsAccentBrush}" Foreground="{DynamicResource DmsOnAccentBrush}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Padding="14"
                    Margin="0,0,0,12"
                    Background="{DynamicResource DmsBackgroundBrush}"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="420"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtModbusExplorerSection"
                               Grid.Row="0"
                               Text="Modbus TCP průzkumník"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <TextBlock x:Name="TxtModbusExplorerHint"
                               Grid.Row="1"
                               Margin="0,4,0,10"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtExplorerEndpointLabel"
                                   Grid.Column="0"
                                   Text="Koncový bod"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtExplorerEndpoint"
                                 Grid.Column="1"
                                 Margin="6,0,16,0"
                                 IsReadOnly="True"/>
                        <TextBlock x:Name="TxtExplorerUnitIdLabel"
                                   Grid.Column="2"
                                   Text="Unit ID"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtExplorerUnitId"
                                 Grid.Column="3"
                                 Margin="6,0,16,0"/>
                        <TextBlock x:Name="TxtExplorerTimeoutLabel"
                                   Grid.Column="4"
                                   Text="Timeout"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtExplorerTimeout"
                                 Grid.Column="5"
                                 Margin="6,0,16,0"/>
                        <TextBlock x:Name="TxtExplorerConnectionStatus"
                                   Grid.Column="6"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                        <Button x:Name="BtnExplorerTestConnection"
                                Grid.Column="7"
                                Content="Ověřit port"
                                Padding="12,6"
                                Click="BtnExplorerTestConnection_Click"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="175"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtExplorerAreaLabel"
                                   Grid.Column="0"
                                   Text="Oblast"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <ComboBox x:Name="CmbExplorerArea"
                                  Grid.Column="1"
                                  Margin="6,0,12,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource DmsEnumTextConverter}, ConverterParameter=MES.ModbusArea}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="TxtExplorerStartLabel"
                                   Grid.Column="2"
                                   Text="Od adresy"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtExplorerStart"
                                 Grid.Column="3"
                                 Text="0"
                                 Margin="6,0,12,0"/>
                        <TextBlock x:Name="TxtExplorerCountLabel"
                                   Grid.Column="4"
                                   Text="Počet"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtExplorerCount"
                                 Grid.Column="5"
                                 Text="64"
                                 Margin="6,0,12,0"/>
                        <TextBlock x:Name="TxtExplorerBlockLabel"
                                   Grid.Column="6"
                                   Text="Blok"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtExplorerBlock"
                                 Grid.Column="7"
                                 Text="16"
                                 Margin="6,0,12,0"/>
                        <TextBlock x:Name="TxtExplorerProgress"
                                   Grid.Column="8"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                        <Button x:Name="BtnExplorerScan"
                                Grid.Column="9"
                                Content="Prohledat oblast"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Click="BtnExplorerScan_Click"/>
                        <Button x:Name="BtnExplorerQuickScan"
                                Grid.Column="10"
                                Content="B&amp;R rychlý průzkum"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Click="BtnExplorerQuickScan_Click"/>
                        <Button x:Name="BtnExplorerCancel"
                                Grid.Column="11"
                                Content="Zrušit"
                                Padding="12,6"
                                IsEnabled="False"
                                Click="BtnExplorerCancel_Click"/>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtExplorerFilterLabel"
                                   Grid.Column="0"
                                   Text="Filtr"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtExplorerFilter"
                                 Grid.Column="1"
                                 Margin="6,0,16,0"
                                 TextChanged="ExplorerTextFilter_Changed"/>
                        <CheckBox x:Name="ChkExplorerOnlyReadable"
                                  Grid.Column="2"
                                  Content="Jen čitelné"
                                  IsChecked="True"
                                  Margin="0,0,16,0"
                                  VerticalAlignment="Center"
                                  Checked="ExplorerCheckFilter_Changed"
                                  Unchecked="ExplorerCheckFilter_Changed"
                                  Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <CheckBox x:Name="ChkExplorerOnlyNonZero"
                                  Grid.Column="3"
                                  Content="Jen nenulové"
                                  Margin="0,0,16,0"
                                  VerticalAlignment="Center"
                                  Checked="ExplorerCheckFilter_Changed"
                                  Unchecked="ExplorerCheckFilter_Changed"
                                  Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <CheckBox x:Name="ChkExplorerOnlyChanged"
                                  Grid.Column="4"
                                  Content="Jen změněné"
                                  VerticalAlignment="Center"
                                  Checked="ExplorerCheckFilter_Changed"
                                  Unchecked="ExplorerCheckFilter_Changed"
                                  Foreground="{DynamicResource DmsForegroundBrush}"/>
                    </Grid>

                    <TextBlock x:Name="TxtExplorerStatus"
                               Grid.Row="5"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

                    <DataGrid x:Name="GridModbusExplorer"
                              Grid.Row="6"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColExplorerArea" Header="Oblast" Binding="{Binding Area}" Width="145" MinWidth="125"/>
                            <DataGridTextColumn x:Name="ColExplorerAddress" Header="Adresa" Binding="{Binding Address}" Width="80" MinWidth="70"/>
                            <DataGridTextColumn x:Name="ColExplorerValue" Header="Hodnota" Binding="{Binding ValueText}" Width="100" MinWidth="85"/>
                            <DataGridTextColumn x:Name="ColExplorerHex" Header="Hex" Binding="{Binding HexText}" Width="90" MinWidth="80"/>
                            <DataGridTextColumn x:Name="ColExplorerBinary" Header="Binárně" Binding="{Binding BinaryText}" Width="175" MinWidth="155"/>
                            <DataGridTextColumn x:Name="ColExplorerSigned" Header="Int16" Binding="{Binding SignedText}" Width="85" MinWidth="75"/>
                            <DataGridTextColumn x:Name="ColExplorerPrevious" Header="Předchozí" Binding="{Binding PreviousText}" Width="100" MinWidth="85"/>
                            <DataGridTextColumn x:Name="ColExplorerDelta" Header="Rozdíl" Binding="{Binding DeltaText}" Width="105" MinWidth="90"/>
                            <DataGridTextColumn x:Name="ColExplorerChangedBits" Header="Změněné bity" Binding="{Binding ChangedBitsText}" Width="150" MinWidth="125"/>
                            <DataGridTextColumn x:Name="ColExplorerStatus" Header="Stav" Binding="{Binding StatusText}" Width="105" MinWidth="90"/>
                            <DataGridTextColumn x:Name="ColExplorerError" Header="Chyba" Binding="{Binding Error}" Width="*" MinWidth="220"/>
                            <DataGridTextColumn x:Name="ColExplorerReadAt" Header="Čtení" Binding="{Binding ReadAtText}" Width="105" MinWidth="95"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="7" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtExplorerAssignmentHint"
                                   Grid.Column="0"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                        <Button x:Name="BtnExplorerCaptureBaseline"
                                Grid.Column="1"
                                Content="Uložit výchozí snímek"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Click="BtnExplorerCaptureBaseline_Click"/>
                        <TextBlock x:Name="TxtExplorerBitLabel"
                                   Grid.Column="2"
                                   Text="Bit"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <ComboBox x:Name="CmbExplorerAssignBit"
                                  Grid.Column="3"
                                  Margin="6,0,8,0"/>
                        <Button x:Name="BtnExplorerAssign"
                                Grid.Column="4"
                                Content="Přiřadit vybranému bodu"
                                Padding="12,6"
                                Click="BtnExplorerAssign_Click"
                                Background="{DynamicResource DmsAccentBrush}"
                                Foreground="{DynamicResource DmsOnAccentBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Padding="14"
                    Margin="0,0,0,12"
                    Background="{DynamicResource DmsBackgroundBrush}"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtUnlockSection"
                               Grid.Row="0"
                               Grid.ColumnSpan="3"
                               Text="Budoucí signál pro stroj"
                               FontWeight="Bold"
                               FontSize="16"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <TextBlock x:Name="TxtUnlockWarning"
                               Grid.Row="1"
                               Grid.ColumnSpan="3"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

                    <CheckBox x:Name="ChkEnableUnlockSignal"
                              Grid.Row="2"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Content="Povolit signál DMS_SETUP_OK"
                              Margin="0,0,0,8"
                              Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <TextBlock x:Name="TxtUnlockProviderLabel" Grid.Row="3" Grid.Column="0" Text="Typ komunikace" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <ComboBox x:Name="CmbUnlockProvider" Grid.Row="3" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <ComboBoxItem Content="None" IsSelected="True"/>
                        <ComboBoxItem Content="BR-Gateway"/>
                        <ComboBoxItem Content="File-Handshake"/>
                        <ComboBoxItem Content="TcpSocket"/>
                    </ComboBox>

                    <TextBlock x:Name="TxtGatewayHostLabel" Grid.Row="4" Grid.Column="0" Text="Gateway host" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtGatewayHost" Grid.Row="4" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                    <TextBlock x:Name="TxtGatewayPortLabel" Grid.Row="5" Grid.Column="0" Text="Gateway port" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtGatewayPort" Grid.Row="5" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                    <TextBlock x:Name="TxtHandshakeFolderLabel" Grid.Row="6" Grid.Column="0" Text="Sdílená složka handshake" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtHandshakeFolder" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" MinWidth="360" Margin="0,0,0,8"/>

                    <TextBlock x:Name="TxtValidityLabel" Grid.Row="7" Grid.Column="0" Text="Platnost povolení [min]" VerticalAlignment="Center" Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtValidityMinutes" Grid.Row="7" Grid.Column="1" Width="160" HorizontalAlignment="Left"/>
                    <CheckBox x:Name="ChkRequireOperatorConfirmation" Grid.Row="7" Grid.Column="2" Content="Vyžadovat potvrzení operátora" VerticalAlignment="Center" Foreground="{DynamicResource DmsForegroundBrush}"/>
                </Grid>
            </Border>

            <Border Grid.Row="5"
                    Padding="12"
                    Background="{DynamicResource DmsBackgroundBrush}"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="BtnReload"
                                Content="Načíst"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Click="BtnReload_Click"/>
                        <Button x:Name="BtnSave"
                                Content="Uložit"
                                Padding="12,6"
                                Click="BtnSave_Click"
                                Background="{DynamicResource DmsAccentBrush}"
                                Foreground="{DynamicResource DmsOnAccentBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="TxtSettingsPath"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                        <TextBlock x:Name="TxtStatusLine"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
