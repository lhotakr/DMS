<UserControl x:Class="DMS.Desktop.Views.Mes.MesWorkplaceOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TxtTitle"
                       Text="MES05 - Soupis pracovišť"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>
            <TextBlock x:Name="TxtSubtitle"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Padding="12"
                Margin="0,0,0,12"
                Background="{DynamicResource DmsBackgroundBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtSummary"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBlock x:Name="TxtFilePath"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    <TextBlock x:Name="TxtSettingsPath"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    <TextBlock x:Name="TxtSnapshotPath"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                    <Button x:Name="BtnReloadFile"
                            Content="Načíst TXT"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="BtnReloadFile_Click"/>
                    <Button x:Name="BtnReloadSettings"
                            Content="Načíst nastavení"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="BtnReloadSettings_Click"/>
                    <Button x:Name="BtnCheckNow"
                            Content="Zkontrolovat teď"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="BtnCheckNow_Click"
                            Background="{DynamicResource DmsAccentBrush}"
                            Foreground="{DynamicResource DmsOnAccentBrush}"/>
                    <Button x:Name="BtnAutoRefresh"
                            Content="Auto kontrola"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="BtnAutoRefresh_Click"/>
                    <Button x:Name="BtnStop"
                            Content="Stop"
                            Padding="12,6"
                            Click="BtnStop_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="10"
                Margin="0,0,0,12"
                Background="{DynamicResource DmsBackgroundBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtCategoryLabel"
                           Text="Kategorie"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
                <ComboBox x:Name="CmbCategory"
                          Width="150"
                          Margin="0,0,12,0"
                          SelectionChanged="Filter_Changed"/>

                <TextBlock x:Name="TxtStateLabel"
                           Text="Stav"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
                <ComboBox x:Name="CmbState"
                          Width="130"
                          Margin="0,0,12,0"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Vše" IsSelected="True"/>
                    <ComboBoxItem Content="Online"/>
                    <ComboBoxItem Content="Offline"/>
                    <ComboBoxItem Content="Error"/>
                    <ComboBoxItem Content="Unknown"/>
                </ComboBox>

                <TextBlock x:Name="TxtSearchLabel"
                           Text="Hledat"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
                <TextBox x:Name="TxtSearch"
                         Width="260"
                         Margin="0,0,12,0"
                         TextChanged="Filter_Changed"/>

                <Button x:Name="BtnCopy"
                        Content="Kopírovat"
                        Padding="12,6"
                        Click="BtnCopy_Click"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="GridDevices"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource DmsBackgroundBrush}"
                  Foreground="{DynamicResource DmsForegroundBrush}"
                  BorderBrush="{DynamicResource DmsBorderBrush}"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  ClipboardCopyMode="IncludeHeader"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,2"/>
                    <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColStatusIcon" Header="" Binding="{Binding StatusIcon}" Width="36" MinWidth="34">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="DarkOrange"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusText}" Value="Online">
                                    <Setter Property="Foreground" Value="SeaGreen"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusText}" Value="Offline">
                                    <Setter Property="Foreground" Value="IndianRed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusText}" Value="Error">
                                    <Setter Property="Foreground" Value="IndianRed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="ColStatus" Header="Stav" Binding="{Binding StatusText}" Width="100" MinWidth="90"/>
                <DataGridTextColumn x:Name="ColCategory" Header="Typ" Binding="{Binding Category}" Width="110" MinWidth="90"/>
                <DataGridTextColumn x:Name="ColAddress" Header="Adresa" Binding="{Binding Address}" Width="150" MinWidth="130"/>
                <DataGridTextColumn x:Name="ColName" Header="Název" Binding="{Binding Name}" Width="210" MinWidth="160"/>
                <DataGridTextColumn x:Name="ColResponseTime" Header="Odezva" Binding="{Binding ResponseTimeText}" Width="90" MinWidth="80"/>
                <DataGridTextColumn x:Name="ColCheckedAt" Header="Kontrola" Binding="{Binding CheckedAtText}" Width="170" MinWidth="150"/>
                <DataGridTextColumn x:Name="ColFailure" Header="Chyba" Binding="{Binding FailureReason}" Width="220" MinWidth="160"/>
                <DataGridTextColumn x:Name="ColNote" Header="Poznámka" Binding="{Binding Note}" Width="*" MinWidth="260"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="TxtStatusLine"
                   Grid.Row="4"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
    </Grid>
</UserControl>
