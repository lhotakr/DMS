<UserControl x:Class="DMS.Desktop.Views.Mes.MesDatabaseSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,12">
                <TextBlock x:Name="TxtTitle"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
                <TextBlock x:Name="TxtSubtitle"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Padding="14"
                    Margin="0,0,0,12"
                    Background="{DynamicResource DmsBackgroundBrush}"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox x:Name="ChkEnabled"
                              Grid.Row="0"
                              Grid.ColumnSpan="2"
                              Margin="0,0,0,10"
                              Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <TextBlock x:Name="LblServer"
                               Grid.Row="1" Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtServer"
                             Grid.Row="1" Grid.Column="1"
                             Margin="0,0,0,8"/>

                    <TextBlock x:Name="LblDatabase"
                               Grid.Row="2" Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtDatabase"
                             Grid.Row="2" Grid.Column="1"
                             Margin="0,0,0,8"/>

                    <TextBlock x:Name="LblSchema"
                               Grid.Row="3" Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtSchema"
                             Grid.Row="3" Grid.Column="1"
                             Margin="0,0,0,8"/>

                    <TextBlock x:Name="LblAuthentication"
                               Grid.Row="4" Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBlock x:Name="TxtAuthentication"
                               Grid.Row="4" Grid.Column="1"
                               VerticalAlignment="Center"
                               Margin="0,0,0,8"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <CheckBox x:Name="ChkEncrypt"
                              Grid.Row="5" Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="0,0,0,8"
                              Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <CheckBox x:Name="ChkTrustServerCertificate"
                              Grid.Row="6" Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="0,0,0,8"
                              Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <TextBlock x:Name="LblConnectTimeout"
                               Grid.Row="7" Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtConnectTimeout"
                             Grid.Row="7" Grid.Column="1"
                             Width="110"
                             HorizontalAlignment="Left"
                             Margin="0,0,0,8"/>

                    <TextBlock x:Name="LblCommandTimeout"
                               Grid.Row="8" Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtCommandTimeout"
                             Grid.Row="8" Grid.Column="1"
                             Width="110"
                             HorizontalAlignment="Left"
                             Margin="0,0,0,8"/>

                    <TextBlock x:Name="LblHealthInterval"
                               Grid.Row="9" Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                    <TextBox x:Name="TxtHealthInterval"
                             Grid.Row="9" Grid.Column="1"
                             Width="110"
                             HorizontalAlignment="Left"
                             Margin="0,0,0,8"/>

                    <TextBlock x:Name="TxtReadOnlyHint"
                               Grid.Row="10"
                               Grid.ColumnSpan="3"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Padding="14"
                    Margin="0,0,0,12"
                    Background="{DynamicResource DmsBackgroundBrush}"
                    BorderBrush="{DynamicResource DmsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtHealthTitle"
                               Grid.Row="0"
                               Grid.ColumnSpan="2"
                               FontWeight="Bold"
                               FontSize="16"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <TextBlock x:Name="LblHealthStatus" Grid.Row="1" Grid.Column="0" Margin="0,0,8,5" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    <TextBlock x:Name="TxtHealthStatus" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5" FontWeight="Bold" Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <TextBlock x:Name="LblHealthLogin" Grid.Row="2" Grid.Column="0" Margin="0,0,8,5" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    <TextBlock x:Name="TxtHealthLogin" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5" Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <TextBlock x:Name="LblHealthLatency" Grid.Row="3" Grid.Column="0" Margin="0,0,8,5" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    <TextBlock x:Name="TxtHealthLatency" Grid.Row="3" Grid.Column="1" Margin="0,0,0,5" Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <TextBlock x:Name="LblHealthSelect" Grid.Row="4" Grid.Column="0" Margin="0,0,8,5" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    <TextBlock x:Name="TxtHealthSelect" Grid.Row="4" Grid.Column="1" Margin="0,0,0,5" Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <TextBlock x:Name="LblHealthViewDefinition" Grid.Row="5" Grid.Column="0" Margin="0,0,8,5" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    <TextBlock x:Name="TxtHealthViewDefinition" Grid.Row="5" Grid.Column="1" Margin="0,0,0,5" Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <TextBlock x:Name="TxtHealthError"
                               Grid.Row="6" Grid.ColumnSpan="2"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnReload"
                        Grid.Column="0"
                        MinWidth="120"
                        Margin="0,0,8,0"
                        Click="BtnReload_Click"/>

                <Button x:Name="BtnTest"
                        Grid.Column="1"
                        MinWidth="140"
                        Margin="0,0,8,0"
                        Click="BtnTest_Click"/>

                <Button x:Name="BtnSave"
                        Grid.Column="2"
                        MinWidth="120"
                        Click="BtnSave_Click"/>

                <TextBlock x:Name="TxtStatus"
                           Grid.Column="3"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
