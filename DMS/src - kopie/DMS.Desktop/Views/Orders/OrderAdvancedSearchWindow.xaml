<Window x:Class="DMS.Desktop.Views.Orders.OrderAdvancedSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ORD10 - Rozšířené hledání"
        Width="1220"
        Height="790"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DmsPanelBrush}"
        Foreground="{DynamicResource DmsForegroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="330"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Rozšířené hledání výrobních zakázek"
                       FontSize="22"
                       FontWeight="Bold"/>
            <TextBlock Margin="0,3,0,0"
                       Text="Hledání probíhá serverově nad celou FASTEC databází. Prázdná pole se nefiltrují."
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Základní údaje">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Zakázka" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtOrderCode" Grid.Row="0" Grid.Column="1" Margin="6"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Artikl" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtProductCode" Grid.Row="0" Grid.Column="3" Margin="6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Označení artiklu" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtProductDesignation" Grid.Row="1" Grid.Column="1" Margin="6"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Popis artiklu" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtProductDescription" Grid.Row="1" Grid.Column="3" Margin="6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Popis zakázky" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtOrderDescription" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="6"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="SAP číslo" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtSapArticle" Grid.Row="3" Grid.Column="1" Margin="6"/>
                </Grid>
            </TabItem>

            <TabItem Header="Rozšířené">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Nákladové středisko / routing"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtCostCenter" Grid.Row="0" Grid.Column="1" Margin="6"/>
                </Grid>
            </TabItem>

            <TabItem Header="Data">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Vytvořeno" VerticalAlignment="Center"/>
                    <DatePicker x:Name="DpCreatedFrom" Grid.Row="0" Grid.Column="1" Margin="6"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="až" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <DatePicker x:Name="DpCreatedTo" Grid.Row="0" Grid.Column="3" Margin="6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Plánovaný start" VerticalAlignment="Center"/>
                    <DatePicker x:Name="DpPlannedStartFrom" Grid.Row="1" Grid.Column="1" Margin="6"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="až" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <DatePicker x:Name="DpPlannedStartTo" Grid.Row="1" Grid.Column="3" Margin="6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Plánovaný konec" VerticalAlignment="Center"/>
                    <DatePicker x:Name="DpPlannedEndFrom" Grid.Row="2" Grid.Column="1" Margin="6"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="až" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <DatePicker x:Name="DpPlannedEndTo" Grid.Row="2" Grid.Column="3" Margin="6"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Skutečný start" VerticalAlignment="Center"/>
                    <DatePicker x:Name="DpActualStartFrom" Grid.Row="3" Grid.Column="1" Margin="6"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="až" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <DatePicker x:Name="DpActualStartTo" Grid.Row="3" Grid.Column="3" Margin="6"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Skutečný konec" VerticalAlignment="Center"/>
                    <DatePicker x:Name="DpActualEndFrom" Grid.Row="4" Grid.Column="1" Margin="6"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="až" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <DatePicker x:Name="DpActualEndTo" Grid.Row="4" Grid.Column="3" Margin="6"/>
                </Grid>
            </TabItem>

            <TabItem Header="Množství">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Cílové množství" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtTargetMin" Grid.Row="0" Grid.Column="1" Margin="6"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="až" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox x:Name="TxtTargetMax" Grid.Row="0" Grid.Column="3" Margin="6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Hotovo / Good" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtFinishedMin" Grid.Row="1" Grid.Column="1" Margin="6"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="až" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox x:Name="TxtFinishedMax" Grid.Row="1" Grid.Column="3" Margin="6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="NOK / Reject" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtScrapMin" Grid.Row="2" Grid.Column="1" Margin="6"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="až" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox x:Name="TxtScrapMax" Grid.Row="2" Grid.Column="3" Margin="6"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Dokončeno [%]" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtProgressMin" Grid.Row="3" Grid.Column="1" Margin="6"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="až" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox x:Name="TxtProgressMax" Grid.Row="3" Grid.Column="3" Margin="6"/>
                </Grid>
            </TabItem>

            <TabItem Header="Stav">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Archiv" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbArchive" Grid.Row="0" Grid.Column="1" Margin="6"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Chyba" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbFailure" Grid.Row="0" Grid.Column="3" Margin="6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Status" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbGeneral" Grid.Row="1" Grid.Column="1" Margin="6"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Plánování" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbPlanning" Grid.Row="1" Grid.Column="3" Margin="6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Fixace" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbFixation" Grid.Row="2" Grid.Column="1" Margin="6"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Výroba" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbProduction" Grid.Row="2" Grid.Column="3" Margin="6"/>
                </Grid>
            </TabItem>

            <TabItem Header="Reference">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="SAP číslo / cf_customer" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtReferenceSap" Grid.Row="0" Grid.Column="1" Margin="6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer order" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtCustomerOrder" Grid.Row="1" Grid.Column="1" Margin="6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Customer code" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtCustomerCode" Grid.Row="2" Grid.Column="1" Margin="6"/>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,10,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="Maximum výsledků"
                           VerticalAlignment="Center"
                           Margin="0,0,7,0"/>
                <TextBox x:Name="TxtMaxRows"
                         Width="80"
                         Height="28"
                         Text="1000"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="BtnReset"
                        MinWidth="105"
                        Height="30"
                        Margin="0,0,8,0"
                        Content="Reset"
                        Click="BtnReset_Click"/>
                <Button x:Name="BtnPreview"
                        MinWidth="145"
                        Height="30"
                        Click="BtnPreview_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE721;"
                                   Margin="0,0,7,0"/>
                        <TextBlock Text="Načíst náhled"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="GridResults"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="False"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Zakázka" Binding="{Binding OrderCode}" Width="105"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="95"/>
                <DataGridTextColumn Header="Artikl" Binding="{Binding ProductCode}" Width="160"/>
                <DataGridTextColumn Header="SAP číslo" Binding="{Binding SapArticleNumber}" Width="120"/>
                <DataGridTextColumn Header="Cíl" Binding="{Binding TargetQuantity, StringFormat={}{0:N0}}" Width="95"/>
                <DataGridTextColumn Header="Hotovo" Binding="{Binding FinishedQuantity, StringFormat={}{0:N0}}" Width="95"/>
                <DataGridTextColumn Header="NOK" Binding="{Binding ScrapQuantity, StringFormat={}{0:N0}}" Width="80"/>
                <DataGridTextColumn Header="Vytvořeno" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="145"/>
                <DataGridTextColumn Header="Plán od" Binding="{Binding PlannedStart, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="145"/>
                <DataGridTextColumn Header="Plán do" Binding="{Binding PlannedEnd, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="145"/>
                <DataGridTextColumn Header="Operací" Binding="{Binding OperationCount}" Width="75"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="BtnApply"
                        MinWidth="135"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="Použít výsledky"
                        IsEnabled="False"
                        Click="BtnApply_Click"/>
                <Button MinWidth="100"
                        Height="32"
                        Content="Zrušit"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
