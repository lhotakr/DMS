<UserControl x:Class="DMS.Desktop.Views.Documents.ArticleDocumentEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsBackgroundBrush}">

    <ScrollViewer x:Name="RootScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="20">

            <TextBlock x:Name="TxtTitle"
                       Style="{StaticResource DmsTitleTextStyle}"/>

            <Border Style="{StaticResource DmsCardBorderStyle}"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="TxtSummary"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtFolderLabel"
                                   Grid.Column="0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>

                        <TextBox x:Name="TxtFolder"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Padding="10,6"
                                 Background="{DynamicResource DmsPanelBrush}"
                                 Foreground="{DynamicResource DmsForegroundBrush}"
                                 BorderBrush="{DynamicResource DmsBorderBrush}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,12">
                        <Button x:Name="BtnOpenDoc03"
                                Style="{StaticResource DmsPrimaryButtonStyle}"
                                MinWidth="120"
                                Margin="0,0,8,0"
                                Click="BtnOpenDoc03_Click"/>

                        <Button x:Name="BtnOpenTec03"
                                MinWidth="120"
                                Margin="0,0,8,0"
                                Click="BtnOpenTec03_Click"/>

                        <Button x:Name="BtnRefresh"
                                MinWidth="120"
                                Click="BtnRefresh_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DmsCardBorderStyle}"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="TxtEditorTitle"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtSourceFileLabel"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>

                        <TextBox x:Name="TxtSourceFile"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Margin="0,0,8,0"
                                 Padding="10,6"
                                 Background="{DynamicResource DmsPanelBrush}"
                                 Foreground="{DynamicResource DmsForegroundBrush}"
                                 BorderBrush="{DynamicResource DmsBorderBrush}"/>

                        <Button x:Name="BtnBrowse"
                                Grid.Column="2"
                                MinWidth="110"
                                Click="BtnBrowse_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtKindLabel"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>

                        <ComboBox x:Name="CmbDocumentKind"
                                  Grid.Column="1"
                                  Margin="0,0,12,0"
                                  IsEditable="True"
                                  SelectionChanged="EditorChanged"/>

                        <CheckBox x:Name="ChkIsActive"
                                  Grid.Column="2"
                                  VerticalAlignment="Center"
                                  IsChecked="True"
                                  Checked="EditorChanged"
                                  Unchecked="EditorChanged"/>

                        <TextBlock x:Name="TxtSelectedInfo"
                                   Grid.Column="3"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtDescriptionLabel"
                                   Grid.Column="0"
                                   VerticalAlignment="Top"
                                   Margin="0,5,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>

                        <TextBox x:Name="TxtDescription"
                                 Grid.Column="1"
                                 AcceptsReturn="True"
                                 MinHeight="58"
                                 TextWrapping="Wrap"
                                 TextChanged="EditorChanged"
                                 Padding="10,6"
                                 Background="{DynamicResource DmsPanelBrush}"
                                 Foreground="{DynamicResource DmsForegroundBrush}"
                                 BorderBrush="{DynamicResource DmsBorderBrush}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnUploadNew"
                                Style="{StaticResource DmsPrimaryButtonStyle}"
                                MinWidth="130"
                                Margin="0,0,8,0"
                                Click="BtnUploadNew_Click"/>

                        <Button x:Name="BtnReplaceSelected"
                                MinWidth="150"
                                Margin="0,0,8,0"
                                Click="BtnReplaceSelected_Click"/>

                        <Button x:Name="BtnSaveMetadata"
                                MinWidth="140"
                                Margin="0,0,8,0"
                                Click="BtnSaveMetadata_Click"/>

                        <Button x:Name="BtnArchive"
                                MinWidth="130"
                                Margin="0,0,8,0"
                                Click="BtnArchive_Click"/>

                        <Button x:Name="BtnClearSelection"
                                MinWidth="130"
                                Click="BtnClearSelection_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DmsCardBorderStyle}"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="TxtListTitle"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="TxtStatus"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"
                               Margin="0,0,0,10"/>

                    <DataGrid x:Name="DgvDocuments"
                              Style="{StaticResource DmsDataGridStyle}"
                              RowStyle="{StaticResource DmsDataGridRowStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MinHeight="360"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ClipboardCopyMode="IncludeHeader"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionChanged="DgvDocuments_SelectionChanged"
                              MouseDoubleClick="DgvDocuments_MouseDoubleClick">

                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColFileName"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding FileName}"
                                                Width="240"
                                                MinWidth="180"/>

                            <DataGridTextColumn x:Name="ColKind"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding DocumentKind}"
                                                Width="170"
                                                MinWidth="130"/>

                            <DataGridTextColumn x:Name="ColDescription"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding Description}"
                                                Width="260"
                                                MinWidth="180"/>

                            <DataGridTextColumn x:Name="ColActive"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding IsActiveText}"
                                                Width="80"
                                                MinWidth="70"/>

                            <DataGridTextColumn x:Name="ColSize"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding SizeText}"
                                                Width="110"
                                                MinWidth="90"/>

                            <DataGridTextColumn x:Name="ColUploadedBy"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding UploadedBy}"
                                                Width="150"
                                                MinWidth="120"/>

                            <DataGridTextColumn x:Name="ColUploadedAt"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding UploadedAt, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                                Width="170"
                                                MinWidth="150"/>

                            <DataGridTextColumn x:Name="ColChangedBy"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding ChangedBy}"
                                                Width="150"
                                                MinWidth="120"/>

                            <DataGridTextColumn x:Name="ColChangedAt"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding ChangedAt, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                                Width="170"
                                                MinWidth="150"/>

                            <DataGridTextColumn x:Name="ColPath"
                                                ElementStyle="{StaticResource DmsDataGridTextBlockElementStyle}"
                                                Binding="{Binding FullPath}"
                                                Width="*"
                                                MinWidth="360"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
