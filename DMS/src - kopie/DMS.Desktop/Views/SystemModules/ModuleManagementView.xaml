<UserControl x:Class="DMS.Desktop.Views.SystemModules.ModuleManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DMS.Desktop.Views.SystemModules"
             Background="{DynamicResource DmsBackgroundBrush}">

    <UserControl.Resources>
        <local:Sys13ModuleTextConverter x:Key="Sys13ModuleTextConverter"/>

        <Style x:Key="Sys13GridTextBlockStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource DmsDataGridTextBlockElementStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource DmsOnAccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Sys13EditableGridRowStyle"
               TargetType="{x:Type DataGridRow}"
               BasedOn="{StaticResource DmsEditableGridRowStyle}">
            <Style.Triggers>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource DmsOnAccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="0">

            <TextBlock x:Name="TxtTitle"
                       Text="SYS13 - Module management"
                       Style="{StaticResource DmsTitleTextStyle}"/>

            <Border Style="{StaticResource DmsCardBorderStyle}"
                    Margin="0,0,0,12">

                <StackPanel>

                    <TextBlock x:Name="TxtCardTitle"
                               Text="DMS modules"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="TxtTechnicalNote"
                               Text="Modules define transaction grouping in the left menu. The fallback module name is used by transactions.json."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"
                               Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <TextBlock x:Name="TxtFilterLabel"
                                   Text="Filter:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"
                                   Margin="0,0,8,0"/>

                        <TextBox x:Name="TxtFilter"
                                 Width="320"
                                 Margin="0,0,8,0"
                                 TextChanged="TxtFilter_TextChanged"/>

                        <CheckBox x:Name="ChkShowInactive"
                                  Content="Show inactive"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Checked="FilterChanged"
                                  Unchecked="FilterChanged"/>
                    </StackPanel>

                    <DataGrid x:Name="GridModules"
                              Style="{StaticResource DmsDataGridStyle}"
                              RowStyle="{StaticResource Sys13EditableGridRowStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="False"
                              MinHeight="420"
                              Margin="0,0,0,12"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn x:Name="ColCode"
                                                Header="Code"
                                                Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                                Width="180"
                                                MinWidth="150"
                                                SortMemberPath="Code"
                                                ElementStyle="{StaticResource Sys13GridTextBlockStyle}"
                                                EditingElementStyle="{StaticResource DmsDataGridTextBoxEditingStyle}"/>

                            <DataGridTemplateColumn x:Name="ColName"
                                                    Header="Name"
                                                    Width="220"
                                                    MinWidth="180"
                                                    SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource Sys13ModuleTextConverter}, ConverterParameter=Name}"
                                                   Style="{StaticResource Sys13GridTextBlockStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DmsDataGridTextBoxEditingStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn x:Name="ColDescription"
                                                    Header="Description"
                                                    Width="*"
                                                    MinWidth="360"
                                                    SortMemberPath="Description">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource Sys13ModuleTextConverter}, ConverterParameter=Description}"
                                                   Style="{StaticResource Sys13GridTextBlockStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DmsDataGridTextBoxEditingStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn x:Name="ColSortOrder"
                                                Header="Sort order"
                                                Binding="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged}"
                                                Width="100"
                                                MinWidth="90"
                                                SortMemberPath="SortOrder"
                                                ElementStyle="{StaticResource Sys13GridTextBlockStyle}"
                                                EditingElementStyle="{StaticResource DmsDataGridTextBoxEditingStyle}"/>

                            <DataGridCheckBoxColumn x:Name="ColIsActive"
                                                    Header="Active"
                                                    Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    EditingElementStyle="{StaticResource DmsCenteredCheckBoxStyle}"
                                                    Width="100"
                                                    MinWidth="90"
                                                    SortMemberPath="IsActive"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button x:Name="BtnReload"
                                Content="Reload"
                                MinWidth="120"
                                Margin="0,0,8,0"
                                Click="BtnReload_Click"/>

                        <Button x:Name="BtnSave"
                                Content="Save"
                                MinWidth="120"
                                Margin="0,0,8,0"
                                Style="{StaticResource DmsPrimaryButtonStyle}"
                                Click="BtnSave_Click"/>

                        <Button x:Name="BtnMarkDeleted"
                                Content="Mark for deletion"
                                MinWidth="150"
                                Margin="0,0,8,0"
                                Click="BtnMarkDeleted_Click"/>

                        <Button x:Name="BtnRestoreRow"
                                Content="Restore mark"
                                MinWidth="130"
                                Click="BtnRestoreRow_Click"/>

                    </StackPanel>

                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtStatus"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
