<UserControl x:Class="DMS.Desktop.Views.WorkLog.WorkLogLockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TxtTitle"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>
            <TextBlock x:Name="TxtSubtitle"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12"
                Background="{DynamicResource DmsBackgroundBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <WrapPanel>
                <TextBlock x:Name="LblFrom"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
                <DatePicker x:Name="DateFrom"
                            Width="150"
                            Margin="0,0,16,0"
                            SelectedDateChanged="DateRange_Changed"/>
                <TextBlock x:Name="LblTo"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
                <DatePicker x:Name="DateTo"
                            Width="150"
                            Margin="0,0,16,0"
                            SelectedDateChanged="DateRange_Changed"/>
                <Button x:Name="BtnLock"
                        MinWidth="120"
                        Margin="0,0,8,0"
                        Click="BtnLock_Click"/>
                <Button x:Name="BtnUnlock"
                        MinWidth="120"
                        Margin="0,0,8,0"
                        Click="BtnUnlock_Click"/>
                <Button x:Name="BtnReload"
                        MinWidth="110"
                        Click="BtnReload_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2"
                Padding="10"
                Background="{DynamicResource DmsBackgroundBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtDaysTitle"
                           Grid.Row="0"
                           Margin="0,0,0,8"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>

                <DataGrid x:Name="GridDays"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColDate"
                                            Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}"
                                            Width="130"/>
                        <DataGridTextColumn x:Name="ColTitle"
                                            Binding="{Binding Title}"
                                            Width="*"/>
                        <DataGridCheckBoxColumn x:Name="ColLocked"
                                                Binding="{Binding Locked}"
                                                Width="90"/>
                        <DataGridTextColumn x:Name="ColColor"
                                            Binding="{Binding Color}"
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="TxtHint"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
            <TextBlock x:Name="TxtStatus"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
