<UserControl x:Class="DMS.Desktop.Views.WorkLog.WorkLogDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Background="{DynamicResource DmsPanelBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TxtTitle"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>
            <TextBlock x:Name="TxtSubtitle"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12"
                Background="{DynamicResource DmsBackgroundBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LblDatabase"
                           Grid.Column="0"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
                <TextBox x:Name="TxtDatabasePath"
                         Grid.Column="1"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"/>
                <Button x:Name="BtnBrowseDatabase"
                        Grid.Column="2"
                        MinWidth="90"
                        Margin="0,0,8,0"
                        Click="BtnBrowseDatabase_Click"/>
                <Button x:Name="BtnSaveDatabasePath"
                        Grid.Column="3"
                        MinWidth="100"
                        Margin="0,0,8,0"
                        Click="BtnSaveDatabasePath_Click"/>
                <Button x:Name="BtnReload"
                        Grid.Column="4"
                        MinWidth="110"
                        Click="BtnReload_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,10"
                Padding="10"
                Background="{DynamicResource DmsBackgroundBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LblUser"
                           Grid.Column="0"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
                <ComboBox x:Name="CmbUser"
                          Grid.Column="1"
                          DisplayMemberPath="DisplayText"
                          SelectionChanged="CmbUser_SelectionChanged"/>
                <TextBlock x:Name="LblSelectedDay"
                           Grid.Column="3"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
                <TextBlock x:Name="TxtSelectedDay"
                           Grid.Column="4"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Outlook-like navigation and attendance summary. -->
            <StackPanel Grid.Column="0">
                <Border Padding="10"
                        Background="{DynamicResource DmsBackgroundBrush}"
                        BorderBrush="{DynamicResource DmsBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtCalendarTitle"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                            <Button x:Name="BtnToday"
                                    Grid.Column="1"
                                    MinWidth="72"
                                    Click="BtnToday_Click"/>
                        </Grid>

                        <Calendar x:Name="MonthCalendar"
                                  HorizontalAlignment="Stretch"
                                  SelectionMode="SingleDate"
                                  Background="{DynamicResource DmsBackgroundBrush}"
                                  Foreground="{DynamicResource DmsForegroundBrush}"
                                  BorderBrush="{DynamicResource DmsBorderBrush}"
                                  SelectedDatesChanged="MonthCalendar_SelectedDatesChanged"
                                  DisplayDateChanged="MonthCalendar_DisplayDateChanged">
                            <Calendar.Resources>
                                <Style TargetType="{x:Type primitives:CalendarDayButton}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Margin" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                        <Trigger Property="IsToday" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource DmsAccentBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="{x:Type primitives:CalendarButton}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                </Style>
                            </Calendar.Resources>
                        </Calendar>
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0"
                        Padding="12"
                        Background="{DynamicResource DmsBackgroundBrush}"
                        BorderBrush="{DynamicResource DmsBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock x:Name="TxtAttendanceTitle"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBlock x:Name="TxtAttendance"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>

                        <StackPanel Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <Border Width="22" Height="3" Margin="0,0,8,0" VerticalAlignment="Center" Background="LimeGreen"/>
                                <TextBlock x:Name="TxtArrivalLegend" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <Border Width="22" Height="3" Margin="0,0,8,0" VerticalAlignment="Center" Background="IndianRed"/>
                                <TextBlock x:Name="TxtDepartureLegend" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,10,0,8"/>
                        <TextBlock x:Name="TxtLockState"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBlock x:Name="TxtDailyTotal"
                                   Margin="0,5,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Main day agenda. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        MinHeight="560"
                        Background="{DynamicResource DmsBackgroundBrush}"
                        BorderBrush="{DynamicResource DmsBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="12,10,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TxtAgendaTitle"
                                       Grid.Column="0"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                            <Button x:Name="BtnMoveEarlier"
                                    Grid.Column="1"
                                    MinWidth="78"
                                    Margin="0,0,6,0"
                                    Click="BtnMoveEarlier_Click"/>
                            <Button x:Name="BtnMoveLater"
                                    Grid.Column="2"
                                    MinWidth="78"
                                    Margin="0,0,6,0"
                                    Click="BtnMoveLater_Click"/>
                            <Button x:Name="BtnClearSelection"
                                    Grid.Column="3"
                                    MinWidth="94"
                                    Click="BtnClearSelection_Click"/>
                            <TextBlock x:Name="TxtSelectionInfo"
                                       Grid.Column="5"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                        </Grid>

                        <TextBlock x:Name="TxtAgendaHint"
                                   Grid.Row="1"
                                   Margin="12,0,12,8"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

                        <ScrollViewer x:Name="TimelineScrollViewer"
                                      Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False">
                            <Canvas x:Name="TimelineCanvas"
                                    MinWidth="620"
                                    Background="Transparent"
                                    Focusable="True"
                                    MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown"
                                    PreviewMouseMove="TimelineCanvas_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="TimelineCanvas_PreviewMouseLeftButtonUp"
                                    SizeChanged="TimelineCanvas_SizeChanged"
                                    KeyDown="TimelineCanvas_KeyDown"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Padding="12"
                        Background="{DynamicResource DmsBackgroundBrush}"
                        BorderBrush="{DynamicResource DmsBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtEditorTitle"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="5"
                                   Margin="0,0,0,12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>

                        <TextBlock x:Name="LblProject"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,0,8,8"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <ComboBox x:Name="CmbProject"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  DisplayMemberPath="DisplayText"
                                  SelectionChanged="CmbProject_SelectionChanged"/>
                        <TextBlock x:Name="LblTime"
                                   Grid.Row="1"
                                   Grid.Column="3"
                                   Margin="0,0,8,8"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtTime"
                                 Grid.Row="1"
                                 Grid.Column="4"
                                 Margin="0,0,0,8"/>

                        <TextBlock x:Name="LblEntryType"
                                   Grid.Row="2"
                                   Grid.Column="0"
                                   Margin="0,0,8,8"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <ComboBox x:Name="CmbEntryType"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  DisplayMemberPath="DisplayText"/>
                        <TextBlock x:Name="LblMinutes"
                                   Grid.Row="2"
                                   Grid.Column="3"
                                   Margin="0,0,8,8"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtMinutes"
                                 Grid.Row="2"
                                 Grid.Column="4"
                                 Margin="0,0,0,8"/>

                        <TextBlock x:Name="LblDescription"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                   Margin="0,0,8,8"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtDescription"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="4"
                                 Margin="0,0,0,8"/>

                        <TextBlock x:Name="LblNote"
                                   Grid.Row="4"
                                   Grid.Column="0"
                                   Margin="0,0,8,8"
                                   VerticalAlignment="Top"
                                   Foreground="{DynamicResource DmsForegroundBrush}"/>
                        <TextBox x:Name="TxtNote"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="4"
                                 MinHeight="54"
                                 Margin="0,0,0,8"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"/>

                        <WrapPanel Grid.Row="5"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="5">
                            <Button x:Name="BtnNewEntry"
                                    MinWidth="100"
                                    Margin="0,0,8,0"
                                    Click="BtnNewEntry_Click"/>
                            <Button x:Name="BtnSaveEntry"
                                    MinWidth="100"
                                    Margin="0,0,8,0"
                                    Click="BtnSaveEntry_Click"/>
                            <Button x:Name="BtnDeleteEntry"
                                    MinWidth="100"
                                    Click="BtnDeleteEntry_Click"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="TxtStatus"
                   Grid.Row="4"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
    </Grid>
</UserControl>
