<UserControl x:Class="DMS.Desktop.Views.Articles.ArticleCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="300"
             MinWidth="400">

    <Border Background="White"
            Padding="24"
            CornerRadius="8"
            BorderBrush="#D0D7DE"
            BorderThickness="1">

        <StackPanel>
            <TextBlock Text="Karta artiklu"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#0B2A4A"
                       Margin="0,0,0,16"/>

            <TextBlock Text="SAP číslo: 1000018165"
                       FontSize="16"
                       Margin="0,4"/>

            <TextBlock Text="Název: Flakon 50 ml"
                       FontSize="16"
                       Margin="0,4"/>

            <TextBlock Text="Zákazník: Example Cosmetics"
                       FontSize="16"
                       Margin="0,4"/>

            <TextBlock Text="Stav: Připraveno"
                       FontSize="16"
                       Foreground="Green"
                       Margin="0,4"/>
        </StackPanel>
    </Border>
</UserControl>