<UserControl x:Class="DMS.Desktop.Views.QualityOrders.QualityOrderFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="18">
            <TextBlock x:Name="TxtTitle"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,6"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>

            <TextBlock x:Name="TxtSubtitle"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

            <Border x:Name="WarningPanel"
                    Visibility="Collapsed"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12"
                    Background="#443023"
                    BorderBrush="#966946"
                    BorderThickness="1">
                <TextBlock x:Name="TxtWarning"
                           TextWrapping="Wrap"
                           Foreground="#FFE1BE"
                           FontWeight="SemiBold"/>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button x:Name="BtnSave"
                        Click="BtnSave_Click"
                        MinWidth="150"
                        Margin="0,0,8,0"
                        Style="{StaticResource DmsPrimaryButtonStyle}"/>
                <Button x:Name="BtnOpenQO03"
                        Click="BtnOpenQO03_Click"
                        MinWidth="120"
                        Margin="0,0,8,0"
                        Style="{StaticResource DmsFormButtonStyle}"/>
                <Button x:Name="BtnOpenQO06"
                        Click="BtnOpenQO06_Click"
                        MinWidth="120"
                        Margin="0,0,8,0"
                        Style="{StaticResource DmsFormButtonStyle}"/>
                <Button x:Name="BtnOpenQA03"
                        Click="BtnOpenQA03_Click"
                        MinWidth="120"
                        Margin="0,0,8,0"
                        Style="{StaticResource DmsFormButtonStyle}"/>
                <Button x:Name="BtnReload"
                        Click="BtnReload_Click"
                        MinWidth="120"
                        Style="{StaticResource DmsFormButtonStyle}"/>
            </StackPanel>

            <Border CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,12"
                    BorderThickness="1"
                    Background="{DynamicResource DmsBackgroundBrush}"
                    BorderBrush="{DynamicResource DmsBorderBrush}">
                <StackPanel>
                    <TextBlock x:Name="TxtPrintVersionSection"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock x:Name="LblPrintVersionInput"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                            <TextBox x:Name="TxtPrintVersionInput"
                                     Height="32"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock x:Name="TxtPrintVersionHint"
                                       FontSize="12"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                        </StackPanel>

                        <Button x:Name="BtnLoadPrintVersion"
                                Grid.Column="1"
                                Click="BtnLoadPrintVersion_Click"
                                VerticalAlignment="Top"
                                MinWidth="150"
                                Height="32"
                                Margin="0,19,12,0"
                                Style="{StaticResource DmsFormButtonStyle}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                            <TextBlock x:Name="LblPvNumber" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtPvNumber" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,8">
                            <TextBlock x:Name="LblSapId" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtSapId" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                            <TextBlock x:Name="LblCustomer" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtCustomer" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,8">
                            <TextBlock x:Name="LblSampleLocation" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtSampleLocation" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,8">
                            <TextBlock x:Name="LblBoardLocation" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtBoardLocation" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                            <TextBlock x:Name="LblHdNumber" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtHdNumber" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock x:Name="LblGauge" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtGauge" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock x:Name="LblCamera" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtCamera" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock x:Name="LblTasks" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtTasks" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="LblPrintVersionNotes"
                               Margin="0,12,0,4"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    <TextBox x:Name="TxtPrintVersionNotes"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="58"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <TextBlock x:Name="LblArticleData"
                               Margin="0,12,0,4"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    <TextBox x:Name="TxtArticleData"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="58"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <TextBlock x:Name="LblOpenTasks"
                               Margin="0,12,0,4"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                    <TextBox x:Name="TxtOpenTasks"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="58"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource DmsForegroundBrush}"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="8"
                    Padding="14"
                    BorderThickness="1"
                    Background="{DynamicResource DmsBackgroundBrush}"
                    BorderBrush="{DynamicResource DmsBorderBrush}">
                <StackPanel>
                    <TextBlock x:Name="TxtOrderSection"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock x:Name="LblOrderNumber" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtOrderNumber" Height="32" VerticalContentAlignment="Center" LostFocus="TxtOrderNumber_LostFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,10,10">
                            <TextBlock x:Name="LblMachine" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <ListBox x:Name="LstMachines"
                                     MinHeight="78"
                                     MaxHeight="150"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     BorderBrush="{DynamicResource DmsBorderBrush}"
                                     Background="{DynamicResource DmsPanelBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayText}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="TxtMachineHint" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,10">
                            <TextBlock x:Name="LblColorType" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <ListBox x:Name="LstColorTypes"
                                     MinHeight="78"
                                     MaxHeight="150"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     BorderBrush="{DynamicResource DmsBorderBrush}"
                                     Background="{DynamicResource DmsPanelBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayText}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="TxtColorTypeHint" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock x:Name="LblQualityClass" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <ComboBox x:Name="CmbQualityClass" Height="32" IsEditable="True"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,10">
                            <TextBlock x:Name="LblStart" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <DatePicker x:Name="DateStart" Height="32"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,10,10">
                            <TextBlock x:Name="LblEnd" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <DatePicker x:Name="DateEnd" Height="32"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,10">
                            <TextBlock x:Name="LblOrderedQuantity" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtOrderedQuantity" Height="32" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock x:Name="LblProducedQuantity" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtProducedQuantity" Height="32" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,10,10">
                            <TextBlock x:Name="LblLabOrder" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtLabOrder" Height="32" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,10,10">
                            <TextBlock x:Name="LblLorealLabOrder" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtLorealLabOrder" Height="32" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,0,0,10">
                            <TextBlock x:Name="LblReleaseState" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtReleaseState" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,18,10,10" Orientation="Horizontal">
                            <CheckBox x:Name="ChkLoreal" VerticalAlignment="Center" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,10,10">
                            <TextBlock x:Name="LblScheduleStatus" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtScheduleStatus" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,18,0,10" Orientation="Horizontal">
                            <CheckBox x:Name="ChkSortingInHd" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <CheckBox x:Name="ChkStaysInHd" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4">
                            <TextBlock x:Name="LblOrderNotes" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtOrderNotes"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="90"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
