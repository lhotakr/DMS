<UserControl x:Class="DMS.Desktop.Views.QualityOrders.QualityOrderReleaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="18">
            <TextBlock x:Name="TxtTitle"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,6"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>

            <TextBlock x:Name="TxtSubtitle"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>

            <Border x:Name="WarningPanel"
                    Visibility="Collapsed"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12"
                    Background="#443023"
                    BorderBrush="#966946"
                    BorderThickness="1">
                <TextBlock x:Name="TxtWarning"
                           TextWrapping="Wrap"
                           Foreground="#FFE1BE"
                           FontWeight="SemiBold"/>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button x:Name="BtnRelease"
                        Click="BtnRelease_Click"
                        MinWidth="140"
                        Margin="0,0,8,0"
                        Style="{StaticResource DmsPrimaryButtonStyle}"/>
                <Button x:Name="BtnBlock"
                        Click="BtnBlock_Click"
                        MinWidth="140"
                        Margin="0,0,8,0"
                        Style="{StaticResource DmsFormButtonStyle}"/>
                <Button x:Name="BtnOpenQO02"
                        Click="BtnOpenQO02_Click"
                        MinWidth="120"
                        Margin="0,0,8,0"
                        Style="{StaticResource DmsFormButtonStyle}"/>
                <Button x:Name="BtnOpenQO03"
                        Click="BtnOpenQO03_Click"
                        MinWidth="120"
                        Style="{StaticResource DmsFormButtonStyle}"/>
            </StackPanel>

            <Border CornerRadius="8"
                    Padding="14"
                    BorderThickness="1"
                    Background="{DynamicResource DmsBackgroundBrush}"
                    BorderBrush="{DynamicResource DmsBorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock x:Name="LblOrder" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtOrder" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                        <TextBlock x:Name="LblPrintVersion" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtPrintVersion" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,10">
                        <TextBlock x:Name="LblSap" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtSap" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,10">
                        <TextBlock x:Name="LblRelease" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtRelease" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock x:Name="LblSchedule" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtSchedule" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,10">
                        <TextBlock x:Name="LblStart" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtStart" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,10,10">
                        <TextBlock x:Name="LblEnd" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtEnd" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,10">
                        <TextBlock x:Name="LblLoreal" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtLoreal" Foreground="{DynamicResource DmsForegroundBrush}" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4">
                        <TextBlock x:Name="LblNotes" Foreground="{DynamicResource DmsMutedForegroundBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtNotes" Foreground="{DynamicResource DmsForegroundBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border CornerRadius="8"
                    Padding="14"
                    Margin="0,12,0,0"
                    BorderThickness="1"
                    Background="{DynamicResource DmsBackgroundBrush}"
                    BorderBrush="{DynamicResource DmsBorderBrush}">
                <StackPanel>
                    <TextBlock x:Name="TxtReleaseChecklistTitle"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <WrapPanel Margin="0,0,0,10">
                        <CheckBox x:Name="ChkTesaTest" Margin="0,0,18,8"/>
                        <CheckBox x:Name="ChkAcetoneTest" Margin="0,0,18,8"/>
                        <CheckBox x:Name="ChkGridTest" Margin="0,0,18,8"/>
                        <CheckBox x:Name="ChkVisualCheck" Margin="0,0,18,8"/>
                        <CheckBox x:Name="ChkApproved" Margin="0,0,18,8" FontWeight="Bold"/>
                    </WrapPanel>

                    <TextBlock x:Name="LblReleaseNotes"
                               Foreground="{DynamicResource DmsMutedForegroundBrush}"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtReleaseNotes"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="74"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
