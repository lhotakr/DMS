<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DMS.Desktop.Views.Sap.SapWorkCenterImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitle" Text="Work center import"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>

            <TextBlock x:Name="TxtSubtitle" Text="Import SE16N exports of CRHD and CRTX into the local DMS cache."
                       Margin="0,6,0,0"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Padding="14"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource DmsBorderBrush}"
                Background="{DynamicResource DmsBackgroundBrush}"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="LblCrhd" Grid.Row="0" Grid.Column="0"
                           Text="CRHD:"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>

                <TextBox x:Name="TxtCrhdFile"
                         Grid.Row="0" Grid.Column="1"
                         IsReadOnly="True"
                         Margin="0,0,8,8"
                         Background="{DynamicResource DmsPanelBrush}"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         BorderBrush="{DynamicResource DmsBorderBrush}"/>

                <Button x:Name="BtnSelectCrhd" Grid.Row="0" Grid.Column="2"
                        Content="Browse CRHD"
                        Click="BtnSelectCrhd_Click"
                        Margin="0,0,0,8"
                        Padding="12,6"/>

                <TextBlock x:Name="LblCrtx" Grid.Row="1" Grid.Column="0"
                           Text="CRTX:"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>

                <TextBox x:Name="TxtCrtxFile"
                         Grid.Row="1" Grid.Column="1"
                         IsReadOnly="True"
                         Margin="0,0,8,8"
                         Background="{DynamicResource DmsPanelBrush}"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         BorderBrush="{DynamicResource DmsBorderBrush}"/>

                <Button x:Name="BtnSelectCrtx" Grid.Row="1" Grid.Column="2"
                        Content="Browse CRTX"
                        Click="BtnSelectCrtx_Click"
                        Margin="0,0,0,8"
                        Padding="12,6"/>

                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            Margin="0,8,0,0">

                    <Button x:Name="BtnImport" Content="Start import"
                            Click="BtnImport_Click"
                            Width="160"
                            Padding="12,8"
                            Background="{DynamicResource DmsAccentBrush}"
                            Foreground="{DynamicResource DmsOnAccentBrush}"/>

                    <Button x:Name="BtnLoadCache" Content="Load cache"
                            Click="BtnLoadCache_Click"
                            Width="140"
                            Margin="8,0,0,0"
                            Padding="12,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <Expander x:Name="ExpColumnMapping" Grid.Row="2"
          Header="Required export columns for CRHD / CRTX"
          IsExpanded="False"
          Margin="0,0,0,16"
          Foreground="{DynamicResource DmsForegroundBrush}"
          Background="{DynamicResource DmsBackgroundBrush}"
          HorizontalAlignment="Stretch">

            <Border BorderBrush="{DynamicResource DmsBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource DmsBackgroundBrush}"
            Padding="0">

                <DataGrid x:Name="DgvColumnMapping"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{DynamicResource DmsBackgroundBrush}"
                  Foreground="{DynamicResource DmsForegroundBrush}"
                  BorderBrush="{DynamicResource DmsBorderBrush}"
                  HorizontalAlignment="Stretch"
                  MaxHeight="260"
                  MinHeight="160"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  MinRowHeight="30">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <DataGridTemplateColumn x:Name="ColMappingTable" Header="Table" Width="90" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TableName}"
                                       TextWrapping="Wrap"
                                       Padding="6,4"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="ColMappingColumn" Header="Column" Width="110" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ColumnName}"
                                       TextWrapping="Wrap"
                                       Padding="6,4"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="ColMappingRequired" Header="Required" Width="90" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsRequired}"
                                      IsHitTestVisible="False"
                                      Focusable="False"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="ColMappingSapMeaning" Header="SAP meaning" Width="260" MinWidth="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SapMeaning}"
                                       TextWrapping="Wrap"
                                       Padding="6,4"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="ColMappingDmsMeaning" Header="DMS meaning" Width="*" MinWidth="500">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DmsMeaning}"
                                       TextWrapping="Wrap"
                                       Padding="6,4"
                                       Foreground="{DynamicResource DmsForegroundBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Expander>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="TxtResult"
                     Grid.Row="0"
                     MinHeight="100"
                     Margin="0,0,0,12"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     Background="{DynamicResource DmsBackgroundBrush}"
                     Foreground="{DynamicResource DmsForegroundBrush}"
                     BorderBrush="{DynamicResource DmsBorderBrush}"
                     Padding="10"/>

            <DataGrid x:Name="DgvWorkCenters"
          Grid.Row="1"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          HeadersVisibility="Column"
          GridLinesVisibility="Horizontal"
          Background="{DynamicResource DmsBackgroundBrush}"
          Foreground="{DynamicResource DmsForegroundBrush}"
          BorderBrush="{DynamicResource DmsBorderBrush}"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.CanContentScroll="True"
          EnableRowVirtualization="True"
          EnableColumnVirtualization="True"
          VirtualizingPanel.IsVirtualizing="True"
          VirtualizingPanel.VirtualizationMode="Recycling"
          MaxHeight="420"
          MinHeight="160">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>

                    <DataGridTemplateColumn x:Name="ColObjectId" Header="Object ID" Width="130" MinWidth="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ObjectId}"
                               Padding="6,4"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="ColWorkCenter" Header="Work center" Width="150" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WorkCenter}"
                               Padding="6,4"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="ColPlant" Header="Plant" Width="90" MinWidth="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Plant}"
                               Padding="6,4"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="ColWorkCenterText" Header="Work center text" Width="*" MinWidth="420">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}"
                               TextWrapping="Wrap"
                               Padding="6,4"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="ColTextCount" Header="Texts" Width="80" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TextCount}"
                               Padding="6,4"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>