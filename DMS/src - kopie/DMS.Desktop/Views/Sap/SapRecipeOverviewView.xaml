<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DMS.Desktop.Views.Sap.SapRecipeOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DmsPanelBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Nadpis -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TxtTitle"
                       Text="REC03 - Recipe overview"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DmsForegroundBrush}"/>

            <TextBlock x:Name="TxtSubtitle"
                       Text="Overview of recipes, their BOMs, usage in articles and component cross-references."
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DmsMutedForegroundBrush}"/>
        </StackPanel>

        <!-- Filtry -->
        <Border Grid.Row="1"
                Padding="12"
                CornerRadius="8"
                BorderThickness="1"
                Margin="0,0,0,14"
                Background="{DynamicResource DmsBackgroundBrush}"
                BorderBrush="{DynamicResource DmsBorderBrush}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LblRecipeFilter"
                           Grid.Column="0"
                           Text="Recipe / text:"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>

                <TextBox x:Name="TxtRecipeFilter"
                         Grid.Column="1"
                         Margin="0,0,12,0"
                         Background="{DynamicResource DmsPanelBrush}"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         BorderBrush="{DynamicResource DmsBorderBrush}"/>

                <TextBlock x:Name="LblArticleFilter"
                           Grid.Column="2"
                           Text="Used in article:"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DmsForegroundBrush}"/>

                <TextBox x:Name="TxtArticleFilter"
                         Grid.Column="3"
                         Margin="0,0,12,0"
                         Background="{DynamicResource DmsPanelBrush}"
                         Foreground="{DynamicResource DmsForegroundBrush}"
                         BorderBrush="{DynamicResource DmsBorderBrush}"/>

                <Button x:Name="BtnSearch"
                        Grid.Column="4"
                        Content="Search"
                        Width="110"
                        Padding="12,6"
                        Click="BtnSearch_Click"
                        Background="{DynamicResource DmsAccentBrush}"
                        Foreground="{DynamicResource DmsOnAccentBrush}"/>
            </Grid>
        </Border>

        <!-- Hlavní obsah -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Seznam receptur -->
            <Border Grid.Column="0"
                    Padding="10"
                    CornerRadius="8"
                    BorderThickness="1"
                    Background="{DynamicResource DmsBackgroundBrush}"
                    BorderBrush="{DynamicResource DmsBorderBrush}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtResultsTitle"
                               Text="Results"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource DmsForegroundBrush}"/>

                    <DataGrid x:Name="DgvRecipes"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionChanged="DgvRecipes_SelectionChanged"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="{DynamicResource DmsBackgroundBrush}"
                              Foreground="{DynamicResource DmsForegroundBrush}"
                              BorderBrush="{DynamicResource DmsBorderBrush}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Background" Value="{DynamicResource DmsPanelBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource DmsBorderBrush}"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="{DynamicResource DmsBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DmsForegroundBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DmsAccentBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DmsOnAccentBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColRecipeNumber"
                                                Header="Recipe"
                                                Binding="{Binding RecipeNumber}"
                                                Width="110"/>
                            <DataGridTextColumn x:Name="ColDescription"
                                                Header="Description"
                                                Binding="{Binding Description}"
                                                Width="*"/>
                            <DataGridTextColumn x:Name="ColUsage"
                                                Header="Usage"
                                                Binding="{Binding UsedInArticleCount}"
                                                Width="70"/>
                            <DataGridTextColumn x:Name="ColItems"
                                                Header="Items"
                                                Binding="{Binding BomItemCount}"
                                                Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Detail -->
            <Border Grid.Column="2"
                    Padding="10"
                    CornerRadius="8"
                    BorderThickness="1"
                    Background="{DynamicResource DmsBackgroundBrush}"
                    BorderBrush="{DynamicResource DmsBorderBrush}">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>